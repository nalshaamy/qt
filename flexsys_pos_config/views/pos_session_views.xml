<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_form_flexsys_pos_config" model="ir.ui.view">
        <field name="name">pos.session.form.flexsys.pos.config</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_report_pos_session_closing)d"
                        type="action"
                        string="تقرير الإغلاق المحسن"
                        class="btn-secondary"
                        icon="fa-print"/>
            </xpath>
        </field>
    </record>
</odoo>
