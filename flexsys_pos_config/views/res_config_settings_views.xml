<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add FLPOS options to Point of Sale > Configuration > Settings. -->
    <record id="res_config_settings_view_form_flexsys_pos_config" model="ir.ui.view">
        <field name="name">res.config.settings.form.flexsys.pos.config</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="FLPOS" name="flexsys_pos_config_settings">
                    <setting id="flexsys_hide_powered_by_odoo_setting"
                             string="Hide Powered by Odoo"
                             help="Remove the Powered by Odoo line from customer receipts.">
                        <field name="flexsys_hide_powered_by_odoo"/>
                    </setting>
                    <setting id="flexsys_receipt_logo_setting"
                             string="Customer Receipt Logo"
                             help="Upload a dedicated customer receipt logo that does not use the company logo.">
                        <field name="flexsys_receipt_logo"
                               widget="image"
                               class="oe_avatar"
                               options="{'preview_image': 'flexsys_receipt_logo'}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
