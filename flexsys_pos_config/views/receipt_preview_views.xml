<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexsys_receipt_preview_form" model="ir.ui.view">
        <field name="name">flexsys.pos.receipt.preview.form</field>
        <field name="model">flexsys.pos.receipt.preview</field>
        <field name="arch" type="xml">
            <form string="Receipt Preview" create="0" edit="0" delete="0">
                <sheet>
                    <field name="template_id" invisible="1"/>
                    <field name="preview_html" nolabel="1" readonly="1"/>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
