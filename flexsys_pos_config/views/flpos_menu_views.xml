<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        FLPOS is grouped under Point of Sale > Configuration.
        These views edit the existing pos.config fields directly; no new model
        or duplicated settings storage is introduced.
    -->

    <!-- Receipt Settings -->
    <record id="view_pos_config_flpos_receipt_settings_list" model="ir.ui.view">
        <field name="name">pos.config.flpos.receipt.settings.list</field>
        <field name="model">pos.config</field>
        <field name="arch" type="xml">
            <list string="Receipt Settings" create="false" delete="false">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="flexsys_enable_custom_receipt_logo"/>
                <field name="flexsys_hide_company_logo"/>
                <field name="flexsys_hide_powered_by_odoo"/>
            </list>
        </field>
    </record>

    <record id="view_pos_config_flpos_receipt_settings_form" model="ir.ui.view">
        <field name="name">pos.config.flpos.receipt.settings.form</field>
        <field name="model">pos.config</field>
        <field name="arch" type="xml">
            <form string="Receipt Settings" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Point of Sale"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Receipt Identity">
                            <field name="flexsys_enable_custom_receipt_logo"/>
                            <field name="flexsys_receipt_logo"
                                   widget="image"
                                   invisible="not flexsys_enable_custom_receipt_logo"
                                   options="{'preview_image': 'flexsys_receipt_logo', 'size': [180, 90]}"/>
                        </group>
                        <group string="Receipt Display">
                            <field name="flexsys_hide_company_logo"/>
                            <field name="flexsys_hide_powered_by_odoo"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flpos_receipt_settings" model="ir.actions.act_window">
        <field name="name">Receipt Settings</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Point of Sale configurations found</p>
            <p>Configure the receipt identity and display options for each Point of Sale.</p>
        </field>
    </record>

    <record id="action_flpos_receipt_settings_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pos_config_flpos_receipt_settings_list"/>
        <field name="act_window_id" ref="action_flpos_receipt_settings"/>
    </record>

    <record id="action_flpos_receipt_settings_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pos_config_flpos_receipt_settings_form"/>
        <field name="act_window_id" ref="action_flpos_receipt_settings"/>
    </record>

    <!-- Closing Reports -->
    <record id="view_pos_config_flpos_closing_reports_list" model="ir.ui.view">
        <field name="name">pos.config.flpos.closing.reports.list</field>
        <field name="model">pos.config</field>
        <field name="arch" type="xml">
            <list string="Closing Reports" create="false" delete="false">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="flexsys_enable_thermal_closing_report"/>
                <field name="flexsys_enable_a4_closing_report"/>
            </list>
        </field>
    </record>

    <record id="view_pos_config_flpos_closing_reports_form" model="ir.ui.view">
        <field name="name">pos.config.flpos.closing.reports.form</field>
        <field name="model">pos.config</field>
        <field name="arch" type="xml">
            <form string="Closing Reports" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Point of Sale"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group string="Closing Report Formats">
                        <field name="flexsys_enable_thermal_closing_report"/>
                        <field name="flexsys_enable_a4_closing_report"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flpos_closing_reports" model="ir.actions.act_window">
        <field name="name">Closing Reports</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Point of Sale configurations found</p>
            <p>Enable the required closing report formats for each Point of Sale.</p>
        </field>
    </record>

    <record id="action_flpos_closing_reports_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pos_config_flpos_closing_reports_list"/>
        <field name="act_window_id" ref="action_flpos_closing_reports"/>
    </record>

    <record id="action_flpos_closing_reports_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pos_config_flpos_closing_reports_form"/>
        <field name="act_window_id" ref="action_flpos_closing_reports"/>
    </record>

    <!-- Menu structure: Configuration > FLPOS -->
    <menuitem id="menu_flpos_root"
              name="FLPOS"
              parent="point_of_sale.menu_point_config_product"
              sequence="95"
              groups="point_of_sale.group_pos_manager,flexsys_pos_config.group_flexsys_receipt_designer_user"/>

    <menuitem id="menu_flpos_receipt_studio"
              name="Receipt Studio"
              parent="menu_flpos_root"
              action="action_flexsys_receipt_builder"
              sequence="10"
              groups="flexsys_pos_config.group_flexsys_receipt_designer_user"/>

    <menuitem id="menu_flpos_receipt_settings"
              name="Receipt Settings"
              parent="menu_flpos_root"
              action="action_flpos_receipt_settings"
              sequence="20"
              groups="point_of_sale.group_pos_manager"/>

    <menuitem id="menu_flpos_closing_reports"
              name="Closing Reports"
              parent="menu_flpos_root"
              action="action_flpos_closing_reports"
              sequence="30"
              groups="point_of_sale.group_pos_manager"/>
</odoo>
