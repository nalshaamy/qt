<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_pos_session_closing_a4" model="report.paperformat">
        <field name="name">FlexSys POS Closing A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_pos_session_closing" model="ir.actions.report">
        <field name="name">Enhanced Session Closing</field>
        <field name="model">pos.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">flexsys_pos_config.report_pos_session_closing</field>
        <field name="report_file">flexsys_pos_config.report_pos_session_closing</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_pos_session_closing_a4"/>
        <field name="print_report_name">'POS Closing - %s' % (object.name or '')</field>
    </record>
</odoo>
