<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_session_closing">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="session">
                <t t-set="data" t-value="session._flexsys_get_closing_report_data()"/>
                <t t-call="web.basic_layout">
                    <div class="page fs-a4-report" t-att-dir="data['report_direction']" t-att-lang="data['report_language']">
                        <div class="fs-a4-header-accent"></div>
                        <table class="fs-a4-header-table fs-a4-header-premium">
                            <tr>
                                <td class="fs-a4-brand-cell">
                                    <div class="fs-a4-logo-stage">
                                        <img t-if="data['report_logo']" t-att-src="image_data_uri(data['report_logo'])" class="fs-a4-company-logo" alt="Company Logo"/>
                                        <div t-if="not data['report_logo']" class="fs-a4-company-logo-fallback" t-esc="session.company_id.display_name"/>
                                    </div>
                                </td>
                                <td class="fs-a4-title-cell">
                                    <div class="fs-a4-document-type"><span t-out="data['a4_labels']['executive']"/></div>
                                    <h1 t-out="data['a4_labels']['closing_title']"/>
                                    
                                    <div class="fs-a4-title-rule"><span></span></div>
                                    <div class="fs-a4-company-name" t-esc="session.company_id.display_name"/>
                                </td>
                                <td class="fs-a4-report-meta">
                                    <div class="fs-a4-meta-card">
                                        <div class="fs-a4-session-label" t-out="data['a4_labels']['session']"/>
                                        <div class="fs-a4-session-pill" t-esc="session.name"/>
                                        <div class="fs-a4-meta-divider"></div>
                                        <small t-out="data['a4_labels']['issued_at']"/>
                                        <div class="fs-a4-issued-row">
                                            <strong class="fs-a4-issued-date" t-esc="data['report_generated_parts']['date']"/>
                                            <strong class="fs-a4-issued-time" t-esc="data['report_generated_parts']['time']"/>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <table class="fs-a4-session-panel fs-a4-session-panel-two-column">
                            <tr>
                                <td><span t-out="data['a4_labels']['pos']"/><strong t-esc="session.config_id.display_name"/></td>
                                <td><span t-out="data['a4_labels']['user']"/><strong t-esc="session.user_id.display_name"/></td>
                            </tr>
                            <tr>
                                <td><span t-out="data['a4_labels']['opened']"/><strong t-esc="session._flexsys_datetime(session.start_at) or '—'"/></td>
                                <td><span t-out="data['a4_labels']['closed']"/><strong t-esc="session._flexsys_datetime(session.stop_at) or data['a4_labels']['not_closed']"/></td>
                            </tr>
                            <tr>
                                <td><span t-out="data['a4_labels']['cashier_count']"/><strong t-esc="data['cashier_count']"/></td>
                                <td><span t-out="data['a4_labels']['duration']"/><strong t-esc="data['duration'] or '--'"/></td>
                            </tr>
                            <tr>
                                <td><span t-out="data['a4_labels']['currency']"/><strong t-esc="data['currency'].name"/></td>
                                <td><span t-out="data['a4_labels']['status']"/><strong t-att-class="'fs-status fs-status-closed' if session.stop_at else 'fs-status fs-status-open'" t-esc="data['a4_labels']['status_closed'] if session.stop_at else data['a4_labels']['status_open']"/></td>
                            </tr>
                        </table>

                        <table class="fs-a4-kpi-table">
                            <tr>
                                <td class="fs-kpi-primary"><span> <t t-out="data['a4_labels']['gross_sales']"/> </span><strong t-esc="session._flexsys_money(data['sales_before_refunds'], data['currency'])"/></td>
                                <td class="fs-kpi-primary"><span> <t t-out="data['a4_labels']['net_sales']"/> </span><strong t-esc="session._flexsys_money(data['net_sales'], data['currency'])"/></td>
                                <td class="fs-kpi-primary"><span> <t t-out="data['a4_labels']['order_count']"/> </span><strong t-esc="data['order_count']"/></td>
                            </tr>
                            <tr>
                                <td class="fs-kpi-secondary"><span> <t t-out="data['a4_labels']['taxes']"/> </span><strong t-esc="session._flexsys_money(data['tax_total'], data['currency'])"/></td>
                                <td class="fs-kpi-secondary"><span> <t t-out="data['a4_labels']['discounts']"/> </span><strong t-esc="session._flexsys_money(data['discount_total'], data['currency'])"/></td>
                                <td class="fs-kpi-secondary"><span class="fs-refunds-label"> <t t-out="data['a4_labels']['refunds']"/> </span><strong t-esc="session._flexsys_money(data['refund_total'], data['currency'])"/></td>
                            </tr>
                        </table>

                        <div t-if="data['report_language'] == 'ar'" class="fs-a4-section-title fs-ar-section-title" dir="rtl" style="direction: rtl !important; text-align: right !important; border-left: 0 !important; border-right: 5px solid #f28c28 !important;"><span style="display: block; width: 100%; direction: rtl !important; text-align: right !important;" t-out="data['a4_labels']['product_sales']"/></div>
                        <div t-else="" class="fs-a4-section-title"><span t-out="data['a4_labels']['product_sales']"/></div>

                        <!-- Arabic-native RTL layout: semantic column order starts at the
                             right edge (# / name / details) and flows naturally to the left. -->
                        <t t-if="data['report_language'] == 'ar'">
                            <table class="fs-a4-data-table fs-a4-products-table fs-a4-products-table-ar" dir="rtl">
                                <thead><tr>
                                    <th class="fs-col-money" t-out="data['a4_labels']['total']"/><th class="fs-col-money" t-out="data['a4_labels']['tax']"/><th class="fs-col-money" t-out="data['a4_labels']['discount']"/><th class="fs-col-money" t-out="data['a4_labels']['unit_price']"/><th class="fs-col-number" t-out="data['a4_labels']['quantity']"/>
                                    <th t-out="data['a4_labels']['attributes']"/><th t-out="data['a4_labels']['category']"/><th class="fs-col-product" t-out="data['a4_labels']['product_variant']"/><th class="fs-col-no">#</th>
                                </tr></thead>
                                <tbody>
                                    <tr t-foreach="data['variant_rows']" t-as="row">
                                        <td class="fs-col-money fs-cell-strong" t-esc="session._flexsys_money(row['net'], data['currency'])"/>
                                        <td class="fs-col-money" t-esc="session._flexsys_money(row['tax'], data['currency'])"/>
                                        <td class="fs-col-money" t-esc="session._flexsys_money(row['discount'], data['currency'])"/>
                                        <td class="fs-col-money" t-esc="session._flexsys_money(row['unit_price'], data['currency'])"/>
                                        <td class="fs-col-number"><t t-esc="session._flexsys_qty(row['qty'])"/><small t-if="row['refund_qty']"><t t-out="data['a4_labels']['refund']"/>: <t t-esc="session._flexsys_qty(row['refund_qty'])"/></small></td>
                                        <td class="fs-product-attributes" t-esc="row['attributes']"/><td class="fs-product-category" t-esc="row['category']"/>
                                        <td class="fs-product-cell fs-ar-product-align" dir="rtl" style="direction: rtl !important; text-align: right !important;"><strong class="fs-ar-product-name" style="display: block; width: 100%; direction: rtl !important; text-align: right !important;" t-esc="row['product']"/><small class="fs-ar-product-meta" t-if="row['barcode'] and row['barcode'] != '—'"><t t-out="data['a4_labels']['sku_barcode']"/>: <t t-esc="row['barcode']"/></small></td>
                                        <td class="fs-col-no" t-esc="row_index + 1"/>
                                    </tr>
                                    <tr t-if="not data['variant_rows']" class="fs-empty-row"><td colspan="9" t-out="data['a4_labels']['no_product_sales']"/></tr>
                                </tbody>
                                <tfoot t-if="data['variant_rows']"><tr>
                                    <td class="fs-col-money" t-esc="session._flexsys_money(data['net_sales'], data['currency'])"/><td class="fs-col-money" t-esc="session._flexsys_money(data['tax_total'], data['currency'])"/><td class="fs-col-money" t-esc="session._flexsys_money(data['discount_total'], data['currency'])"/>
                                    <td class="fs-col-money">—</td><td class="fs-col-number" t-esc="session._flexsys_qty(data['sold_qty'])"/><td colspan="4" t-out="data['a4_labels']['total']"/>
                                </tr></tfoot>
                            </table>

                            <table class="fs-a4-two-column-layout fs-a4-two-column-layout-ar" dir="rtl"><tr>
                                <td>
                                    <div class="fs-a4-section-title fs-a4-section-title-small fs-ar-section-title" dir="rtl" style="direction: rtl !important; text-align: right !important; border-left: 0 !important; border-right: 5px solid #f28c28 !important;"><span style="display: block; width: 100%; direction: rtl !important; text-align: right !important;" t-out="data['a4_labels']['cash_control']"/></div>
                                    <table class="fs-a4-data-table fs-a4-summary-table fs-a4-summary-table-ar" dir="rtl"><tbody>
                                        <tr><td t-esc="session._flexsys_money(data['opening_cash'], data['currency'])"/><th t-out="data['a4_labels']['opening_cash']"/></tr>
                                        <tr><td t-esc="session._flexsys_money(data['cash_received'], data['currency'])"/><th t-out="data['a4_labels']['cash_received']"/></tr>
                                        <tr><td t-esc="session._flexsys_money(data['expected_cash'], data['currency'])"/><th t-out="data['a4_labels']['expected_cash']"/></tr>
                                        <tr><td t-esc="session._flexsys_money(data['actual_cash'], data['currency'])"/><th t-out="data['a4_labels']['actual_cash']"/></tr>
                                        <tr t-att-class="'fs-cash-difference fs-cash-ok' if abs(data['cash_difference']) &lt; 0.000001 else ('fs-cash-difference fs-cash-positive' if data['cash_difference'] &gt; 0 else 'fs-cash-difference fs-cash-negative')"><td t-esc="session._flexsys_money(data['cash_difference'], data['currency'])"/><th t-out="data['a4_labels']['difference']"/></tr>
                                    </tbody></table>
                                </td>
                                <td>
                                    <div class="fs-a4-section-title fs-a4-section-title-small fs-ar-section-title" dir="rtl" style="direction: rtl !important; text-align: right !important; border-left: 0 !important; border-right: 5px solid #f28c28 !important;"><span style="display: block; width: 100%; direction: rtl !important; text-align: right !important;" t-out="data['a4_labels']['payments']"/></div>
                                    <table class="fs-a4-data-table fs-payment-table fs-payment-table-ar" dir="rtl"><thead><tr><th class="fs-ar-payment-amount" style="direction: rtl !important; text-align: right !important;" t-out="data['a4_labels']['amount']"/><th t-out="data['a4_labels']['percentage']"/><th t-out="data['a4_labels']['transactions']"/><th class="fs-ar-payment-method" style="direction: rtl !important; text-align: right !important;" t-out="data['a4_labels']['method']"/></tr></thead><tbody>
                                        <tr t-foreach="data['payment_rows']" t-as="row">
                                            <td class="fs-col-money fs-ar-payment-amount" style="direction: ltr !important; text-align: right !important; white-space: nowrap !important;" t-esc="session._flexsys_money(row['amount'], data['currency'])"/><td class="fs-col-number"><span t-esc="round(row.get('percentage') or 0.0, 1)"/>%</td><td class="fs-col-number" t-esc="row['count']"/>
                                            <td class="fs-ar-payment-method" dir="rtl" style="direction: rtl !important; text-align: right !important;"><strong style="display: block; width: 100%; direction: rtl !important; text-align: right !important;" t-esc="row['name']"/><div class="fs-payment-track"><span t-att-style="'width: ' + str(min(max(row.get('percentage') or 0.0, 0.0), 100.0)) + '%;'"></span></div></td>
                                        </tr>
                                        <tr t-if="not data['payment_rows']" class="fs-empty-row"><td colspan="4" t-out="data['a4_labels']['no_payments']"/></tr>
                                    </tbody></table>
                                </td>
                            </tr></table>

                            <t t-if="session.config_id.flexsys_show_cashier_performance and data['cashier_rows']">
                                <div class="fs-a4-section-title fs-a4-section-title-small fs-ar-section-title" dir="rtl" style="direction: rtl !important; text-align: right !important; border-left: 0 !important; border-right: 5px solid #f28c28 !important;"><span style="display: block; width: 100%; direction: rtl !important; text-align: right !important;" t-out="data['a4_labels']['cashier_performance']"/></div>
                                <table class="fs-a4-data-table fs-a4-cashier-table-ar" dir="rtl"><thead><tr>
                                    <th t-out="data['a4_labels']['net']"/><th class="fs-refunds-label"><t t-out="data['a4_labels']['refunds']"/></th><th><t t-out="data['a4_labels']['discounts']"/></th><th t-out="data['a4_labels']['average_products']"/><th t-out="data['a4_labels']['average_order']"/><th t-out="data['a4_labels']['sales']"/><th t-out="data['a4_labels']['order_count']"/><th t-out="data['a4_labels']['cashier']"/><th>#</th>
                                </tr></thead><tbody>
                                    <tr t-foreach="data['cashier_rows']" t-as="row" t-att-class="'fs-top-cashier' if row_first else ''">
                                        <td class="fs-col-money fs-cell-strong" t-esc="session._flexsys_money(row['net_sales'], data['currency'])"/><td class="fs-col-money fs-refunds-cell" t-esc="session._flexsys_money(row['refunds'], data['currency'])"/><td class="fs-col-money" t-esc="session._flexsys_money(row['discounts'], data['currency'])"/>
                                        <td class="fs-col-number" t-esc="session._flexsys_qty(row['average_items'])"/><td class="fs-col-money" t-esc="session._flexsys_money(row['average_order'], data['currency'])"/><td class="fs-col-money" t-esc="session._flexsys_money(row['sales'], data['currency'])"/>
                                        <td class="fs-col-number" t-esc="row['order_count']"/><td class="fs-cashier-name" t-esc="row['name']"/><td class="fs-col-no" t-esc="row_index + 1"/>
                                    </tr>
                                </tbody></table>
                            </t>
                        </t>

                        <!-- English-native LTR layout remains unchanged. -->
                        <t t-else="">
                            <table class="fs-a4-data-table fs-a4-products-table" dir="ltr">
                                <thead><tr>
                                    <th class="fs-col-no">#</th><th class="fs-col-product" t-out="data['a4_labels']['product_variant']"/><th t-out="data['a4_labels']['category']"/><th t-out="data['a4_labels']['attributes']"/>
                                    <th class="fs-col-number" t-out="data['a4_labels']['quantity']"/><th class="fs-col-money" t-out="data['a4_labels']['unit_price']"/><th class="fs-col-money" t-out="data['a4_labels']['discount']"/><th class="fs-col-money" t-out="data['a4_labels']['tax']"/><th class="fs-col-money" t-out="data['a4_labels']['total']"/>
                                </tr></thead>
                                <tbody>
                                    <tr t-foreach="data['variant_rows']" t-as="row">
                                        <td class="fs-col-no" t-esc="row_index + 1"/>
                                        <td class="fs-product-cell fs-en-product-align" dir="ltr" style="direction: ltr !important; text-align: left !important;"><strong class="fs-en-product-name" dir="auto" style="display: block; width: 100%; text-align: left !important;" t-esc="row['product']"/><small class="fs-en-product-meta" dir="auto" t-if="row['barcode'] and row['barcode'] != '—'"><t t-out="data['a4_labels']['sku_barcode']"/>: <t t-esc="row['barcode']"/></small></td>
                                        <td class="fs-product-category" t-esc="row['category']"/><td class="fs-product-attributes" t-esc="row['attributes']"/>
                                        <td class="fs-col-number"><t t-esc="session._flexsys_qty(row['qty'])"/><small t-if="row['refund_qty']"><t t-out="data['a4_labels']['refund']"/>: <t t-esc="session._flexsys_qty(row['refund_qty'])"/></small></td>
                                        <td class="fs-col-money" t-esc="session._flexsys_money(row['unit_price'], data['currency'])"/>
                                        <td class="fs-col-money" t-esc="session._flexsys_money(row['discount'], data['currency'])"/>
                                        <td class="fs-col-money" t-esc="session._flexsys_money(row['tax'], data['currency'])"/>
                                        <td class="fs-col-money fs-cell-strong" t-esc="session._flexsys_money(row['net'], data['currency'])"/>
                                    </tr>
                                    <tr t-if="not data['variant_rows']" class="fs-empty-row"><td colspan="9" t-out="data['a4_labels']['no_product_sales']"/></tr>
                                </tbody>
                                <tfoot t-if="data['variant_rows']"><tr>
                                    <td colspan="4" t-out="data['a4_labels']['total']"/><td class="fs-col-number" t-esc="session._flexsys_qty(data['sold_qty'])"/><td class="fs-col-money">—</td>
                                    <td class="fs-col-money" t-esc="session._flexsys_money(data['discount_total'], data['currency'])"/><td class="fs-col-money" t-esc="session._flexsys_money(data['tax_total'], data['currency'])"/><td class="fs-col-money" t-esc="session._flexsys_money(data['net_sales'], data['currency'])"/>
                                </tr></tfoot>
                            </table>

                            <table class="fs-a4-two-column-layout" dir="ltr"><tr>
                                <td>
                                    <div class="fs-a4-section-title fs-a4-section-title-small"><span t-out="data['a4_labels']['payments']"/></div>
                                    <table class="fs-a4-data-table fs-payment-table"><thead><tr><th t-out="data['a4_labels']['method']"/><th t-out="data['a4_labels']['transactions']"/><th t-out="data['a4_labels']['percentage']"/><th t-out="data['a4_labels']['amount']"/></tr></thead><tbody>
                                        <tr t-foreach="data['payment_rows']" t-as="row">
                                            <td><strong t-esc="row['name']"/><div class="fs-payment-track"><span t-att-style="'width: ' + str(min(max(row.get('percentage') or 0.0, 0.0), 100.0)) + '%;'"></span></div></td>
                                            <td class="fs-col-number" t-esc="row['count']"/><td class="fs-col-number"><span t-esc="round(row.get('percentage') or 0.0, 1)"/>%</td><td class="fs-col-money" t-esc="session._flexsys_money(row['amount'], data['currency'])"/>
                                        </tr>
                                        <tr t-if="not data['payment_rows']" class="fs-empty-row"><td colspan="4" t-out="data['a4_labels']['no_payments']"/></tr>
                                    </tbody></table>
                                </td>
                                <td>
                                    <div class="fs-a4-section-title fs-a4-section-title-small"><span t-out="data['a4_labels']['cash_control']"/></div>
                                    <table class="fs-a4-data-table fs-a4-summary-table"><tbody>
                                        <tr><th t-out="data['a4_labels']['opening_cash']"/><td t-esc="session._flexsys_money(data['opening_cash'], data['currency'])"/></tr>
                                        <tr><th t-out="data['a4_labels']['cash_received']"/><td t-esc="session._flexsys_money(data['cash_received'], data['currency'])"/></tr>
                                        <tr><th t-out="data['a4_labels']['expected_cash']"/><td t-esc="session._flexsys_money(data['expected_cash'], data['currency'])"/></tr>
                                        <tr><th t-out="data['a4_labels']['actual_cash']"/><td t-esc="session._flexsys_money(data['actual_cash'], data['currency'])"/></tr>
                                        <tr t-att-class="'fs-cash-difference fs-cash-ok' if abs(data['cash_difference']) &lt; 0.000001 else ('fs-cash-difference fs-cash-positive' if data['cash_difference'] &gt; 0 else 'fs-cash-difference fs-cash-negative')"><th t-out="data['a4_labels']['difference']"/><td t-esc="session._flexsys_money(data['cash_difference'], data['currency'])"/></tr>
                                    </tbody></table>
                                </td>
                            </tr></table>

                            <t t-if="session.config_id.flexsys_show_cashier_performance and data['cashier_rows']">
                                <div class="fs-a4-section-title fs-a4-section-title-small"><span t-out="data['a4_labels']['cashier_performance']"/></div>
                                <table class="fs-a4-data-table fs-a4-cashier-table" dir="ltr"><thead><tr><th>#</th><th t-out="data['a4_labels']['cashier']"/><th t-out="data['a4_labels']['order_count']"/><th t-out="data['a4_labels']['sales']"/><th t-out="data['a4_labels']['average_order']"/><th t-out="data['a4_labels']['average_products']"/><th><t t-out="data['a4_labels']['discounts']"/></th><th class="fs-refunds-label"><t t-out="data['a4_labels']['refunds']"/></th><th t-out="data['a4_labels']['net']"/></tr></thead><tbody>
                                    <tr t-foreach="data['cashier_rows']" t-as="row" t-att-class="'fs-top-cashier' if row_first else ''">
                                        <td class="fs-col-no" t-esc="row_index + 1"/><td class="fs-cashier-name" t-esc="row['name']"/><td class="fs-col-number" t-esc="row['order_count']"/>
                                        <td class="fs-col-money" t-esc="session._flexsys_money(row['sales'], data['currency'])"/><td class="fs-col-money" t-esc="session._flexsys_money(row['average_order'], data['currency'])"/>
                                        <td class="fs-col-number" t-esc="session._flexsys_qty(row['average_items'])"/><td class="fs-col-money" t-esc="session._flexsys_money(row['discounts'], data['currency'])"/>
                                        <td class="fs-col-money fs-refunds-cell" t-esc="session._flexsys_money(row['refunds'], data['currency'])"/><td class="fs-col-money fs-cell-strong" t-esc="session._flexsys_money(row['net_sales'], data['currency'])"/>
                                    </tr>
                                </tbody></table>
                            </t>
                        </t>

                        <div class="fs-a4-signatures"><table><tr>
                            <td><span t-out="data['a4_labels']['cashier_signature']"/><div></div></td><td><span t-out="data['a4_labels']['supervisor_signature']"/><div></div></td><td><span t-out="data['a4_labels']['approval_date']"/><div></div></td>
                        </tr></table></div>
                        <div class="fs-a4-footer fs-a4-footer-time-only">
                            <span><t t-out="data['a4_labels']['generated_at']"/>: <strong><t t-esc="data['report_generated_parts']['date']"/> <t t-esc="data['report_generated_parts']['time']"/></strong></span>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_pos_session_closing_thermal">
        <t t-call="web.html_container">
            <!-- Force UTF-8 for wkhtmltopdf. The meta declarations are kept
                 inside the report document because some deployments do not
                 propagate the response charset to the PDF renderer. -->
            <meta charset="utf-8"/>
            <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
            <t t-foreach="docs" t-as="session">
                <t t-set="data" t-value="session._flexsys_get_closing_report_data()"/>
                <div class="page fs-thermal-report" dir="rtl" lang="ar">
                    <div class="fs-thermal-center">
                        <img t-if="data['report_logo']"
                             t-att-src="image_data_uri(data['report_logo'])"
                             class="fs-thermal-logo" alt="Logo"/>
                        <div t-if="not data['report_logo']" class="fs-thermal-company"
                             t-esc="session.company_id.display_name"/>
                        <div class="fs-thermal-title">تقرير إغلاق جلسة نقطة البيع</div>
                        <div class="fs-thermal-subtitle">POS SESSION CLOSING</div>
                    </div>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <table class="fs-thermal-session-table" dir="rtl">
                        <tbody>
                            <tr><th>الجلسة</th><td class="fs-thermal-info-value fs-thermal-session-name" t-esc="session.name"/></tr>
                            <tr><th>نقطة البيع</th><td class="fs-thermal-info-value fs-thermal-pos-name" t-esc="session.config_id.display_name"/></tr>
                            <tr><th>المستخدم</th><td class="fs-thermal-info-value fs-thermal-user-name" t-esc="session.user_id.display_name"/></tr>
                            <tr><th t-esc="data['labels']['cashier']"/><td class="fs-thermal-info-value fs-thermal-cashier-name" t-esc="data['cashier_summary']"/></tr>
                            <tr><th>الفتح</th><td class="fs-thermal-info-value fs-thermal-datetime" t-esc="session._flexsys_datetime(session.start_at) or '—'"/></tr>
                            <tr><th>الإغلاق</th><td class="fs-thermal-info-value fs-thermal-status" t-esc="session._flexsys_datetime(session.stop_at) or data['labels']['not_closed']"/></tr>
                            <tr><th>المدة</th><td class="fs-thermal-info-value fs-thermal-duration" t-esc="data['duration'] or '--'"/></tr>
                        </tbody>
                    </table>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-heading">ملخص المبيعات</div>
                    <div class="fs-thermal-row"><span> <t t-esc="data['labels']['gross_sales']"/> </span><strong t-esc="session._flexsys_money(data['gross_sales'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span> <t t-esc="data['labels']['order_count']"/> </span><strong t-esc="data['order_count']"/></div>
                    <div class="fs-thermal-row"><span>متوسط الطلب</span><strong t-esc="session._flexsys_money(data['average_order'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الصافي قبل الضريبة</span><strong t-esc="session._flexsys_money(data['net_untaxed'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span> <t t-esc="data['labels']['taxes']"/> </span><strong t-esc="session._flexsys_money(data['tax_total'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span> <t t-esc="data['labels']['discounts']"/> </span><strong t-esc="session._flexsys_money(data['discount_total'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span> <t t-esc="data['labels']['refunds']"/> </span><strong t-esc="session._flexsys_money(data['refund_total'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الكمية المباعة</span><strong t-esc="data['sold_qty']"/></div>
                    <div class="fs-thermal-row"><span>كمية المرتجع</span><strong t-esc="data['refund_qty']"/></div>

                    <t t-if="session.config_id.flexsys_show_cashier_performance">
                        <div class="fs-thermal-separator">--------------------------------</div>
                        <div class="fs-thermal-heading">أداء أمناء الصندوق</div>
                        <table t-if="data['cashier_rows']" class="fs-thermal-cashiers" dir="rtl">
                            <tbody>
                                <t t-foreach="data['cashier_rows']" t-as="cashier">
                                    <tr class="fs-thermal-cashier-name-row">
                                        <th colspan="2" t-esc="cashier['name']"/>
                                    </tr>
                                    <tr class="fs-thermal-cashier-summary-row">
                                        <td class="fs-thermal-cashier-orders"><t t-esc="cashier['order_count']"/> طلب</td>
                                        <td class="fs-thermal-cashier-sales" t-esc="session._flexsys_money(cashier['net_sales'], data['currency'])"/>
                                    </tr>
                                    <tr t-if="cashier['refunds'] or cashier['discounts']" class="fs-thermal-cashier-meta-row">
                                        <td>المرتجعات: <t t-esc="session._flexsys_money(cashier['refunds'], data['currency'])"/></td>
                                        <td>الخصومات: <t t-esc="session._flexsys_money(cashier['discounts'], data['currency'])"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div t-if="not data['cashier_rows']" class="fs-thermal-empty">لا توجد بيانات لأمناء الصندوق</div>
                    </t>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-heading">طرق الدفع</div>
                    <t t-foreach="data['payment_rows']" t-as="row">
                        <div class="fs-thermal-row">
                            <span><t t-esc="row['name']"/> (<t t-esc="row['count']"/>)</span>
                            <strong t-esc="session._flexsys_money(row['amount'], data['currency'])"/>
                        </div>
                    </t>
                    <div t-if="not data['payment_rows']" class="fs-thermal-empty">لا توجد دفعات</div>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-heading">مطابقة النقدية</div>
                    <div class="fs-thermal-row"><span>الرصيد الافتتاحي</span><strong t-esc="session._flexsys_money(data['opening_cash'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>المقبوض النقدي</span><strong t-esc="session._flexsys_money(data['cash_received'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الرصيد المتوقع</span><strong t-esc="session._flexsys_money(data['expected_cash'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الرصيد الفعلي</span><strong t-esc="session._flexsys_money(data['actual_cash'], data['currency'])"/></div>
                    <div class="fs-thermal-row fs-thermal-total"><span>الفرق</span><strong t-esc="session._flexsys_money(data['cash_difference'], data['currency'])"/></div>

                    <t t-if="session.config_id.flexsys_show_top_selling_products">
                        <div class="fs-thermal-separator">--------------------------------</div>
                        <div class="fs-thermal-heading">أفضل 10 منتجات مبيعًا</div>
                        <div t-if="data['top_selling_products']" class="fs-thermal-top-products">
                            <t t-foreach="data['top_selling_products']" t-as="row">
                                <div class="fs-thermal-top-product">
                                    <div class="fs-thermal-top-product-title" dir="ltr">
                                        <strong t-esc="str(row['rank']) + '. ' + row['product']"/>
                                    </div>
                                    <div class="fs-thermal-top-product-summary" dir="ltr">
                                        <strong class="fs-thermal-top-qty" t-esc="'×' + session._flexsys_qty(row['qty'])"/>
                                        <strong class="fs-thermal-top-sales" t-esc="session._flexsys_money(row['amount'], data['currency'])"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <div t-if="not data['top_selling_products']" class="fs-thermal-empty">لا توجد مبيعات منتجات</div>
                    </t>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-heading">المنتجات والمتغيرات</div>
                    <div t-if="data['product_groups']" class="fs-thermal-products-table">
                        <div class="fs-thermal-products-head">
                            <span>المنتج / المتغير</span>
                            <span>الكمية</span>
                            <span>المبلغ</span>
                        </div>
                        <t t-foreach="data['product_groups']" t-as="group">
                            <div class="fs-thermal-product-group">
                                <div class="fs-thermal-product-main">
                                    <div class="fs-thermal-product-title-cell">
                                        <strong class="fs-thermal-product-name">■ <t t-esc="group['template']"/></strong>
                                        <small t-if="group['variant_count']" class="fs-thermal-variant-count">
                                            <t t-esc="group['variant_count']"/> متغير
                                        </small>
                                    </div>
                                    <strong class="fs-thermal-number" t-esc="session._flexsys_qty(group['qty'])"/>
                                    <strong class="fs-thermal-money" t-esc="session._flexsys_money(group['net'], data['currency'])"/>
                                </div>
                                <t t-if="group['show_variants']">
                                    <t t-foreach="group['variants']" t-as="variant">
                                        <div class="fs-thermal-variant-card">
                                            <div class="fs-thermal-variant-summary">
                                                <strong class="fs-thermal-variant-label" t-esc="variant['display_attributes']"/>
                                                <span class="fs-thermal-number">×<t t-esc="session._flexsys_qty(variant['qty'])"/></span>
                                                <span class="fs-thermal-money" t-esc="session._flexsys_money(variant['net'], data['currency'])"/>
                                            </div>
                                            <div class="fs-thermal-variant-meta">
                                                <span class="fs-thermal-share"><t t-esc="'{:.1f}'.format(variant['share_percent'])"/>%</span>
                                                <div t-if="variant['attribute_items']" class="fs-thermal-attribute-list">
                                                    <t t-foreach="variant['attribute_items']" t-as="item">
                                                        <div class="fs-thermal-attribute-row">
                                                            <span class="fs-thermal-attribute-name" t-esc="item['attribute']"/>
                                                            <span class="fs-thermal-attribute-separator">:</span>
                                                            <strong class="fs-thermal-attribute-value" t-esc="item['value']"/>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                        <div t-if="variant['refund_qty']" class="fs-thermal-refund-row">
                                            <span>مرتجع: <t t-esc="variant['display_attributes']"/></span>
                                            <span class="fs-thermal-number">×<t t-esc="session._flexsys_qty(variant['refund_qty'])"/></span>
                                            <span/>
                                        </div>
                                    </t>
                                </t>
                                <div t-if="not group['show_variants'] and group['refund_qty']" class="fs-thermal-refund-row">
                                    <span>مرتجع</span>
                                    <span class="fs-thermal-number">×<t t-esc="session._flexsys_qty(group['refund_qty'])"/></span>
                                    <span/>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div t-if="not data['product_groups']" class="fs-thermal-empty">لا توجد مبيعات منتجات</div>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-signatures">
                        <div>توقيع الكاشير: ______________</div>
                        <div>توقيع المشرف: ______________</div>
                    </div>
                    <div class="fs-thermal-footer">FLPOS</div>
                </div>
            </t>
        </t>
    </template>

</odoo>
