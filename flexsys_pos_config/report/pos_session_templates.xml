<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_session_closing">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="session">
                <t t-set="data" t-value="session._flexsys_get_closing_report_data()"/>
                <t t-call="web.external_layout">
                    <div class="page fs-pos-report" dir="rtl">
                        <div class="fs-title-row">
                            <div>
                                <h1>تقرير إغلاق جلسة نقطة البيع</h1>
                                <div class="fs-muted">POS Session Closing Report</div>
                            </div>
                            <div class="fs-session-badge" t-esc="session.name"/>
                        </div>

                        <div class="fs-info-grid">
                            <div><span>نقطة البيع</span><strong t-esc="session.config_id.display_name"/></div>
                            <div><span>افتتح بواسطة</span><strong t-esc="session.user_id.display_name"/></div>
                            <div><span>وقت الفتح</span><strong t-field="session.start_at"/></div>
                            <div><span>وقت الإغلاق</span><strong t-field="session.stop_at"/></div>
                            <div><span>مدة الجلسة</span><strong t-esc="data['duration'] or '—'"/></div>
                            <div><span>الشركة</span><strong t-esc="session.company_id.display_name"/></div>
                        </div>

                        <div class="fs-kpis">
                            <div><span>إجمالي المبيعات</span><strong t-esc="session._flexsys_money(data['gross_sales'], data['currency'])"/></div>
                            <div><span>عدد الطلبات</span><strong t-esc="data['order_count']"/></div>
                            <div><span>متوسط الطلب</span><strong t-esc="session._flexsys_money(data['average_order'], data['currency'])"/></div>
                            <div><span>الضرائب</span><strong t-esc="session._flexsys_money(data['tax_total'], data['currency'])"/></div>
                            <div><span>الخصومات</span><strong t-esc="session._flexsys_money(data['discount_total'], data['currency'])"/></div>
                            <div><span>المرتجعات</span><strong t-esc="session._flexsys_money(data['refund_total'], data['currency'])"/></div>
                        </div>

                        <h2>طرق الدفع</h2>
                        <table class="table table-sm fs-table">
                            <thead><tr><th>طريقة الدفع</th><th>عدد العمليات</th><th>المبلغ</th></tr></thead>
                            <tbody>
                                <tr t-foreach="data['payment_rows']" t-as="row">
                                    <td t-esc="row['name']"/><td t-esc="row['count']"/>
                                    <td t-esc="session._flexsys_money(row['amount'], data['currency'])"/>
                                </tr>
                                <tr t-if="not data['payment_rows']"><td colspan="3">لا توجد دفعات</td></tr>
                            </tbody>
                        </table>

                        <h2>مطابقة النقدية</h2>
                        <div class="fs-cash-grid">
                            <div><span>الرصيد الافتتاحي</span><strong t-esc="session._flexsys_money(data['opening_cash'], data['currency'])"/></div>
                            <div><span>المقبوض النقدي</span><strong t-esc="session._flexsys_money(data['cash_received'], data['currency'])"/></div>
                            <div><span>الرصيد المتوقع</span><strong t-esc="session._flexsys_money(data['expected_cash'], data['currency'])"/></div>
                            <div><span>الرصيد الفعلي</span><strong t-esc="session._flexsys_money(data['actual_cash'], data['currency'])"/></div>
                            <div><span>الفرق</span><strong t-esc="session._flexsys_money(data['cash_difference'], data['currency'])"/></div>
                        </div>

                        <h2>مبيعات المنتجات والمتغيرات والخصائص</h2>
                        <table class="table table-sm fs-table fs-products">
                            <thead>
                                <tr><th>#</th><th>المنتج / المتغير</th><th>الخصائص</th><th>الفئة</th><th>الكمية</th><th>مرتجع</th><th>الخصم</th><th>الصافي شامل الضريبة</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['variant_rows']" t-as="row">
                                    <td t-esc="row_index + 1"/>
                                    <td><strong t-esc="row['product']"/><br/><small t-esc="row['barcode']"/></td>
                                    <td t-esc="row['attributes']"/><td t-esc="row['category']"/>
                                    <td t-esc="row['qty']"/><td t-esc="row['refund_qty']"/>
                                    <td t-esc="session._flexsys_money(row['discount'], data['currency'])"/>
                                    <td t-esc="session._flexsys_money(row['net'], data['currency'])"/>
                                </tr>
                                <tr t-if="not data['variant_rows']"><td colspan="8">لا توجد مبيعات منتجات</td></tr>
                            </tbody>
                        </table>

                        <div class="fs-signatures">
                            <div>توقيع الكاشير<br/><span/></div>
                            <div>توقيع المشرف<br/><span/></div>
                        </div>
                        <div class="fs-footer">FLPOS</div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
