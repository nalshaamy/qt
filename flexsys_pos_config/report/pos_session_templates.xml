<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_session_closing">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="session">
                <t t-set="data" t-value="session._flexsys_get_closing_report_data()"/>
                <t t-call="web.external_layout">
                    <div class="page fs-pos-report" dir="rtl">
                        <div class="fs-title-row">
                            <div>
                                <h1>تقرير إغلاق جلسة نقطة البيع</h1>
                                <div class="fs-muted">POS Session Closing Report</div>
                            </div>
                            <div class="fs-session-badge" t-esc="session.name"/>
                        </div>

                        <div class="fs-info-grid">
                            <div><span>نقطة البيع</span><strong t-esc="session.config_id.display_name"/></div>
                            <div><span>افتتح بواسطة</span><strong t-esc="session.user_id.display_name"/></div>
                            <div><span>وقت الفتح</span><strong t-field="session.start_at"/></div>
                            <div><span>وقت الإغلاق</span><strong t-field="session.stop_at"/></div>
                            <div><span>مدة الجلسة</span><strong t-esc="data['duration'] or '—'"/></div>
                            <div><span>الشركة</span><strong t-esc="session.company_id.display_name"/></div>
                        </div>

                        <div class="fs-kpis">
                            <div><span>إجمالي المبيعات</span><strong t-esc="session._flexsys_money(data['gross_sales'], data['currency'])"/></div>
                            <div><span>عدد الطلبات</span><strong t-esc="data['order_count']"/></div>
                            <div><span>متوسط الطلب</span><strong t-esc="session._flexsys_money(data['average_order'], data['currency'])"/></div>
                            <div><span>الضرائب</span><strong t-esc="session._flexsys_money(data['tax_total'], data['currency'])"/></div>
                            <div><span>الخصومات</span><strong t-esc="session._flexsys_money(data['discount_total'], data['currency'])"/></div>
                            <div><span>المرتجعات</span><strong t-esc="session._flexsys_money(data['refund_total'], data['currency'])"/></div>
                        </div>

                        <h2>طرق الدفع</h2>
                        <table class="table table-sm fs-table">
                            <thead><tr><th>طريقة الدفع</th><th>عدد العمليات</th><th>المبلغ</th></tr></thead>
                            <tbody>
                                <tr t-foreach="data['payment_rows']" t-as="row">
                                    <td t-esc="row['name']"/><td t-esc="row['count']"/>
                                    <td t-esc="session._flexsys_money(row['amount'], data['currency'])"/>
                                </tr>
                                <tr t-if="not data['payment_rows']"><td colspan="3">لا توجد دفعات</td></tr>
                            </tbody>
                        </table>

                        <h2>مطابقة النقدية</h2>
                        <div class="fs-cash-grid">
                            <div><span>الرصيد الافتتاحي</span><strong t-esc="session._flexsys_money(data['opening_cash'], data['currency'])"/></div>
                            <div><span>المقبوض النقدي</span><strong t-esc="session._flexsys_money(data['cash_received'], data['currency'])"/></div>
                            <div><span>الرصيد المتوقع</span><strong t-esc="session._flexsys_money(data['expected_cash'], data['currency'])"/></div>
                            <div><span>الرصيد الفعلي</span><strong t-esc="session._flexsys_money(data['actual_cash'], data['currency'])"/></div>
                            <div><span>الفرق</span><strong t-esc="session._flexsys_money(data['cash_difference'], data['currency'])"/></div>
                        </div>

                        <h2>مبيعات المنتجات والمتغيرات والخصائص</h2>
                        <table class="table table-sm fs-table fs-products">
                            <thead>
                                <tr><th>#</th><th>المنتج / المتغير</th><th>الخصائص</th><th>الفئة</th><th>الكمية</th><th>مرتجع</th><th>الخصم</th><th>الصافي شامل الضريبة</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['variant_rows']" t-as="row">
                                    <td t-esc="row_index + 1"/>
                                    <td><strong t-esc="row['product']"/><br/><small t-esc="row['barcode']"/></td>
                                    <td t-esc="row['attributes']"/><td t-esc="row['category']"/>
                                    <td t-esc="row['qty']"/><td t-esc="row['refund_qty']"/>
                                    <td t-esc="session._flexsys_money(row['discount'], data['currency'])"/>
                                    <td t-esc="session._flexsys_money(row['net'], data['currency'])"/>
                                </tr>
                                <tr t-if="not data['variant_rows']"><td colspan="8">لا توجد مبيعات منتجات</td></tr>
                            </tbody>
                        </table>

                        <div class="fs-signatures">
                            <div>توقيع الكاشير<br/><span/></div>
                            <div>توقيع المشرف<br/><span/></div>
                        </div>
                        <div class="fs-footer">FLPOS</div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_pos_session_closing_thermal">
        <t t-call="web.html_container">
            <!-- Force UTF-8 for wkhtmltopdf. The meta declarations are kept
                 inside the report document because some deployments do not
                 propagate the response charset to the PDF renderer. -->
            <meta charset="utf-8"/>
            <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
            <t t-foreach="docs" t-as="session">
                <t t-set="data" t-value="session._flexsys_get_closing_report_data()"/>
                <div class="page fs-thermal-report" dir="rtl" lang="ar">
                    <div class="fs-thermal-center">
                        <img t-if="session.config_id.flexsys_enable_custom_receipt_logo and session.config_id.flexsys_receipt_logo"
                             t-att-src="image_data_uri(session.config_id.flexsys_receipt_logo)"
                             class="fs-thermal-logo" alt="Logo"/>
                        <div t-if="not session.config_id.flexsys_receipt_logo" class="fs-thermal-company"
                             t-esc="session.company_id.display_name"/>
                        <div class="fs-thermal-title">تقرير إغلاق جلسة نقطة البيع</div>
                        <div class="fs-thermal-subtitle">POS SESSION CLOSING</div>
                    </div>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-row"><span>الجلسة</span><strong t-esc="session.name"/></div>
                    <div class="fs-thermal-row"><span>نقطة البيع</span><strong t-esc="session.config_id.display_name"/></div>
                    <div class="fs-thermal-row"><span>المستخدم</span><strong t-esc="session.user_id.display_name"/></div>
                    <div class="fs-thermal-row"><span>الفتح</span><strong t-field="session.start_at"/></div>
                    <div class="fs-thermal-row"><span>الإغلاق</span><strong t-esc="session.stop_at or '-'"/></div>
                    <div class="fs-thermal-row"><span>المدة</span><strong t-esc="data['duration'] or '-'"/></div>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-heading">ملخص المبيعات</div>
                    <div class="fs-thermal-row"><span>إجمالي المبيعات</span><strong t-esc="session._flexsys_money(data['gross_sales'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>عدد الطلبات</span><strong t-esc="data['order_count']"/></div>
                    <div class="fs-thermal-row"><span>متوسط الطلب</span><strong t-esc="session._flexsys_money(data['average_order'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الصافي قبل الضريبة</span><strong t-esc="session._flexsys_money(data['net_untaxed'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الضرائب</span><strong t-esc="session._flexsys_money(data['tax_total'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الخصومات</span><strong t-esc="session._flexsys_money(data['discount_total'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>المرتجعات</span><strong t-esc="session._flexsys_money(data['refund_total'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الكمية المباعة</span><strong t-esc="data['sold_qty']"/></div>
                    <div class="fs-thermal-row"><span>كمية المرتجع</span><strong t-esc="data['refund_qty']"/></div>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-heading">طرق الدفع</div>
                    <t t-foreach="data['payment_rows']" t-as="row">
                        <div class="fs-thermal-row">
                            <span><t t-esc="row['name']"/> (<t t-esc="row['count']"/>)</span>
                            <strong t-esc="session._flexsys_money(row['amount'], data['currency'])"/>
                        </div>
                    </t>
                    <div t-if="not data['payment_rows']" class="fs-thermal-empty">لا توجد دفعات</div>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-heading">مطابقة النقدية</div>
                    <div class="fs-thermal-row"><span>الرصيد الافتتاحي</span><strong t-esc="session._flexsys_money(data['opening_cash'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>المقبوض النقدي</span><strong t-esc="session._flexsys_money(data['cash_received'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الرصيد المتوقع</span><strong t-esc="session._flexsys_money(data['expected_cash'], data['currency'])"/></div>
                    <div class="fs-thermal-row"><span>الرصيد الفعلي</span><strong t-esc="session._flexsys_money(data['actual_cash'], data['currency'])"/></div>
                    <div class="fs-thermal-row fs-thermal-total"><span>الفرق</span><strong t-esc="session._flexsys_money(data['cash_difference'], data['currency'])"/></div>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-heading">المنتجات والمتغيرات</div>
                    <div t-if="data['product_groups']" class="fs-thermal-products-table">
                        <div class="fs-thermal-products-head">
                            <span>المنتج / المتغير</span>
                            <span>الكمية</span>
                            <span>المبلغ</span>
                        </div>
                        <t t-foreach="data['product_groups']" t-as="group">
                            <div class="fs-thermal-product-group">
                                <div class="fs-thermal-product-main">
                                    <div class="fs-thermal-product-title-cell">
                                        <strong class="fs-thermal-product-name">■ <t t-esc="group['template']"/></strong>
                                        <small t-if="group['variant_count']" class="fs-thermal-variant-count">
                                            <t t-esc="group['variant_count']"/> متغير
                                        </small>
                                    </div>
                                    <strong class="fs-thermal-number" t-esc="session._flexsys_qty(group['qty'])"/>
                                    <strong class="fs-thermal-money" t-esc="session._flexsys_money(group['net'], data['currency'])"/>
                                </div>
                                <t t-if="group['show_variants']">
                                    <t t-foreach="group['variants']" t-as="variant">
                                        <div class="fs-thermal-variant-card">
                                            <div class="fs-thermal-variant-summary">
                                                <strong class="fs-thermal-variant-label" t-esc="variant['display_attributes']"/>
                                                <span class="fs-thermal-number">×<t t-esc="session._flexsys_qty(variant['qty'])"/></span>
                                                <span class="fs-thermal-money" t-esc="session._flexsys_money(variant['net'], data['currency'])"/>
                                            </div>
                                            <div class="fs-thermal-variant-meta">
                                                <span class="fs-thermal-share"><t t-esc="'{:.1f}'.format(variant['share_percent'])"/>%</span>
                                                <div t-if="variant['attribute_items']" class="fs-thermal-attribute-list">
                                                    <t t-foreach="variant['attribute_items']" t-as="item">
                                                        <div class="fs-thermal-attribute-row">
                                                            <span class="fs-thermal-attribute-name" t-esc="item['attribute']"/>
                                                            <span class="fs-thermal-attribute-separator">:</span>
                                                            <strong class="fs-thermal-attribute-value" t-esc="item['value']"/>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                        <div t-if="variant['refund_qty']" class="fs-thermal-refund-row">
                                            <span>مرتجع: <t t-esc="variant['display_attributes']"/></span>
                                            <span class="fs-thermal-number">×<t t-esc="session._flexsys_qty(variant['refund_qty'])"/></span>
                                            <span/>
                                        </div>
                                    </t>
                                </t>
                                <div t-if="not group['show_variants'] and group['refund_qty']" class="fs-thermal-refund-row">
                                    <span>مرتجع</span>
                                    <span class="fs-thermal-number">×<t t-esc="session._flexsys_qty(group['refund_qty'])"/></span>
                                    <span/>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div t-if="not data['product_groups']" class="fs-thermal-empty">لا توجد مبيعات منتجات</div>

                    <div class="fs-thermal-separator">--------------------------------</div>
                    <div class="fs-thermal-signatures">
                        <div>توقيع الكاشير: ______________</div>
                        <div>توقيع المشرف: ______________</div>
                    </div>
                    <div class="fs-thermal-footer">FLPOS</div>
                </div>
            </t>
        </t>
    </template>

</odoo>
