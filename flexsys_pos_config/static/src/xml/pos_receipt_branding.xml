<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="flexsys_pos_config.OrderReceiptBranding"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//ReceiptHeader" position="before">
            <div t-if="order.config.flexsys_receipt_logo"
                 class="flexsys-pos-receipt-custom-logo text-center">
                <img t-att-src="'data:image/png;base64,' + order.config.flexsys_receipt_logo"
                     alt="Receipt Logo"/>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class, 'footer-powered-by')]" position="attributes">
            <attribute name="t-if">!order.config.flexsys_hide_powered_by_odoo</attribute>
        </xpath>
    </t>
</templates>
