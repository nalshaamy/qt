<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="flexsys_pos_config.ReceiptBuilder">
        <div class="o_flexsys_builder h-100 d-flex flex-column">
            <header class="o_flexsys_builder_toolbar d-flex align-items-center gap-3 px-3 py-2">
                <div class="o_flexsys_builder_brand d-flex align-items-center gap-2">
                    <div class="o_flexsys_builder_logo">FS</div>
                    <div><div class="fw-bold">FLPOS Receipt Studio</div><div class="small text-muted">Build and preview receipts visually</div></div>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <select class="form-select o_flexsys_template_select" t-on-change="onTemplateChange" t-att-disabled="state.loading">
                        <t t-foreach="state.templates" t-as="template" t-key="template.id"><option t-att-value="template.id" t-att-selected="template.id === state.selectedTemplateId"><t t-esc="template.name"/></option></t>
                    </select>
                    <button class="btn btn-outline-secondary" t-on-click="openTemplates"><i class="fa fa-folder-open me-1"/>Templates</button>
                    <button class="btn btn-outline-primary" t-on-click="openPreview" t-att-disabled="!state.selectedTemplateId"><i class="fa fa-eye me-1"/>Preview</button>
                    <button class="btn btn-primary" t-on-click="save" t-att-disabled="state.saving || !state.dirtyBlockIds.length"><i t-att-class="state.saving ? 'fa fa-spinner fa-spin me-1' : 'fa fa-save me-1'"/><t t-esc="state.saving ? 'Saving...' : 'Save'"/></button>
                </div>
            </header>

            <div t-if="state.loading" class="flex-grow-1 d-flex align-items-center justify-content-center"><i class="fa fa-spinner fa-spin fa-2x text-primary"/></div>
            <div t-elif="!state.templates.length" class="flex-grow-1 d-flex align-items-center justify-content-center"><div class="text-center"><i class="fa fa-file-text-o fa-3x text-muted mb-3"/><h3>No receipt templates yet</h3><p class="text-muted">Create a template first, then return to Receipt Studio.</p><button class="btn btn-primary" t-on-click="openTemplates">Create Receipt Template</button></div></div>

            <main t-else="" class="o_flexsys_builder_body flex-grow-1 d-grid">
                <aside class="o_flexsys_builder_blocks border-end">
                    <div class="o_flexsys_panel_header"><strong>Components</strong><div class="small text-muted">Add and arrange receipt sections</div></div>
                    <div class="dropdown px-2 pt-2">
                        <button class="btn btn-primary w-100 dropdown-toggle" data-bs-toggle="dropdown" t-att-disabled="state.adding"><i class="fa fa-plus me-1"/>Add Component</button>
                        <div class="dropdown-menu w-100 p-2 o_flexsys_component_menu">
                            <button t-foreach="blockLibrary" t-as="item" t-key="item.type" class="dropdown-item d-flex align-items-center gap-2" t-on-click="() => this.addBlock(item.type, item.title)"><i t-att-class="'fa ' + item.icon"/><span t-esc="item.title"/></button>
                        </div>
                    </div>
                    <div class="o_flexsys_block_list p-2">
                        <button t-foreach="state.blocks" t-as="block" t-key="block.id" t-att-class="'o_flexsys_block_item w-100 d-flex align-items-center gap-2 ' + (block.id === state.selectedBlockId ? 'active' : '') + (!block.enabled ? ' opacity-50' : '')" t-on-click="() => this.selectBlock(block.id)">
                            <span class="o_flexsys_block_handle"><i class="fa fa-bars"/></span><span class="o_flexsys_block_icon"><i t-att-class="'fa ' + this.getBlockIcon(block.block_type)"/></span>
                            <span class="text-start flex-grow-1"><span class="d-block fw-semibold" t-esc="block.title || block.block_type"/><span class="small text-muted text-capitalize" t-esc="block.block_type.replace('_', ' ')"/></span>
                            <i t-if="block.enabled" class="fa fa-check-circle text-success"/><i t-else="" class="fa fa-circle-o text-muted"/>
                        </button>
                    </div>
                </aside>

                <section class="o_flexsys_builder_canvas d-flex flex-column">
                    <div class="o_flexsys_panel_header d-flex align-items-center"><div><strong>Live Preview</strong><div class="small text-muted">Changes appear instantly</div></div><span class="badge text-bg-light ms-auto">80 mm</span></div>
                    <div class="o_flexsys_canvas_stage flex-grow-1 overflow-auto p-4">
                        <div class="o_flexsys_receipt_paper mx-auto">
                            <div class="text-center text-muted small mb-3" t-esc="posDisplayName"/>
                            <t t-foreach="enabledBlocks" t-as="block" t-key="block.id">
                                <section t-att-class="getBlockClass(block)" t-on-click="() => this.selectBlock(block.id)">
                                    <div t-if="block.show_title" class="o_flexsys_live_title" t-esc="block.title"/>
                                    <t t-if="block.block_type === 'logo'"><div class="o_flexsys_demo_logo mx-auto">FS</div></t>
                                    <t t-elif="block.block_type === 'company' || block.block_type === 'header'"><div class="fw-bold fs-5">FlexSys Demo Company</div><div>VAT: 310000000000003</div><div>CR: 5900000000</div><div>www.flexsys.sa</div></t>
                                    <t t-elif="block.block_type === 'queue'"><div class="o_flexsys_queue"><div class="small">Queue Number</div><div class="display-6 fw-bold">A-042</div></div></t>
                                    <t t-elif="block.block_type === 'order_info'"><div class="o_flexsys_receipt_row"><span>Order</span><strong>#0042</strong></div><div class="o_flexsys_receipt_row"><span>Cashier</span><span>Demo User</span></div><div class="o_flexsys_receipt_row"><span>Date</span><span>22/07/2026 10:30</span></div></t>
                                    <t t-elif="block.block_type === 'customer'"><div class="o_flexsys_receipt_row"><span>Customer</span><span>Guest Customer</span></div><div class="o_flexsys_receipt_row"><span>Mobile</span><span>05X XXX XXXX</span></div></t>
                                    <t t-elif="block.block_type === 'items'"><div class="o_flexsys_receipt_row"><span>1 × Cappuccino</span><span>18.00</span></div><div class="o_flexsys_receipt_row"><span>2 × Cookie</span><span>14.00</span></div></t>
                                    <t t-elif="block.block_type === 'totals'"><div class="o_flexsys_receipt_row"><span>Subtotal</span><span>27.83</span></div><div class="o_flexsys_receipt_row"><span>VAT 15%</span><span>4.17</span></div><div class="o_flexsys_receipt_row fw-bold fs-5"><span>Total</span><span>32.00 SAR</span></div></t>
                                    <t t-elif="block.block_type === 'payments'"><div class="o_flexsys_receipt_row"><span>Card</span><span>32.00 SAR</span></div></t>
                                    <t t-elif="block.block_type === 'qr'"><div class="o_flexsys_demo_qr mx-auto">QR</div></t>
                                    <t t-elif="block.block_type === 'message'"><div t-esc="block.content || 'Thank you for your visit.'"/></t>
                                    <t t-elif="block.block_type === 'divider'"><div class="o_flexsys_divider"/></t>
                                    <t t-elif="block.block_type === 'spacer'"><div class="o_flexsys_spacer"/></t>
                                    <t t-elif="block.block_type === 'footer'"><div t-esc="block.content || 'Every Receipt Is a Marketing Opportunity'"/><div class="small text-muted">Powered by FLPOS</div></t>
                                </section>
                            </t>
                        </div>
                    </div>
                </section>

                <aside class="o_flexsys_builder_properties border-start">
                    <div class="o_flexsys_panel_header"><strong>Properties</strong><div class="small text-muted">Configure the selected component</div></div>
                    <div t-if="selectedBlock" class="p-3">
                        <div class="o_flexsys_property_identity d-flex align-items-center gap-3 mb-4"><span class="o_flexsys_property_icon"><i t-att-class="'fa ' + selectedBlockIcon"/></span><div><strong t-esc="selectedBlock.title"/><div class="small text-muted text-capitalize" t-esc="selectedBlock.block_type.replace('_', ' ')"/></div></div>
                        <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" id="fs_block_enabled" t-att-checked="selectedBlock.enabled" t-on-change="onEnabledChange"/><label class="form-check-label" for="fs_block_enabled">Enable component</label></div>
                        <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" id="fs_show_title" t-att-checked="selectedBlock.show_title" t-on-change="onShowTitleChange"/><label class="form-check-label" for="fs_show_title">Show title</label></div>
                        <div class="mb-3"><label class="form-label">Title</label><input class="form-control" type="text" t-att-value="selectedBlock.title" t-on-input="onTitleInput"/></div>
                        <div class="mb-3"><label class="form-label">Custom content</label><textarea class="form-control" rows="4" t-on-input="onContentInput" t-att-placeholder="selectedBlock.block_type === 'footer' ? 'Footer message...' : 'Optional custom text...'" t-esc="selectedBlock.content || ''"/></div>
                        <div class="row g-2 mb-3"><div class="col-6"><label class="form-label">Alignment</label><select class="form-select" t-on-change="onAlignmentChange"><option value="left" t-att-selected="selectedBlock.alignment === 'left'">Left</option><option value="center" t-att-selected="selectedBlock.alignment === 'center'">Center</option><option value="right" t-att-selected="selectedBlock.alignment === 'right'">Right</option></select></div><div class="col-6"><label class="form-label">Font size</label><select class="form-select" t-on-change="onFontSizeChange"><option value="small" t-att-selected="selectedBlock.font_size === 'small'">Small</option><option value="normal" t-att-selected="selectedBlock.font_size === 'normal'">Normal</option><option value="large" t-att-selected="selectedBlock.font_size === 'large'">Large</option><option value="xlarge" t-att-selected="selectedBlock.font_size === 'xlarge'">Extra Large</option></select></div></div>
                        <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" id="fs_bold" t-att-checked="selectedBlock.bold" t-on-change="onBoldChange"/><label class="form-check-label" for="fs_bold">Bold text</label></div>
                        <div class="d-flex gap-2 mb-3"><button class="btn btn-outline-secondary flex-fill" t-on-click="() => this.moveBlock(-1)"><i class="fa fa-arrow-up me-1"/>Up</button><button class="btn btn-outline-secondary flex-fill" t-on-click="() => this.moveBlock(1)"><i class="fa fa-arrow-down me-1"/>Down</button></div>
                        <div class="d-flex gap-2"><button class="btn btn-outline-primary flex-fill" t-on-click="duplicateBlock"><i class="fa fa-copy me-1"/>Duplicate</button><button class="btn btn-outline-danger flex-fill" t-on-click="deleteBlock"><i class="fa fa-trash me-1"/>Remove</button></div>
                    </div>
                    <div t-else="" class="p-4 text-center text-muted">Select a component to edit its properties.</div>
                </aside>
            </main>
        </div>
    </t>
</templates>
