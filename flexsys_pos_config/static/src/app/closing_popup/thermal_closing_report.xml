<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="flexsys_pos_config.ClosePosPopupThermalReport"
       t-inherit="point_of_sale.ClosePosPopup"
       t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='downloadSalesReport']" position="after">
            <button t-if="flexsysThermalClosingReportEnabled"
                    type="button"
                    class="button icon btn btn-secondary"
                    t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'"
                    t-on-click="flexsysOpenThermalClosingReport"
                    title="Print thermal closing report">
                Print
                <i t-if="!this.ui.isSmall" class="fa fa-print" role="img"/>
            </button>
        </xpath>
    </t>
</templates>
