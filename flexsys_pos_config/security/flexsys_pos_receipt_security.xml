<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        FLPOS permissions are deliberately assigned to an application category.
        Odoo then exposes them directly on Settings > Users > Access Rights,
        so administrators never need to open the technical Groups screen.
    -->
    <record id="module_category_flexsys_pos" model="ir.module.category">
        <field name="name">FLPOS</field>
        <field name="description">FLPOS receipt design and reporting permissions</field>
        <field name="sequence">36</field>
    </record>

    <record id="group_flexsys_receipt_designer_user" model="res.groups">
        <field name="name">Receipt Studio User</field>
        <field name="category_id" ref="module_category_flexsys_pos"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="comment">Can open Receipt Studio and create or edit receipt templates.</field>
    </record>

    <record id="group_flexsys_receipt_designer_manager" model="res.groups">
        <field name="name">Receipt Studio Manager</field>
        <field name="category_id" ref="module_category_flexsys_pos"/>
        <field name="implied_ids" eval="[(4, ref('group_flexsys_receipt_designer_user'))]"/>
        <field name="comment">Can fully manage and delete FLPOS receipt templates and components.</field>
    </record>

    <record id="rule_flexsys_receipt_template_company" model="ir.rule">
        <field name="name">Receipt templates by company</field>
        <field name="model_id" ref="model_flexsys_pos_receipt_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_flexsys_receipt_designer_user'))]"/>
    </record>

    <record id="rule_flexsys_receipt_block_company" model="ir.rule">
        <field name="name">Receipt blocks by company</field>
        <field name="model_id" ref="model_flexsys_pos_receipt_block"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_flexsys_receipt_designer_user'))]"/>
    </record>
</odoo>
