<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_flexsys_receipt_designer_user" model="res.groups">
        <field name="name">Receipt Designer User</field>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_flexsys_receipt_designer_manager" model="res.groups">
        <field name="name">Receipt Designer Manager</field>
        <field name="implied_ids" eval="[
            (4, ref('group_flexsys_receipt_designer_user')),
            (4, ref('point_of_sale.group_pos_manager'))
        ]"/>
    </record>

    <record id="rule_flexsys_receipt_template_company" model="ir.rule">
        <field name="name">Receipt templates by company</field>
        <field name="model_id" ref="model_flexsys_pos_receipt_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_flexsys_receipt_designer_user'))]"/>
    </record>

    <record id="rule_flexsys_receipt_block_company" model="ir.rule">
        <field name="name">Receipt blocks by company</field>
        <field name="model_id" ref="model_flexsys_pos_receipt_block"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_flexsys_receipt_designer_user'))]"/>
    </record>
</odoo>
