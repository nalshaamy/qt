<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_layout" name="FlexSys Trans Layout">
        <html lang="ar" dir="rtl">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title><t t-esc="page_title or 'FlexSys Trans Manager'"/></title>
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
                <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
                <link rel="stylesheet" href="/web/static/lib/bootstrap/css/bootstrap.css"/>
                <link rel="stylesheet" href="/flexsys_odoo_trans/static/src/css/flexsys_identity.css"/>
                <link rel="stylesheet" href="/flexsys_odoo_trans/static/src/css/inventory_portal.css"/>
                <script defer="defer" src="/flexsys_odoo_trans/static/src/js/inventory_portal.js"></script>
            </head>
            <body class="fs-app-shell">
                <t t-if="manager">
                    <aside class="fs-sidebar">
                        <div class="fs-brand" aria-label="FlexSys Operations Platform"><div class="fs-brand-mark">FS</div><div><strong>FlexSys</strong><span>Operations Platform</span></div></div>
                        <nav class="fs-sidebar-nav">
                            <a t-attf-class="fs-nav-link #{'active' if active_menu == 'dashboard' else ''}" href="/fstrans/dashboard"><span class="fs-nav-icon">⌂</span><span>لوحة التحكم</span></a>
                            <a t-if="manager.can_view_stock" t-attf-class="fs-nav-link #{'active' if active_menu == 'stock' else ''}" href="/fstrans/dashboard/stock"><span class="fs-nav-icon">▦</span><span>كميات المخزون</span></a>
                            <a t-if="manager.can_view_moves" t-attf-class="fs-nav-link #{'active' if active_menu == 'movements' else ''}" href="/fstrans/dashboard/movements"><span class="fs-nav-icon">⇄</span><span>حركات المخزون</span></a>
                            <a class="fs-nav-link disabled"><span class="fs-nav-icon">↗</span><span>التحويلات</span><small>قريبًا</small></a>
                            <a class="fs-nav-link disabled"><span class="fs-nav-icon">▤</span><span>التقارير</span><small>قريبًا</small></a>
                        </nav>
                        <div class="fs-sidebar-footer"><div class="fs-identity-caption">FlexSys Unified Experience</div><div class="fs-user-card"><div class="fs-avatar"><t t-esc="(manager.name or 'M')[:1]"/></div><div><strong t-esc="manager.name"/><span t-esc="warehouse_label"/></div></div><a class="fs-logout" href="/fstrans/logout">تسجيل الخروج</a></div>
                    </aside>
                    <main class="fs-main"><header class="fs-topbar"><div><h1 t-esc="page_title"/><p><span t-esc="manager.company_id.name"/> · <span t-esc="warehouse_label"/></p></div><div class="fs-topbar-badge"><span class="fs-brand-dot"></span> FlexSys Trans Manager</div></header><section class="fs-content"><t t-out="0"/></section></main>
                </t>
                <t t-else=""><main class="fs-login-shell"><t t-out="0"/></main></t>
            </body>
        </html>
    </template>

    <template id="login_page" name="FlexSys Trans Login"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="manager" t-value="False"/><t t-set="page_title">تسجيل الدخول</t><div class="fs-login-side"><div class="fs-login-brand"><div class="fs-brand-mark large">FS</div><strong>FlexSys</strong><span>Operations Platform</span></div><h2>إدارة العمليات بسهولة ووضوح</h2><p>تابع المخزون والحركات التشغيلية للمستودعات المرتبطة بك من لوحة مستقلة وآمنة.</p></div><div class="fs-login-panel"><div class="fs-login-card"><div class="fs-mobile-brand">FlexSys <span>Operations Platform</span></div><h1>مرحبًا بعودتك</h1><p>سجّل الدخول إلى FlexSys Trans Manager</p><div t-if="error" class="alert alert-danger" t-esc="error"/><form method="post" action="/fstrans/login"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>البريد الإلكتروني</label><input class="form-control" type="email" name="email" t-att-value="email" required="required" autofocus="autofocus"/><label>كلمة المرور</label><input class="form-control" type="password" name="password" required="required"/><button class="fs-primary-btn" type="submit">تسجيل الدخول</button></form></div></div></t></template>

    <template id="dashboard_page" name="FlexSys Trans Dashboard"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="page_title">لوحة التحكم</t><div class="fs-welcome"><div><h2>مرحبًا، <span t-esc="manager.name"/></h2><p>هذا ملخص حالة المخزون في مستودعاتك.</p></div><span class="fs-live">● بيانات مباشرة</span></div><div class="fs-cards"><div class="fs-card"><span>إجمالي المنتجات</span><strong t-esc="product_count"/></div><div class="fs-card"><span>الكمية المتاحة</span><strong t-esc="'{:,.2f}'.format(available_qty)"/></div><div class="fs-card"><span>الكمية المحجوزة</span><strong t-esc="'{:,.2f}'.format(reserved_qty)"/></div><div class="fs-card"><span>المنتجات غير المتاحة</span><strong t-esc="out_of_stock"/></div><div class="fs-card accent"><span>العمليات المعلقة</span><strong t-esc="pending_pickings"/></div></div><div class="fs-panel"><div class="fs-panel-head"><div><h3>آخر الحركات المخزنية</h3><p>أحدث 10 حركات</p></div><a href="/fstrans/dashboard/movements">عرض الكل</a></div><t t-call="flexsys_odoo_trans.moves_simple_table"/></div></t></template>

    <template id="filter_text_dropdown"><details class="fs-column-filter"><summary><span t-esc="label"/><span class="fs-filter-mark">⌄</span></summary><div class="fs-filter-menu"><label>بحث في العمود</label><input class="form-control" t-att-name="field_name" t-att-value="field_value" placeholder="اكتب للبحث"/><t t-if="choices"><div class="fs-choice-title">قيم مقترحة</div><div class="fs-choice-list"><label t-foreach="choices" t-as="choice" class="fs-choice"><input type="radio" t-att-name="exact_name" t-att-value="choice['value']" t-att-checked="choice['value'] == exact_value"/><span t-esc="choice['label']"/></label></div></t><div class="fs-filter-actions"><button type="submit" class="fs-filter-apply">تطبيق</button><button type="button" class="fs-filter-clear" t-att-data-clear-fields="field_name + ',' + exact_name">مسح</button></div></div></details></template>

    <template id="filter_number_dropdown"><details class="fs-column-filter"><summary><span t-esc="label"/><span class="fs-filter-mark">⌄</span></summary><div class="fs-filter-menu fs-number-menu"><label>من</label><input class="form-control" type="number" step="any" t-att-name="min_name" t-att-value="min_value"/><label>إلى</label><input class="form-control" type="number" step="any" t-att-name="max_name" t-att-value="max_value"/><div class="fs-filter-actions"><button type="submit" class="fs-filter-apply">تطبيق</button><button type="button" class="fs-filter-clear" t-att-data-clear-fields="min_name + ',' + max_name">مسح</button></div></div></details></template>

    <template id="stock_page" name="FlexSys Stock Quantities"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="page_title">كميات المخزون</t><div class="fs-panel"><div class="fs-panel-head"><div><h3>الرصيد الحالي</h3><p>اضغط على عنوان أي عمود لفتح الفلترة الخاصة به</p></div><a href="/fstrans/dashboard/stock">مسح الفلاتر</a></div><form method="get" class="fs-grid-form"><input type="hidden" name="page_size" t-att-value="pager['page_size']"/><div class="fs-table-wrap"><table class="table fs-table fs-stock-table"><thead><tr>
        <th><t t-set="label">المنتج</t><t t-set="field_name">product</t><t t-set="field_value" t-value="stock_filters['product']"/><t t-set="exact_name">product_exact</t><t t-set="exact_value" t-value="stock_filters['product_exact']"/><t t-set="choices" t-value="stock_choices['products']"/><t t-call="flexsys_odoo_trans.filter_text_dropdown"/></th>
        <th><t t-set="label">الكود</t><t t-set="field_name">code</t><t t-set="field_value" t-value="stock_filters['code']"/><t t-set="exact_name">unused_code_exact</t><t t-set="exact_value"> </t><t t-set="choices" t-value="[]"/><t t-call="flexsys_odoo_trans.filter_text_dropdown"/></th>
        <th><t t-set="label">الكمية</t><t t-set="min_name">qty_min</t><t t-set="max_name">qty_max</t><t t-set="min_value" t-value="stock_filters['qty_min']"/><t t-set="max_value" t-value="stock_filters['qty_max']"/><t t-call="flexsys_odoo_trans.filter_number_dropdown"/></th>
        <th><t t-set="label">المحجوز</t><t t-set="min_name">reserved_min</t><t t-set="max_name">reserved_max</t><t t-set="min_value" t-value="stock_filters['reserved_min']"/><t t-set="max_value" t-value="stock_filters['reserved_max']"/><t t-call="flexsys_odoo_trans.filter_number_dropdown"/></th>
        <th><details class="fs-column-filter"><summary><span>الرصيد الحالي</span><span class="fs-filter-mark">⌄</span></summary><div class="fs-filter-menu fs-number-menu"><label>نوع الرصيد</label><select class="form-select" name="balance"><option value="all" t-att-selected="stock_filters['balance'] == 'all'">الكل</option><option value="positive" t-att-selected="stock_filters['balance'] == 'positive'">موجب</option><option value="zero" t-att-selected="stock_filters['balance'] == 'zero'">صفري</option><option value="negative" t-att-selected="stock_filters['balance'] == 'negative'">سالب</option><option value="non_positive" t-att-selected="stock_filters['balance'] == 'non_positive'">صفر وسالب</option></select><label>من</label><input class="form-control" type="number" step="any" name="available_min" t-att-value="stock_filters['available_min']"/><label>إلى</label><input class="form-control" type="number" step="any" name="available_max" t-att-value="stock_filters['available_max']"/><div class="fs-filter-actions"><button class="fs-filter-apply">تطبيق</button><button type="button" class="fs-filter-clear" data-clear-fields="balance,available_min,available_max">مسح</button></div></div></details></th>
        <th><details class="fs-column-filter"><summary><span>الوحدة</span><span class="fs-filter-mark">⌄</span></summary><div class="fs-filter-menu"><div class="fs-choice-list"><label t-foreach="stock_choices['uoms']" t-as="uom" class="fs-choice"><input type="radio" name="uom_exact" t-att-value="uom['value']" t-att-checked="uom['value'] == stock_filters['uom_exact']"/><span t-esc="uom['label']"/></label></div><div class="fs-filter-actions"><button class="fs-filter-apply">تطبيق</button><button type="button" class="fs-filter-clear" data-clear-fields="uom_exact">مسح</button></div></div></details></th>
    </tr></thead><tbody><tr t-foreach="stock_rows" t-as="r"><td t-esc="r['product'].display_name"/><td t-esc="r['product'].default_code or '-'"/><td t-esc="r['quantity']"/><td t-esc="r['reserved']"/><td><span t-attf-class="fs-balance #{'negative' if r['available'] &lt; 0 else ('zero' if r['available'] == 0 else 'positive')}" t-esc="r['available']"/></td><td t-esc="r['uom'].name"/></tr><tr t-if="not stock_rows"><td colspan="6" class="fs-empty">لا توجد نتائج مطابقة للفلاتر.</td></tr></tbody></table></div></form><t t-call="flexsys_odoo_trans.pagination"/></div></t></template>

    <template id="movements_page" name="FlexSys Stock Movements"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="page_title">حركات المخزون</t><div class="fs-panel"><div class="fs-panel-head"><div><h3>سجل الحركات</h3><p>اضغط على عنوان أي عمود لفتح الفلترة الخاصة به</p></div><a href="/fstrans/dashboard/movements">مسح الفلاتر</a></div><form method="get" class="fs-grid-form"><input type="hidden" name="page_size" t-att-value="pager['page_size']"/><div class="fs-table-wrap"><table class="table fs-table"><thead><tr>
        <th><details class="fs-column-filter"><summary><span>التاريخ</span><span class="fs-filter-mark">⌄</span></summary><div class="fs-filter-menu fs-number-menu"><label>من تاريخ</label><input class="form-control" type="date" name="date_from" t-att-value="move_filters['date_from']"/><label>إلى تاريخ</label><input class="form-control" type="date" name="date_to" t-att-value="move_filters['date_to']"/><div class="fs-filter-actions"><button class="fs-filter-apply">تطبيق</button><button type="button" class="fs-filter-clear" data-clear-fields="date_from,date_to">مسح</button></div></div></details></th>
        <th><t t-set="label">المرجع</t><t t-set="field_name">reference</t><t t-set="field_value" t-value="move_filters['reference']"/><t t-set="exact_name">reference_exact</t><t t-set="exact_value" t-value="move_filters['reference_exact']"/><t t-set="choices" t-value="move_choices['references']"/><t t-call="flexsys_odoo_trans.filter_text_dropdown"/></th>
        <th><t t-set="label">المنتج</t><t t-set="field_name">product</t><t t-set="field_value" t-value="move_filters['product']"/><t t-set="exact_name">product_exact</t><t t-set="exact_value" t-value="move_filters['product_exact']"/><t t-set="choices" t-value="move_choices['products']"/><t t-call="flexsys_odoo_trans.filter_text_dropdown"/></th>
        <th><t t-set="label">من</t><t t-set="field_name">source</t><t t-set="field_value" t-value="move_filters['source']"/><t t-set="exact_name">source_exact</t><t t-set="exact_value" t-value="move_filters['source_exact']"/><t t-set="choices" t-value="move_choices['sources']"/><t t-call="flexsys_odoo_trans.filter_text_dropdown"/></th>
        <th><t t-set="label">إلى</t><t t-set="field_name">destination</t><t t-set="field_value" t-value="move_filters['destination']"/><t t-set="exact_name">destination_exact</t><t t-set="exact_value" t-value="move_filters['destination_exact']"/><t t-set="choices" t-value="move_choices['destinations']"/><t t-call="flexsys_odoo_trans.filter_text_dropdown"/></th>
        <th><t t-set="label">الكمية</t><t t-set="min_name">qty_min</t><t t-set="max_name">qty_max</t><t t-set="min_value" t-value="move_filters['qty_min']"/><t t-set="max_value" t-value="move_filters['qty_max']"/><t t-call="flexsys_odoo_trans.filter_number_dropdown"/></th>
        <th><details class="fs-column-filter"><summary><span>الوحدة</span><span class="fs-filter-mark">⌄</span></summary><div class="fs-filter-menu"><div class="fs-choice-list"><label t-foreach="move_choices['uoms']" t-as="uom" class="fs-choice"><input type="radio" name="uom_exact" t-att-value="uom['value']" t-att-checked="uom['value'] == move_filters['uom_exact']"/><span t-esc="uom['label']"/></label></div><div class="fs-filter-actions"><button class="fs-filter-apply">تطبيق</button><button type="button" class="fs-filter-clear" data-clear-fields="uom_exact">مسح</button></div></div></details></th>
        <th><details class="fs-column-filter"><summary><span>الحالة</span><span class="fs-filter-mark">⌄</span></summary><div class="fs-filter-menu"><div class="fs-choice-list"><label class="fs-choice"><input type="radio" name="state" value="draft" t-att-checked="move_filters['state'] == 'draft'"/><span>مسودة</span></label><label class="fs-choice"><input type="radio" name="state" value="waiting" t-att-checked="move_filters['state'] == 'waiting'"/><span>انتظار</span></label><label class="fs-choice"><input type="radio" name="state" value="confirmed" t-att-checked="move_filters['state'] == 'confirmed'"/><span>مؤكد</span></label><label class="fs-choice"><input type="radio" name="state" value="assigned" t-att-checked="move_filters['state'] == 'assigned'"/><span>جاهز</span></label><label class="fs-choice"><input type="radio" name="state" value="done" t-att-checked="move_filters['state'] == 'done'"/><span>تم</span></label><label class="fs-choice"><input type="radio" name="state" value="cancel" t-att-checked="move_filters['state'] == 'cancel'"/><span>ملغي</span></label></div><div class="fs-filter-actions"><button class="fs-filter-apply">تطبيق</button><button type="button" class="fs-filter-clear" data-clear-fields="state">مسح</button></div></div></details></th>
    </tr></thead><tbody><tr t-foreach="move_lines" t-as="m"><td t-esc="m.date"/><td t-esc="m.reference or m.picking_id.name or '-'"/><td t-esc="m.product_id.display_name"/><td t-esc="m.location_id.complete_name"/><td t-esc="m.location_dest_id.complete_name"/><td t-esc="m.quantity"/><td t-esc="m.product_uom_id.name"/><td><span class="fs-state" t-esc="m.state"/></td></tr><tr t-if="not move_lines"><td colspan="8" class="fs-empty">لا توجد نتائج مطابقة للفلاتر.</td></tr></tbody></table></div></form><t t-call="flexsys_odoo_trans.pagination"/></div></t></template>

    <template id="moves_simple_table"><div class="fs-table-wrap"><table class="table fs-table"><thead><tr><th>التاريخ</th><th>المرجع</th><th>المنتج</th><th>من</th><th>إلى</th><th>الكمية</th><th>الوحدة</th><th>الحالة</th></tr></thead><tbody><tr t-foreach="move_lines" t-as="m"><td t-esc="m.date"/><td t-esc="m.reference or m.picking_id.name or '-'"/><td t-esc="m.product_id.display_name"/><td t-esc="m.location_id.complete_name"/><td t-esc="m.location_dest_id.complete_name"/><td t-esc="m.quantity"/><td t-esc="m.product_uom_id.name"/><td><span class="fs-state" t-esc="m.state"/></td></tr></tbody></table></div></template>

    <template id="pagination"><div class="fs-pagination"><div class="fs-page-info">عرض <strong t-esc="pager['start']"/>–<strong t-esc="pager['end']"/> من أصل <strong t-esc="pager['total']"/> سجل</div><form method="get" class="fs-page-size-form"><t t-foreach="request.params.items()" t-as="item"><input t-if="item[0] not in ['page', 'page_size']" type="hidden" t-att-name="item[0]" t-att-value="item[1]"/></t><label>عرض</label><select name="page_size" onchange="this.form.submit()"><option t-foreach="pager['page_sizes']" t-as="size" t-att-value="size" t-att-selected="size == pager['page_size']" t-esc="size"/></select></form><nav class="fs-page-links"><a t-att-class="'disabled' if not pager['prev_url'] else ''" t-att-href="pager['prev_url'] or '#'">السابق</a><a t-if="pager['page'] &gt; 3" t-att-href="pager['first_url']">1</a><span t-if="pager['page'] &gt; 4">…</span><a t-foreach="pager['pages']" t-as="p" t-attf-class="#{'active' if p['number'] == pager['page'] else ''}" t-att-href="p['url']" t-esc="p['number']"/><span t-if="pager['page'] &lt; pager['page_count'] - 3">…</span><a t-if="pager['page'] &lt; pager['page_count'] - 2" t-att-href="pager['last_url']" t-esc="pager['page_count']"/><a t-att-class="'disabled' if not pager['next_url'] else ''" t-att-href="pager['next_url'] or '#'">التالي</a></nav></div></template>

    <template id="access_denied" name="FlexSys Access Denied"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="page_title">غير مصرح</t><div class="fs-panel"><div class="alert alert-danger mb-0">ليس لديك صلاحية لعرض هذه الصفحة.</div></div></t></template>
</odoo>
