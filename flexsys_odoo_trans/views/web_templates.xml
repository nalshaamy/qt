<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_layout" name="FlexSys Trans Layout">
        <html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title><t t-esc="page_title or 'FlexSys Trans Manager'"/></title><link rel="stylesheet" href="/web/static/lib/bootstrap/css/bootstrap.css"/><link rel="stylesheet" href="/flexsys_odoo_trans/static/src/css/inventory_portal.css"/></head>
        <body><t t-if="manager"><aside class="fs-sidebar"><div class="fs-brand"><div class="fs-brand-mark">FS</div><div><strong>FlexSys</strong><span>Operations Platform</span></div></div><nav class="fs-sidebar-nav"><a t-attf-class="fs-nav-link #{'active' if active_menu == 'dashboard' else ''}" href="/fstrans/dashboard"><span class="fs-nav-icon">⌂</span><span>لوحة التحكم</span></a><a t-if="manager.can_view_stock" t-attf-class="fs-nav-link #{'active' if active_menu == 'stock' else ''}" href="/fstrans/dashboard/stock"><span class="fs-nav-icon">▦</span><span>كميات المخزون</span></a><a t-if="manager.can_view_moves" t-attf-class="fs-nav-link #{'active' if active_menu == 'movements' else ''}" href="/fstrans/dashboard/movements"><span class="fs-nav-icon">⇄</span><span>حركات المخزون</span></a><a class="fs-nav-link disabled"><span class="fs-nav-icon">↗</span><span>التحويلات</span><small>قريبًا</small></a><a class="fs-nav-link disabled"><span class="fs-nav-icon">▤</span><span>التقارير</span><small>قريبًا</small></a></nav><div class="fs-sidebar-footer"><div class="fs-user-card"><div class="fs-avatar"><t t-esc="(manager.name or 'M')[:1]"/></div><div><strong t-esc="manager.name"/><span t-esc="warehouse_label"/></div></div><a class="fs-logout" href="/fstrans/logout">تسجيل الخروج</a></div></aside><main class="fs-main"><header class="fs-topbar"><div><h1 t-esc="page_title"/><p><span t-esc="manager.company_id.name"/> · <span t-esc="warehouse_label"/></p></div><div class="fs-topbar-badge">FlexSys Trans Manager</div></header><section class="fs-content"><t t-out="0"/></section></main></t><t t-else=""><main class="fs-login-shell"><t t-out="0"/></main></t></body></html>
    </template>

    <template id="login_page" name="FlexSys Trans Login"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="manager" t-value="False"/><t t-set="page_title">تسجيل الدخول</t><div class="fs-login-side"><div class="fs-login-brand"><div class="fs-brand-mark large">FS</div><strong>FlexSys</strong><span>Operations Platform</span></div><h2>إدارة العمليات بسهولة ووضوح</h2><p>تابع المخزون والحركات التشغيلية للمستودعات المرتبطة بك من لوحة مستقلة وآمنة.</p></div><div class="fs-login-panel"><div class="fs-login-card"><div class="fs-mobile-brand">FlexSys <span>Operations Platform</span></div><h1>مرحبًا بعودتك</h1><p>سجّل الدخول إلى FlexSys Trans Manager</p><div t-if="error" class="alert alert-danger" t-esc="error"/><form method="post" action="/fstrans/login"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>البريد الإلكتروني</label><input class="form-control" type="email" name="email" t-att-value="email" required="required" autofocus="autofocus"/><label>كلمة المرور</label><input class="form-control" type="password" name="password" required="required"/><button class="fs-primary-btn" type="submit">تسجيل الدخول</button></form></div></div></t></template>

    <template id="dashboard_page" name="FlexSys Trans Dashboard"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="page_title">لوحة التحكم</t><div class="fs-welcome"><div><h2>مرحبًا، <span t-esc="manager.name"/></h2><p>هذا ملخص حالة المخزون في مستودعاتك.</p></div><span class="fs-live">● بيانات مباشرة</span></div><div class="fs-cards"><div class="fs-card"><span>إجمالي المنتجات</span><strong t-esc="product_count"/></div><div class="fs-card"><span>الكمية المتاحة</span><strong t-esc="'{:,.2f}'.format(available_qty)"/></div><div class="fs-card"><span>الكمية المحجوزة</span><strong t-esc="'{:,.2f}'.format(reserved_qty)"/></div><div class="fs-card"><span>المنتجات غير المتاحة</span><strong t-esc="out_of_stock"/></div><div class="fs-card accent"><span>العمليات المعلقة</span><strong t-esc="pending_pickings"/></div></div><div class="fs-panel"><div class="fs-panel-head"><div><h3>آخر الحركات المخزنية</h3><p>أحدث 10 حركات</p></div><a href="/fstrans/dashboard/movements">عرض الكل</a></div><t t-call="flexsys_odoo_trans.moves_table"/></div></t></template>

    <template id="stock_page" name="FlexSys Stock Quantities"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="page_title">كميات المخزون</t><div class="fs-panel"><div class="fs-panel-head"><div><h3>الرصيد الحالي</h3><p>إجمالي الكميات في المستودعات المسموح بها</p></div></div><form class="fs-search" method="get"><input class="form-control" name="search" t-att-value="search" placeholder="ابحث باسم المنتج أو الكود أو الباركود"/><select class="form-select" name="balance"><option value="all" t-att-selected="balance_filter == 'all'">كل الأرصدة</option><option value="positive" t-att-selected="balance_filter == 'positive'">الموجب فقط</option><option value="zero" t-att-selected="balance_filter == 'zero'">الصفري فقط</option><option value="negative" t-att-selected="balance_filter == 'negative'">السالب فقط</option><option value="non_positive" t-att-selected="balance_filter == 'non_positive'">الصفر والسالب</option></select><button class="fs-primary-btn compact">تطبيق</button></form><div class="fs-table-wrap"><table class="table fs-table"><thead><tr><th>المنتج</th><th>الكود</th><th>الكمية</th><th>المحجوز</th><th>الرصيد الحالي</th><th>الوحدة</th></tr></thead><tbody><tr t-foreach="stock_rows" t-as="r"><td t-esc="r['product'].display_name"/><td t-esc="r['product'].default_code or '-'"/><td t-esc="r['quantity']"/><td t-esc="r['reserved']"/><td><span t-attf-class="fs-balance #{'negative' if r['available'] &lt; 0 else ('zero' if r['available'] == 0 else 'positive')}" t-esc="r['available']"/></td><td t-esc="r['uom'].name"/></tr></tbody></table></div></div></t></template>

    <template id="movements_page" name="FlexSys Stock Movements"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="page_title">حركات المخزون</t><div class="fs-panel"><div class="fs-panel-head"><div><h3>سجل الحركات</h3><p>الحركات الداخلة والخارجة والداخلية</p></div><a href="/fstrans/dashboard/movements">مسح الفلاتر</a></div><t t-call="flexsys_odoo_trans.moves_table"/></div></t></template>

    <template id="moves_table"><div class="fs-table-wrap"><form method="get"><table class="table fs-table"><thead><tr><th>التاريخ</th><th>المرجع</th><th>المنتج</th><th>من</th><th>إلى</th><th>الكمية</th><th>الوحدة</th><th>الحالة</th></tr><tr t-if="show_move_filters" class="fs-filter-row"><th><input type="date" name="date_from" t-att-value="move_filters['date_from']"/><input type="date" name="date_to" t-att-value="move_filters['date_to']"/></th><th><input name="reference" t-att-value="move_filters['reference']" placeholder="بحث"/></th><th><input name="product" t-att-value="move_filters['product']" placeholder="منتج أو كود"/></th><th><input name="source" t-att-value="move_filters['source']" placeholder="موقع المصدر"/></th><th><input name="destination" t-att-value="move_filters['destination']" placeholder="موقع الوجهة"/></th><th></th><th></th><th><select name="state"><option value="">الكل</option><option value="draft" t-att-selected="move_filters['state'] == 'draft'">مسودة</option><option value="waiting" t-att-selected="move_filters['state'] == 'waiting'">انتظار</option><option value="confirmed" t-att-selected="move_filters['state'] == 'confirmed'">مؤكد</option><option value="assigned" t-att-selected="move_filters['state'] == 'assigned'">جاهز</option><option value="done" t-att-selected="move_filters['state'] == 'done'">تم</option><option value="cancel" t-att-selected="move_filters['state'] == 'cancel'">ملغي</option></select><button class="fs-filter-btn">تطبيق</button></th></tr></thead><tbody><tr t-foreach="move_lines" t-as="m"><td t-esc="m.date"/><td t-esc="m.reference or m.picking_id.name or '-'"/><td t-esc="m.product_id.display_name"/><td t-esc="m.location_id.complete_name"/><td t-esc="m.location_dest_id.complete_name"/><td t-esc="m.quantity"/><td t-esc="m.product_uom_id.name"/><td><span class="fs-state" t-esc="m.state"/></td></tr></tbody></table></form></div></template>
    <template id="access_denied" name="FlexSys Access Denied"><t t-call="flexsys_odoo_trans.portal_layout"><t t-set="page_title">غير مصرح</t><div class="fs-panel"><div class="alert alert-danger mb-0">ليس لديك صلاحية لعرض هذه الصفحة.</div></div></t></template>
</odoo>
