<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="flexsys_pos_config_form_receipt" model="ir.ui.view">
    <field name="name">flexsys.pos.config.form.receipt</field>
    <field name="model">pos.config</field>
    <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group name="flexsys_pos_receipt_settings" string="FlexSys POS Receipt">
          <group string="Receipt Footer / الفوتر">
            <field name="flexsys_show_company_footer"/>
            <field name="flexsys_currency_symbol_mode"/>
            <field name="flexsys_show_thank_you"/>
            <field name="flexsys_thank_you_ar" invisible="not flexsys_show_thank_you" placeholder="شكراً لزيارتكم"/>
            <field name="flexsys_thank_you_en" invisible="not flexsys_show_thank_you" placeholder="Thank you for visiting"/>
          </group>
          <group string="Promotional Header Image / صورة الهيدر">
            <field name="flexsys_show_header_image"/>
            <field name="flexsys_header_image_position" invisible="not flexsys_show_header_image"/>
            <field name="flexsys_header_image" widget="image" class="oe_avatar"
                   options="{'size': [288, 350]}" invisible="not flexsys_show_header_image"/>
          </group>
          <group string="Promotional Footer Image / صورة الفوتر">
            <field name="flexsys_show_footer_image"/>
            <field name="flexsys_footer_image" widget="image" class="oe_avatar"
                   options="{'size': [288, 350]}" invisible="not flexsys_show_footer_image"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
