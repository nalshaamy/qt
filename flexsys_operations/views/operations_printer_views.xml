<odoo>
    <record id="view_operations_qr_printer_config_tree" model="ir.ui.view">
        <field name="name">flexsys.operations.printer.config.tree</field>
        <field name="model">flexsys.operations.printer.config</field>
        <field name="arch" type="xml">
            <list string="Printer Settings">
                <field name="name"/>
                <field name="active"/>
                <field name="auto_print_on_accept"/>
                <field name="printer_ip"/>
                <field name="printer_port"/>
                <field name="copies"/>
            </list>
        </field>
    </record>

    <record id="view_operations_qr_printer_config_form" model="ir.ui.view">
        <field name="name">flexsys.operations.printer.config.form</field>
        <field name="model">flexsys.operations.printer.config</field>
        <field name="arch" type="xml">
            <form string="Cashier Printer Settings">
                <header>
                    <button name="action_test_printer" type="object" string="Test Printer" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="auto_print_on_accept"/>
                            <field name="shop_name"/>
                        </group>
                        <group>
                            <field name="printer_ip" placeholder="192.168.1.50"/>
                            <field name="printer_port"/>
                            <field name="copies"/>
                            <field name="timeout"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        ملاحظة: إذا كان Odoo يعمل على Odoo.sh والطابعة داخل شبكة محلية 192.168.x.x، فلن يستطيع Odoo.sh الوصول للطابعة مباشرة إلا بوجود VPN / IP عام / Odoo IoT أو جهاز وسيط داخل الفرع.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_operations_qr_printer_config" model="ir.actions.act_window">
        <field name="name">Cashier Printer</field>
        <field name="res_model">flexsys.operations.printer.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_name': 'Cashier Printer', 'default_printer_port': 9100}</field>
    </record>
</odoo>
