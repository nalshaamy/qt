<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_qtcafe_pos_configurations" model="ir.actions.act_window">
        <field name="name">FlexSys POS Branches</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="res_config_settings_view_form_qtcafe_qr_order" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.qtcafe.qr.order</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="FlexSys" string="FlexSys" name="flexsys_operations">
                    <block title="الإعدادات العامة"
                           help="الإعدادات الأساسية لتوجيه طلبات FlexSys.">
                        <setting string="نقطة البيع الاحتياطية"
                                 help="تستخدم عندما لا يحدد العميل فرعًا أو نقطة بيع.">
                            <field name="qtcafe_default_pos_config_id"
                                   options="{'no_create': True}"/>
                        </setting>
                    </block>

                    <block title="الفروع والطلبات"
                           help="إدارة نقاط البيع والفروع وطرق الطلب والدفع والتوصيل.">
                        <setting string="إعدادات الفروع ونقاط البيع"
                                 help="فتح نقاط البيع لإدارة بيانات الفرع، أنواع الطلب، طرق الدفع والمسافة.">
                            <button name="%(action_qtcafe_pos_configurations)d"
                                    type="action"
                                    string="فتح إعدادات الفروع"
                                    class="btn-link text-success fw-bold"
                                    icon="fa-arrow-left"/>
                        </setting>
                    </block>

                    <block title="الإدارة والتشغيل"
                           help="إدارة المستخدمين والطاولات والطابعة.">
                        <setting string="المديرون المستقلون"
                                 help="إدارة حسابات مديري الفروع وصلاحياتهم.">
                            <button name="%(action_qtcafe_manager_accounts)d"
                                    type="action"
                                    string="إدارة المديرين"
                                    class="btn-link text-success fw-bold"
                                    icon="fa-arrow-left"/>
                        </setting>

                        <setting string="الطاولات"
                                 help="إدارة الطاولات وربطها بنقاط البيع.">
                            <button name="%(action_qtcafe_tables)d"
                                    type="action"
                                    string="إدارة الطاولات"
                                    class="btn-link text-success fw-bold"
                                    icon="fa-arrow-left"/>
                        </setting>

                        <setting string="طابعة الكاشير"
                                 help="إعداد طابعة الشبكة واختبار الاتصال بها.">
                            <button name="%(action_qtcafe_qr_printer_config)d"
                                    type="action"
                                    string="إعدادات الطابعة"
                                    class="btn-link text-success fw-bold"
                                    icon="fa-arrow-left"/>
                        </setting>
                    </block>

                    <block title="التوجيه"
                           help="إعداد التوجيه الاحتياطي للطلبات.">
                        <setting string="توجيه نقاط البيع"
                                 help="فتح إعدادات Fallback POS والتوجيه.">
                            <button name="%(action_qtcafe_routing_settings)d"
                                    type="action"
                                    string="إعدادات التوجيه"
                                    class="btn-link text-success fw-bold"
                                    icon="fa-arrow-left"/>
                        </setting>
                    </block>

                    <block title="المعاينة والوصول السريع"
                           help="روابط مباشرة لواجهات FlexSys التشغيلية.">
                        <setting string="واجهة العميل">
                            <a href="/self-order/menu"
                               target="_blank"
                               class="oe_link text-success fw-bold">
                                <i class="fa fa-arrow-left me-1"/>
                                معاينة واجهة العميل
                            </a>
                        </setting>

                        <setting string="شاشة الكاشير">
                            <a href="/operations/cashier"
                               target="_blank"
                               class="oe_link text-success fw-bold">
                                <i class="fa fa-arrow-left me-1"/>
                                معاينة شاشة الكاشير
                            </a>
                        </setting>

                        <setting string="شاشة المطبخ">
                            <a href="/operations/kitchen"
                               target="_blank"
                               class="oe_link text-success fw-bold">
                                <i class="fa fa-arrow-left me-1"/>
                                معاينة شاشة المطبخ
                            </a>
                        </setting>

                        <setting string="لوحة إدارة الفروع">
                            <a href="/operations/dashboard"
                               target="_blank"
                               class="oe_link text-success fw-bold">
                                <i class="fa fa-arrow-left me-1"/>
                                فتح لوحة إدارة الفروع
                            </a>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
