<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_qtcafe_branch" model="ir.ui.view">
        <field name="name">pos.config.form.qtcafe.branch</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <group string="FlexSys QR Branch">
                    <group>
                        <field name="qtcafe_branch_enabled"/>
                        <field name="qtcafe_branch_name" required="qtcafe_branch_enabled"/>
                        <field name="qtcafe_branch_address"/>
                        <field name="qtcafe_branch_is_open"/>
                        <field name="qtcafe_branch_closed_message" invisible="qtcafe_branch_is_open"/>
                    </group>
                    <group>
                        <field name="qtcafe_latitude"/>
                        <field name="qtcafe_longitude"/>
                        <field name="qtcafe_max_order_distance_km"/>
                    </group>
                </group>

                <group string="FlexSys Order Types">
                    <group>
                        <field name="qtcafe_enable_dine_in"/>
                        <field name="qtcafe_enable_takeaway"/>
                    </group>
                    <group>
                        <field name="qtcafe_enable_car_order"/>
                        <field name="qtcafe_enable_delivery"/>
                    </group>
                </group>

                <group string="FlexSys Payment Methods">
                    <group>
                        <field name="qtcafe_enable_cash"/>
                        <field name="qtcafe_enable_card"/>
                    </group>
                    <group>
                        <field name="qtcafe_enable_wallet"/>
                    </group>
                </group>

                <group string="FlexSys Preview Pages">
                    <group>
                        <div class="o_form_label">روابط المعاينة والوصول السريع</div>
                        <div class="d-flex flex-column gap-2">
                            <a href="/self-order/menu"
                               target="_blank"
                               class="oe_link text-success fw-bold">
                                <i class="fa fa-arrow-left me-1"/>
                                معاينة واجهة العميل
                            </a>
                            <a href="/operations/cashier"
                               target="_blank"
                               class="oe_link text-success fw-bold">
                                <i class="fa fa-arrow-left me-1"/>
                                معاينة شاشة الكاشير
                            </a>
                        </div>
                    </group>
                    <group>
                        <div class="o_form_label">الشاشات التشغيلية</div>
                        <div class="d-flex flex-column gap-2">
                            <a href="/operations/kitchen"
                               target="_blank"
                               class="oe_link text-success fw-bold">
                                <i class="fa fa-arrow-left me-1"/>
                                معاينة شاشة المطبخ
                            </a>
                            <a href="/operations/dashboard"
                               target="_blank"
                               class="oe_link text-success fw-bold">
                                <i class="fa fa-arrow-left me-1"/>
                                فتح لوحة إدارة الفروع
                            </a>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
