<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="permission_operations_manage_store" model="flexsys.platform.permission">
    <field name="name">Manage Operations Store</field>
    <field name="code">operations.manage_store</field>
    <field name="application_code">operations</field>
  </record>

  <record id="flexsys_platform.role_platform_admin" model="flexsys.platform.role">
    <field name="permission_ids" eval="[(4, ref('flexsys_platform.permission_operations_access')), (4, ref('permission_operations_manage_store'))]"/>
  </record>

  <record id="application_operations" model="flexsys.platform.application">
    <field name="name">Operations</field>
    <field name="code">operations</field>
    <field name="summary">Orders, execution tasks, stations and mission control</field>
    <field name="icon">fa-diagram-project</field>
    <field name="url">/flexsys/workspace/operations</field>
    <field name="version">19.0.2.20.0</field>
    <field name="module_name">flexsys_operations</field>
    <field name="category">operations</field>
    <field name="workspace_enabled">1</field>
    <field name="search_enabled">1</field>
    <field name="search_provider_model">qtcafe.qr.order</field>
    <field name="search_provider_method">_flexsys_search_results</field>
    <field name="sequence">10</field>
    <field name="required_permission_code">operations.access</field>
    <field name="workspace_title">Operations</field>
    <field name="workspace_subtitle">Orders, execution tasks, stations and live operational status</field>
    <field name="workspace_provider_model">qtcafe.qr.order</field>
  </record>

  <record id="workspace_operations_active_orders" model="flexsys.platform.workspace.item"><field name="application_id" ref="application_operations"/><field name="item_type">metric</field><field name="code">active_orders</field><field name="title">Active Orders</field><field name="icon">fa-bolt</field><field name="metric_key">active_orders</field><field name="sequence">10</field></record>
  <record id="workspace_operations_ready_orders" model="flexsys.platform.workspace.item"><field name="application_id" ref="application_operations"/><field name="item_type">metric</field><field name="code">ready_orders</field><field name="title">Ready</field><field name="icon">fa-check-circle</field><field name="metric_key">ready_orders</field><field name="sequence">20</field></record>
  <record id="workspace_operations_scheduled_orders" model="flexsys.platform.workspace.item"><field name="application_id" ref="application_operations"/><field name="item_type">metric</field><field name="code">scheduled_orders</field><field name="title">Scheduled</field><field name="icon">fa-clock-o</field><field name="metric_key">scheduled_orders</field><field name="sequence">30</field></record>
  <record id="workspace_operations_open_tasks" model="flexsys.platform.workspace.item"><field name="application_id" ref="application_operations"/><field name="item_type">metric</field><field name="code">open_tasks</field><field name="title">Open Tasks</field><field name="icon">fa-list-check</field><field name="metric_key">open_tasks</field><field name="sequence">40</field></record>
  <record id="workspace_operations_orders_action" model="flexsys.platform.workspace.item"><field name="application_id" ref="application_operations"/><field name="item_type">action</field><field name="code">orders</field><field name="title">Orders</field><field name="description">Open and manage all orders</field><field name="icon">fa-receipt</field><field name="action_url">/operations/orders</field><field name="permission_code">operations.access</field><field name="sequence">10</field></record>
  <record id="workspace_operations_kitchen_action" model="flexsys.platform.workspace.item"><field name="application_id" ref="application_operations"/><field name="item_type">action</field><field name="code">kitchen</field><field name="title">Kitchen</field><field name="description">Open the kitchen workspace</field><field name="icon">fa-fire</field><field name="action_url">/operations/kitchen</field><field name="permission_code">operations.access</field><field name="sequence">20</field></record>
  <record id="workspace_operations_self_order_action" model="flexsys.platform.workspace.item"><field name="application_id" ref="application_operations"/><field name="item_type">action</field><field name="code">self_order</field><field name="title">Self Order</field><field name="description">Preview the customer ordering experience</field><field name="icon">fa-mobile-screen</field><field name="action_url">/self-order</field><field name="sequence">30</field></record>
  <record id="workspace_operations_stations_widget" model="flexsys.platform.workspace.item"><field name="application_id" ref="application_operations"/><field name="item_type">widget</field><field name="code">stations</field><field name="title">Active Stations</field><field name="description">Stations available in the current context</field><field name="icon">fa-layer-group</field><field name="metric_key">stations</field><field name="size">medium</field><field name="sequence">10</field></record>

</odoo>
