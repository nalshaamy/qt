<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="flexsys_pos_hide_powered_by.HidePoweredBy"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' footer-powered-by ')]"
               position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>
</templates>
