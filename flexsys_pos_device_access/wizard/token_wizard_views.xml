<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexsys_pos_device_token_wizard_form" model="ir.ui.view">
        <field name="name">flexsys.pos.device.token.wizard.form</field>
        <field name="model">flexsys.pos.device.token.wizard</field>
        <field name="arch" type="xml">
            <form string="Secure Device Link" create="0" edit="0" delete="0">
                <group>
                    <field name="device_id"/>
                    <field name="token_url" widget="CopyClipboardChar"/>
                    <field name="token_value" widget="CopyClipboardChar"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    <strong>Copy this link now.</strong>
                    The raw token is not stored on the device record and cannot be displayed again. Rotating the token immediately invalidates the previous link.
                </div>
                <footer>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
