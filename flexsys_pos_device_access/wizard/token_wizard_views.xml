<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexsys_pos_device_token_wizard_form" model="ir.ui.view">
        <field name="name">flexsys.pos.device.token.wizard.form</field>
        <field name="model">flexsys.pos.device.token.wizard</field>
        <field name="arch" type="xml">
            <form string="One-Time Device Pairing Link" create="0" edit="0" delete="0">
                <group>
                    <field name="device_id"/>
                    <field name="token_url" string="One-Time Pairing URL" widget="CopyClipboardChar"/>
                    <field name="expires_at"/>
                    <field name="token_value" invisible="1"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    <p><strong>This link is for first-device pairing only.</strong></p>
                    <p>The first browser that opens it successfully becomes the paired POS device. The link is consumed immediately and cannot be reused on another browser or device.</p>
                    <p>Open it in the normal browser profile used by the cashier terminal. Do not pair from Incognito/Private Browsing.</p>
                </div>
                <footer>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
