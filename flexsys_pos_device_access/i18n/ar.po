msgstr "فشل اختبار دخول الجهاز:"

msgid "Device access is revoked."
msgstr "تم إلغاء وصول الجهاز."

msgid "Device is disabled."
msgstr "الجهاز معطل."

msgid "Device is not paired yet; a one-time Pairing Link is ready."
msgstr "الجهاز غير مربوط بعد؛ رابط الربط لمرة واحدة جاهز."

msgid "Device is not paired. Generate a one-time Pairing Link."
msgstr "الجهاز غير مربوط. أنشئ رابط ربط لمرة واحدة."

msgid "Device location, branch, owner, maintenance notes..."
msgstr "موقع الجهاز، الفرع، المسؤول، ملاحظات الصيانة..."

msgid "Employee"
msgstr "الموظف"

msgid "Employee Login is not enabled on the Point of Sale."
msgstr "تسجيل دخول الموظفين غير مفعّل في نقطة البيع."

msgid "Employee Login must be enabled on the Point of Sale so cashier PIN verification remains mandatory."
msgstr "يجب تفعيل تسجيل دخول الموظفين في نقطة البيع حتى يبقى التحقق برمز PIN للكاشير إلزاميًا."

msgid "Enable the device before generating a Pairing Link."
msgstr "فعّل الجهاز قبل إنشاء رابط الربط."

msgid "Event"
msgstr "الحدث"

msgid "FlexSys POS Service — %s"
msgstr "خدمة FlexSys لنقطة البيع — %s"

msgid "FlexSys managed POS Service User is assigned and ready."
msgstr "تم تعيين مستخدم خدمة نقطة البيع المُدار بواسطة FlexSys وهو جاهز."

msgid "IP"
msgstr "عنوان IP"

msgid "Invalid Allowed IP / CIDR entry: %s"
msgstr "قيمة IP / CIDR المسموح غير صالحة: %s"

msgid "New"
msgstr "جديد"

msgid "Notes"
msgstr "ملاحظات"

msgid "Optional: 203.0.113.10, 10.0.0.0/24"
msgstr "اختياري: 203.0.113.10, 10.0.0.0/24"

msgid "POS Device Access"
msgstr "دخول أجهزة نقطة البيع"

msgid "POS Service User is missing, invalid, or has insufficient POS access."
msgstr "مستخدم خدمة نقطة البيع مفقود أو غير صالح أو لا يملك صلاحية كافية لنقطة البيع."

msgid "Point of Sale belongs to a different company."
msgstr "نقطة البيع تتبع شركة مختلفة."

msgid "Point of Sale is missing or inactive."
msgstr "نقطة البيع مفقودة أو غير نشطة."

msgid "Reset this device pairing? The current browser credential and any open device session will become invalid immediately."
msgstr "إعادة تعيين ربط هذا الجهاز؟ سيصبح اعتماد المتصفح الحالي وأي جلسة جهاز مفتوحة غير صالحين فورًا."

msgid "Revoke this device? The paired browser and any open device session will be blocked immediately."
msgstr "إلغاء هذا الجهاز؟ سيتم منع المتصفح المربوط وأي جلسة جهاز مفتوحة فورًا."

msgid "Rotate this one-time Pairing Link? The previous unused pairing link will stop working immediately."
msgstr "تدوير رابط الربط لمرة واحدة؟ سيتوقف رابط الربط السابق غير المستخدم عن العمل فورًا."

msgid "Set a custom Credential Expires At date before generating the Pairing Link."
msgstr "حدد تاريخ انتهاء مخصص لاعتماد الجهاز قبل إنشاء رابط الربط."

msgid "Success"
msgstr "نجاح"

msgid "The POS Service User is not valid. Run Test Device Access or assign the managed service user."
msgstr "مستخدم خدمة نقطة البيع غير صالح. شغّل اختبار دخول الجهاز أو عيّن المستخدم المُدار."

msgid "The POS Service User must have Point of Sale access (User or Administrator)."
msgstr "يجب أن يملك مستخدم خدمة نقطة البيع صلاحية نقطة البيع (مستخدم أو مسؤول)."

msgid "The POS Service User must have access to the device company."
msgstr "يجب أن يملك مستخدم خدمة نقطة البيع صلاحية الوصول إلى شركة الجهاز."

msgid "The Point of Sale must be active with Employee Login enabled."
msgstr "يجب أن تكون نقطة البيع نشطة مع تفعيل تسجيل دخول الموظفين."

msgid "The Point of Sale must belong to the device company."
msgstr "يجب أن تتبع نقطة البيع شركة الجهاز."

msgid "The custom Credential Expires At date must be in the future."
msgstr "يجب أن يكون تاريخ انتهاء اعتماد الجهاز المخصص في المستقبل."

msgid "The managed FlexSys POS Service User unexpectedly has system administration rights."
msgstr "مستخدم خدمة نقطة البيع المُدار بواسطة FlexSys لديه صلاحيات إدارة النظام بشكل غير متوقع."

msgid "The paired device credential is expired."
msgstr "انتهت صلاحية اعتماد الجهاز المربوط."

msgid "This device is already paired. Reset Pairing before binding another browser/device."
msgstr "هذا الجهاز مربوط بالفعل. أعد تعيين الربط قبل ربط متصفح أو جهاز آخر."

msgid "This device is revoked. Reset Pairing before generating a new link."
msgstr "تم إلغاء هذا الجهاز. أعد تعيين الربط قبل إنشاء رابط جديد."

msgid "e.g. QT001 Cashier-01"
msgstr "مثال: QT001 Cashier-01"

