msgstr "مستخدم خدمة نقطة البيع مطلوب."

msgid "A system administrator cannot be used as the POS Service User."
msgstr "لا يمكن استخدام مسؤول النظام كمستخدم خدمة نقطة البيع."

msgid "A valid company is required to create the POS Service User."
msgstr "يجب تحديد شركة صالحة لإنشاء مستخدم خدمة نقطة البيع."

msgid "Close"
msgstr "إغلاق"

msgid "Company"
msgstr "الشركة"

