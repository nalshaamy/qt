<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_digital_menu" model="ir.ui.view">
        <field name="name">product.template.form.digital.menu</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Digital Menu" name="flexsys_digital_menu" groups="flexsys_digital_menu.group_digital_menu_user">
                    <group string="Digital Menu Status">
                        <group>
                            <field name="digital_menu_enabled"/>
                            <field name="digital_menu_count" readonly="1" string="Menus"/>
                            <field name="digital_menu_branch_count" readonly="1" string="Branches"/>
                            <field name="digital_menu_is_featured" readonly="1" string="Featured"/>
                            <field name="digital_menu_availability"/>
                        </group>
                        <group>
                            <button name="action_preview_digital_menu" type="object" string="Preview Product" class="btn-primary" invisible="digital_menu_count == 0"/>
                            <field name="digital_menu_default_badge"/>
                            <field name="digital_menu_custom_badge" invisible="digital_menu_default_badge != 'custom'"/>
                            <field name="digital_menu_featured_default"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Display">
                            <group>
                                <group>
                                    <field name="digital_menu_short_description" placeholder="Short public description"/>
                                    <field name="digital_menu_image" widget="image"/>
                                    <field name="digital_menu_notes" placeholder="Internal notes; never exposed publicly"/>
                                </group>
                                <group string="Presentation">
                                    <field name="digital_menu_calories"/>
                                    <field name="digital_menu_spicy_level"/>
                                    <field name="digital_menu_vegetarian"/>
                                    <field name="digital_menu_vegan"/>
                                    <field name="digital_menu_gluten_info"/>
                                </group>
                            </group>
                            <group>
                                <field name="digital_menu_ingredients"/>
                                <field name="digital_menu_allergens"/>
                            </group>
                        </page>

                        <page string="Menu Assignment">
                            <field name="digital_menu_line_ids" context="{'default_product_tmpl_id': id}">
                                <list editable="bottom" decoration-muted="effective_visibility == 'Hidden'">
                                    <field name="menu_id"/>
                                    <field name="category_id"/>
                                    <field name="pos_config_id" optional="show"/>
                                    <field name="sequence"/>
                                    <field name="featured_sequence" optional="hide"/>
                                    <field name="visibility"/>
                                    <field name="featured_mode" optional="show"/>
                                    <field name="badge_mode" optional="hide"/>
                                    <field name="availability_override"/>
                                    <field name="price_mode"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="override_price" widget="monetary" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Effective Result">
                            <p class="text-muted">Final output after Product Default → Menu Override → Branch Override.</p>
                            <field name="digital_menu_line_ids" readonly="1">
                                <list decoration-success="effective_visibility == 'Visible'" decoration-muted="effective_visibility == 'Hidden'">
                                    <field name="menu_id"/>
                                    <field name="pos_config_id"/>
                                    <field name="category_id"/>
                                    <field name="effective_visibility"/>
                                    <field name="effective_availability"/>
                                    <field name="effective_featured"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="effective_price" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
