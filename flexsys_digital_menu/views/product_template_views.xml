<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_digital_menu" model="ir.ui.view">
        <field name="name">product.template.form.digital.menu</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Digital Menu" name="flexsys_digital_menu" groups="flexsys_digital_menu.group_digital_menu_user">
                    <group>
                        <group>
                            <field name="digital_menu_enabled"/>
                            <field name="digital_menu_primary_menu_id"
                                   options="{'no_create': True}"
                                   required="digital_menu_enabled"/>
                            <field name="digital_menu_primary_category_id"
                                   domain="[('menu_id', '=', digital_menu_primary_menu_id)]"
                                   options="{'no_create': True}"
                                   invisible="not digital_menu_primary_menu_id"/>
                            <field name="digital_menu_display_order" invisible="not digital_menu_primary_menu_id"/>
                            <field name="digital_menu_featured_default"/>
                            <field name="digital_menu_default_badge"/>
                            <field name="digital_menu_custom_badge" invisible="digital_menu_default_badge != 'custom'"/>
                        </group>
                        <group string="Menu Image">
                            <field name="digital_menu_image" widget="image"/>
                        </group>
                    </group>

                    <field name="digital_menu_short_description"
                           placeholder="Short description shown to customers only when provided"/>

                    <separator string="Product Details"/>
                    <group>
                        <group>
                            <field name="digital_menu_calories"/>
                            <field name="digital_menu_spicy_level"/>
                            <field name="digital_menu_vegetarian"/>
                            <field name="digital_menu_vegan"/>
                            <field name="digital_menu_gluten_info"/>
                        </group>
                        <group>
                            <field name="digital_menu_ingredients"/>
                            <field name="digital_menu_allergens"/>
                        </group>
                    </group>

                    <separator string="Actions"/>
                    <div class="d-flex gap-2 flex-wrap">
                        <button name="action_preview_digital_menu"
                                type="object"
                                string="Preview Product"
                                class="btn-primary"
                                invisible="not digital_menu_line_ids"/>
                        <button name="action_open_digital_menu_advanced"
                                type="object"
                                string="Advanced Settings"
                                class="btn-secondary"
                                groups="flexsys_digital_menu.group_digital_menu_manager"/>
                    </div>

                    <!-- Technical fields stay available to the engine but out of the daily-use UI. -->
                    <field name="digital_menu_line_ids" invisible="1"/>
                    <field name="digital_menu_availability" invisible="1"/>
                    <field name="digital_menu_notes" invisible="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
