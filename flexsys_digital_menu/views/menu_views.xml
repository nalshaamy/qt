<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexsys_menu_search" model="ir.ui.view">
        <field name="name">flexsys.menu.search</field>
        <field name="model">flexsys.menu</field>
        <field name="arch" type="xml">
            <search string="Digital Menus">
                <field name="name"/>
                <field name="slug"/>
                <field name="company_id"/>
                <field name="state"/>
                <filter string="Published" name="published" domain="[('state','=','published')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_flexsys_menu_list" model="ir.ui.view">
        <field name="name">flexsys.menu.list</field>
        <field name="model">flexsys.menu</field>
        <field name="arch" type="xml">
            <list string="Digital Menus" decoration-success="state == 'published'" decoration-muted="state == 'archived'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="public_domain" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="pricelist_id"/>
                <field name="product_count"/>
                <field name="branch_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_flexsys_menu_form" model="ir.ui.view">
        <field name="name">flexsys.menu.form</field>
        <field name="model">flexsys.menu</field>
        <field name="arch" type="xml">
            <form string="FlexSys Digital Menu">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary" groups="flexsys_digital_menu.group_digital_menu_manager" invisible="state == 'published'"/>
                    <button name="action_draft" type="object" string="Set to Draft" groups="flexsys_digital_menu.group_digital_menu_manager" invisible="state == 'draft'"/>
                    <button name="action_archive_menu" type="object" string="Archive" groups="flexsys_digital_menu.group_digital_menu_manager" invisible="state == 'archived'"/>
                    <button name="action_preview_backend" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_open_public" type="object" string="Open Menu" class="btn-secondary" invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_preview_backend" type="object" class="oe_stat_button" icon="fa-eye">
                            <div class="o_stat_info"><span class="o_stat_text">Preview</span></div>
                        </button>
                        <button name="action_generate_qr" type="object" class="oe_stat_button" groups="flexsys_digital_menu.group_digital_menu_manager" icon="fa-qrcode">
                            <div class="o_stat_info"><span class="o_stat_text">Refresh QR</span></div>
                        </button>
                        <button name="action_open_analytics" type="object" class="oe_stat_button" icon="fa-line-chart" invisible="not analytics_enabled">
                            <field name="analytics_views" widget="statinfo" string="Views"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="QTCafe Main Menu"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="slug"/>
                            <field name="public_domain" placeholder="qtcafe.sa"/>
                            <field name="public_url" readonly="1" widget="CopyClipboardChar"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="pos_config_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="pricelist_id"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="timezone"/>
                            <field name="default_language"/>
                            <field name="language_ar"/>
                            <field name="language_en"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Products" name="products">
                            <field name="product_line_ids" context="{'default_menu_id': id}">
                                <list editable="bottom" decoration-muted="effective_visibility == 'Hidden'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_tmpl_id"/>
                                    <field name="category_id" domain="[('menu_id','=',parent.id)]"/>
                                    <field name="effective_availability" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="effective_price" readonly="1" widget="monetary"/>
                                    <field name="pos_config_id" optional="hide"/>
                                    <field name="visibility" optional="hide"/>
                                    <field name="featured_mode" optional="hide"/>
                                    <field name="availability_override" optional="hide"/>
                                    <field name="featured_sequence" optional="hide"/>
                                    <field name="effective_visibility" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Categories" name="categories">
                            <field name="category_ids" context="{'default_menu_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="source_pos_category_ids" widget="many2many_tags"/>
                                    <field name="icon"/>
                                    <field name="featured"/>
                                    <field name="visible"/>
                                </list>
                            </field>
                        </page>

                        <page string="Branding" name="branding">
                            <group>
                                <group>
                                    <field name="brand_name" placeholder="QTCafe"/>
                                    <field name="theme_id"/>
                                    <field name="layout_style"/>
                                    <field name="tagline" placeholder="Coffee • Food • Moments"/>
                                    <button name="action_generate_brand" type="object" string="Generate Brand from Logo" groups="flexsys_digital_menu.group_digital_menu_manager" class="btn-primary" invisible="not logo"/>
                                </group>
                                <group>
                                    <field name="logo" widget="image"/>
                                </group>
                            </group>
                            <separator string="Optional Text Color Overrides"/>
                            <group>
                                <group>
                                    <field name="header_text_color_override" placeholder="#FFFFFF"/>
                                </group>
                                <group>
                                    <field name="footer_text_color_override" placeholder="#17201D"/>
                                </group>
                            </group>
                            <div class="text-muted">Leave text color overrides empty to let the Brand Engine select readable colors automatically from the theme.</div>
                            <separator string="Display Controls"/>
                            <group>
                                <group>
                                    <field name="show_product_images"/>
                                    <field name="show_descriptions"/>
                                    <field name="show_prices"/>
                                    <field name="show_calories"/>
                                    <field name="show_badges"/>
                                </group>
                                <group>
                                    <field name="show_dietary"/>
                                    <field name="show_variants"/>
                                    <field name="show_ingredients"/>
                                    <field name="show_allergens"/>
                                </group>
                            </group>
                        </page>

                        <page string="Offers" name="offers">
                            <div class="text-muted mb-3">Scheduled customer-facing offers. Use an Odoo pricelist when the offer needs a promotional price; no separate pricing engine is created.</div>
                            <field name="offer_ids" context="{'default_menu_id': id}">
                                <list editable="bottom" decoration-success="is_published">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="pricelist_id" optional="show"/>
                                    <field name="start_date" optional="show"/>
                                    <field name="end_date" optional="show"/>
                                    <field name="is_published"/>
                                </list>
                            </field>
                        </page>

                        <page string="Brand Pages" name="brand_pages">
                            <div class="text-muted mb-3">Optional pages share the same brand shell as the menu. A Branches page can render branch data, hours and map links automatically.</div>
                            <button name="action_create_branches_page" type="object" string="Create / Open Branches Page" class="btn-secondary" groups="flexsys_digital_menu.group_digital_menu_manager"/>
                            <field name="page_ids" context="{'default_menu_id': id}">
                                <list decoration-success="is_published">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="page_type"/>
                                    <field name="slug"/>
                                    <field name="show_in_navigation"/>
                                    <field name="is_published"/>
                                </list>
                            </field>
                        </page>

                        <page string="Availability &amp; Scheduling" name="availability">
                            <group>
                                <group>
                                    <field name="availability_source"/>
                                    <field name="sold_out_behavior"/>
                                    <field name="empty_category_behavior"/>
                                </group>
                                <group>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="schedule_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>

                        <page string="Analytics" name="analytics">
                            <group>
                                <group string="Lightweight Analytics">
                                    <field name="analytics_enabled"/>
                                    <field name="analytics_retention_days" invisible="not analytics_enabled"/>
                                    <button name="action_open_analytics" type="object" string="Open Analytics Events" class="btn-secondary" invisible="not analytics_enabled"/>
                                </group>
                                <group string="Summary" invisible="not analytics_enabled">
                                    <field name="analytics_views" readonly="1"/>
                                    <field name="analytics_product_opens" readonly="1"/>
                                    <field name="analytics_searches" readonly="1"/>
                                    <field name="analytics_arabic_share" readonly="1" string="Arabic Share %"/>
                                </group>
                            </group>
                            <group invisible="not analytics_enabled">
                                <group string="Top Activity">
                                    <field name="analytics_top_product" readonly="1"/>
                                    <field name="analytics_top_category" readonly="1"/>
                                    <field name="analytics_top_search" readonly="1"/>
                                </group>
                            </group>
                            <div class="text-muted">Analytics are anonymous: no customer identity, raw IP address or conversation data is stored. Old events are deleted automatically according to the retention setting.</div>
                        </page>

                        <page string="QR" name="qr">
                            <group>
                                <button name="action_generate_qr" type="object" string="Generate / Refresh QR" groups="flexsys_digital_menu.group_digital_menu_manager" class="btn-primary"/>
                                <field name="public_url" readonly="1" widget="CopyClipboardChar"/>
                            </group>
                            <field name="qr_ids" readonly="1">
                                <list>
                                    <field name="url" widget="url"/>
                                    <field name="png" filename="png_filename"/>
                                    <field name="png_filename" column_invisible="True"/>
                                    <field name="svg" filename="svg_filename"/>
                                    <field name="svg_filename" column_invisible="True"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flexsys_menus" model="ir.actions.act_window">
        <field name="name">Digital Menu</field>
        <field name="res_model">flexsys.menu</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flexsys_menu_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first branded digital menu</p>
            <p>Upload a logo, select products and branches, preview, then publish.</p>
        </field>
    </record>

    <record id="action_digital_menu_branches" model="ir.actions.act_window">
        <field name="name">Branches / POS</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_menu_qr_codes" model="ir.actions.act_window">
        <field name="name">QR Codes</field>
        <field name="res_model">flexsys.menu.qr</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_menu_qr_list" model="ir.ui.view">
        <field name="name">flexsys.menu.qr.list</field>
        <field name="model">flexsys.menu.qr</field>
        <field name="arch" type="xml">
            <list string="Digital Menu QR Codes">
                <field name="menu_id"/>
                <field name="url" widget="url"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_menu_qr_form" model="ir.ui.view">
        <field name="name">flexsys.menu.qr.form</field>
        <field name="model">flexsys.menu.qr</field>
        <field name="arch" type="xml">
            <form string="Digital Menu QR">
                <sheet>
                    <group>
                        <field name="menu_id"/>
                        <field name="url" widget="url"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="png" filename="png_filename"/>
                        <field name="png_filename" invisible="1"/>
                        <field name="svg" filename="svg_filename"/>
                        <field name="svg_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
