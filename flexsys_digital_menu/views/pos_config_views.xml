<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_digital_menu_branch" model="ir.ui.view">
        <field name="name">pos.config.form.flexsys.digital.menu.branch</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <group string="Digital Menu Branch" groups="flexsys_digital_menu.group_digital_menu_manager">
                    <group>
                        <field name="digital_menu_public_name" placeholder="QTCafe - Jazan"/>
                        <field name="digital_menu_address"/>
                        <field name="digital_menu_phone"/>
                        <field name="digital_menu_whatsapp"/>
                        <field name="digital_menu_map_url" placeholder="https://maps.google.com/..."/>
                    </group>
                    <group>
                        <field name="digital_menu_image" widget="image"/>
                        <field name="digital_menu_latitude"/>
                        <field name="digital_menu_longitude"/>
                    </group>
                </group>
                <group string="Digital Menu Branch Description" groups="flexsys_digital_menu.group_digital_menu_manager">
                    <field name="digital_menu_description" nolabel="1" placeholder="Short description shown on the branches page..."/>
                </group>
                <group string="Digital Menu Working Hours" groups="flexsys_digital_menu.group_digital_menu_manager">
                    <field name="digital_menu_hour_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="weekday"/>
                            <field name="sequence" widget="handle"/>
                            <field name="closed"/>
                            <field name="time_from" widget="float_time"/>
                            <field name="time_to" widget="float_time"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
