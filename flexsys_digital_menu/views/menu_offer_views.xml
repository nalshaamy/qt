<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexsys_menu_offer_search" model="ir.ui.view">
        <field name="name">flexsys.menu.offer.search</field>
        <field name="model">flexsys.menu.offer</field>
        <field name="arch" type="xml">
            <search string="Offers">
                <field name="name"/>
                <field name="menu_id"/>
                <field name="company_id"/>
                <filter string="Published" name="published" domain="[('is_published','=',True)]"/>
                <group>
                    <filter string="Menu" name="group_menu" context="{'group_by':'menu_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_flexsys_menu_offer_list" model="ir.ui.view">
        <field name="name">flexsys.menu.offer.list</field>
        <field name="model">flexsys.menu.offer</field>
        <field name="arch" type="xml">
            <list string="Offers" decoration-success="is_published">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="menu_id"/>
                <field name="pricelist_id" optional="show"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_flexsys_menu_offer_form" model="ir.ui.view">
        <field name="name">flexsys.menu.offer.form</field>
        <field name="model">flexsys.menu.offer</field>
        <field name="arch" type="xml">
            <form string="Digital Menu Offer">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Morning Offer"/></h1>
                    </div>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="menu_id"/>
                            <field name="subtitle"/>
                            <field name="sequence"/>
                            <field name="is_published"/>
                            <field name="pricelist_id" domain="['|',('company_id','=',False),('company_id','=',company_id)]"/>
                        </group>
                        <group>
                            <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Short customer-facing offer description..."/>
                    </group>
                    <separator string="Products and Schedule"/>
                    <group>
                        <group>
                            <field name="product_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="schedule_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_menu_offers" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">flexsys.menu.offer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flexsys_menu_offer_search"/>
    </record>
</odoo>
