<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexsys_brand_page_list" model="ir.ui.view">
        <field name="name">flexsys.brand.page.list</field>
        <field name="model">flexsys.brand.page</field>
        <field name="arch" type="xml">
            <list string="Brand Pages" decoration-success="is_published">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="page_type"/>
                <field name="slug"/>
                <field name="show_in_navigation"/>
                <field name="is_published"/>
            </list>
        </field>
    </record>

    <record id="view_flexsys_brand_page_form" model="ir.ui.view">
        <field name="name">flexsys.brand.page.form</field>
        <field name="model">flexsys.brand.page</field>
        <field name="arch" type="xml">
            <form string="Brand Page">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="subtitle"/>
                            <field name="page_type"/>
                        </group>
                        <group>
                            <field name="slug"/>
                            <field name="sequence"/>
                            <field name="show_in_navigation"/>
                            <field name="is_published"/>
                            <field name="public_url" readonly="1" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                    <group>
                        <field name="seo_title"/>
                    </group>
                    <field name="body_html" widget="html" placeholder="Tell your brand story, introduce your branches, or add other customer-facing content..."/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
