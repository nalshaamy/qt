<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_schedule_list" model="ir.ui.view">
        <field name="name">flexsys.menu.schedule.list</field>
        <field name="model">flexsys.menu.schedule</field>
        <field name="arch" type="xml">
            <list string="Menu Schedules">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="time_from" widget="float_time"/>
                <field name="time_to" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_menu_schedule_form" model="ir.ui.view">
        <field name="name">flexsys.menu.schedule.form</field>
        <field name="model">flexsys.menu.schedule</field>
        <field name="arch" type="xml">
            <form string="Menu Schedule">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="time_from" widget="float_time"/>
                            <field name="time_to" widget="float_time"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Days">
                        <group>
                            <field name="monday"/>
                            <field name="tuesday"/>
                            <field name="wednesday"/>
                            <field name="thursday"/>
                        </group>
                        <group>
                            <field name="friday"/>
                            <field name="saturday"/>
                            <field name="sunday"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_menu_schedules" model="ir.actions.act_window">
        <field name="name">Schedules</field>
        <field name="res_model">flexsys.menu.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
