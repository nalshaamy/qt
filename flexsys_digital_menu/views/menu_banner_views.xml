<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexsys_menu_banner_search" model="ir.ui.view">
        <field name="name">flexsys.menu.banner.search</field>
        <field name="model">flexsys.menu.banner</field>
        <field name="arch" type="xml">
            <search string="Promotional Banners">
                <field name="name"/>
                <field name="menu_id"/>
                <field name="company_id"/>
                <filter string="Published" name="published" domain="[('is_published','=',True)]"/>
                <group>
                    <filter string="Menu" name="group_menu" context="{'group_by':'menu_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_flexsys_menu_banner_list" model="ir.ui.view">
        <field name="name">flexsys.menu.banner.list</field>
        <field name="model">flexsys.menu.banner</field>
        <field name="arch" type="xml">
            <list string="Promotional Banners" decoration-success="is_published">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="menu_id"/>
                <field name="media_type"/>
                <field name="fit_mode" optional="show"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_flexsys_menu_banner_form" model="ir.ui.view">
        <field name="name">flexsys.menu.banner.form</field>
        <field name="model">flexsys.menu.banner</field>
        <field name="arch" type="xml">
            <form string="Promotional Banner">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ramadan Campaign"/></h1>
                    </div>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="menu_id"/>
                            <field name="media_type"/>
                            <field name="fit_mode"/>
                            <field name="sequence"/>
                            <field name="is_published"/>
                            <field name="alt_text"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="schedule_ids" widget="many2many_tags"/>
                            <field name="click_url" placeholder="https://... or /menu/..."/>
                            <field name="open_new_tab" invisible="not click_url"/>
                        </group>
                    </group>
                    <separator string="Banner Media"/>
                    <group>
                        <group string="Desktop / Tablet">
                            <field name="desktop_filename" invisible="1"/>
                            <field name="desktop_media" filename="desktop_filename" widget="binary"/>
                            <div class="text-muted">Image/Animated: JPG, PNG, WebP or GIF as appropriate. Video: MP4 or WebM. Maximum 25 MB.</div>
                        </group>
                        <group string="Mobile Override (Optional)">
                            <field name="mobile_filename" invisible="1"/>
                            <field name="mobile_media" filename="mobile_filename" widget="binary"/>
                            <div class="text-muted">Leave empty to reuse the desktop media on mobile.</div>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The public banner uses a fixed centered container. Desktop is approximately 3:1, tablet 2.5:1, and mobile 16:9. The container never stretches beyond its defined width.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_menu_banners" model="ir.actions.act_window">
        <field name="name">Promotional Banners</field>
        <field name="res_model">flexsys.menu.banner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flexsys_menu_banner_search"/>
    </record>
</odoo>
