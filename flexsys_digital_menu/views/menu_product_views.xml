<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_product_list" model="ir.ui.view">
        <field name="name">flexsys.menu.product.list</field>
        <field name="model">flexsys.menu.product</field>
        <field name="arch" type="xml">
            <list string="Digital Menu Products" decoration-muted="effective_visibility == 'Hidden'">
                <field name="sequence" widget="handle"/>
                <field name="featured_sequence" optional="hide"/>
                <field name="product_tmpl_id"/>
                <field name="menu_id"/>
                <field name="category_id"/>
                <field name="pos_config_id" optional="show"/>
                <field name="effective_visibility"/>
                <field name="effective_availability"/>
                <field name="effective_featured"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="effective_price" widget="monetary"/>
            </list>
        </field>
    </record>

    <record id="view_menu_product_form" model="ir.ui.view">
        <field name="name">flexsys.menu.product.form</field>
        <field name="model">flexsys.menu.product</field>
        <field name="arch" type="xml">
            <form string="Digital Menu Product">
                <sheet>
                    <div class="oe_title"><h1><field name="product_tmpl_id"/></h1></div>
                    <group>
                        <group>
                            <field name="menu_id"/>
                            <field name="category_id"/>
                            <field name="pos_config_id"/>
                            <field name="sequence"/>
                            <field name="featured_sequence"/>
                        </group>
                        <group string="Effective Result">
                            <field name="effective_visibility" readonly="1"/>
                            <field name="effective_availability" readonly="1"/>
                            <field name="effective_featured" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="effective_price" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Display">
                            <group>
                                <group>
                                    <field name="visibility"/>
                                    <field name="featured_mode"/>
                                    <field name="badge_mode"/>
                                    <field name="badge_type" invisible="badge_mode != 'custom'"/>
                                    <field name="custom_badge_ar" invisible="badge_mode != 'custom' or badge_type != 'custom'"/>
                                    <field name="custom_badge_en" invisible="badge_mode != 'custom' or badge_type != 'custom'"/>
                                    <field name="custom_badge" invisible="1"/>
                                </group>
                                <group>
                                    <field name="name_override"/>
                                    <field name="description_override"/>
                                    <field name="image_override" widget="image"/>
                                </group>
                            </group>
                        </page>
                        <page string="Availability &amp; Price">
                            <group>
                                <group>
                                    <field name="availability_override"/>
                                    <field name="schedule_id"/>
                                </group>
                                <group>
                                    <field name="price_mode"/>
                                    <field name="override_price" widget="monetary" invisible="price_mode != 'override'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <field name="public_key" invisible="1"/>
                    <field name="is_branch_override" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_menu_products" model="ir.actions.act_window">
        <field name="name">Menu Products</field>
        <field name="res_model">flexsys.menu.product</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
