<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_category_list" model="ir.ui.view">
        <field name="name">flexsys.menu.category.list</field>
        <field name="model">flexsys.menu.category</field>
        <field name="arch" type="xml">
            <list string="Digital Menu Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="menu_id"/>
                <field name="pos_category_id"/>
                <field name="icon"/>
                <field name="featured"/>
                <field name="visible"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_menu_category_form" model="ir.ui.view">
        <field name="name">flexsys.menu.category.form</field>
        <field name="model">flexsys.menu.category</field>
        <field name="arch" type="xml">
            <form string="Digital Menu Category">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="menu_id"/>
                            <field name="pos_category_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="slab_background" placeholder="#F6F7F4"/>
                            <field name="featured"/>
                            <field name="visible"/>
                        </group>
                    </group>
                    <field name="public_key" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_menu_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">flexsys.menu.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
