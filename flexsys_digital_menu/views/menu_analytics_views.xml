<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexsys_menu_analytics_search" model="ir.ui.view">
        <field name="name">flexsys.menu.analytics.event.search</field>
        <field name="model">flexsys.menu.analytics.event</field>
        <field name="arch" type="xml">
            <search string="Digital Menu Analytics">
                <field name="menu_id"/>
                <field name="event_type"/>
                <field name="reference_label"/>
                <field name="search_term"/>
                <field name="language"/>
                <field name="pos_config_id"/>
                <filter string="Today" name="today" domain="[('event_date','=',context_today())]"/>
                <group>
                    <filter string="Event" name="group_event_type" context="{'group_by':'event_type'}"/>
                    <filter string="Menu" name="group_menu" context="{'group_by':'menu_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'event_date'}"/>
                    <filter string="Language" name="group_language" context="{'group_by':'language'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by':'pos_config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_flexsys_menu_analytics_list" model="ir.ui.view">
        <field name="name">flexsys.menu.analytics.event.list</field>
        <field name="model">flexsys.menu.analytics.event</field>
        <field name="arch" type="xml">
            <list string="Digital Menu Analytics" create="0" edit="0" delete="0">
                <field name="event_at"/>
                <field name="menu_id"/>
                <field name="event_type" widget="badge"/>
                <field name="reference_label" optional="show"/>
                <field name="search_term" optional="show"/>
                <field name="language" optional="show"/>
                <field name="pos_config_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_menu_analytics_events" model="ir.actions.act_window">
        <field name="name">Analytics</field>
        <field name="res_model">flexsys.menu.analytics.event</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_flexsys_menu_analytics_search"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
