<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_theme_list" model="ir.ui.view">
        <field name="name">flexsys.menu.theme.list</field>
        <field name="model">flexsys.menu.theme</field>
        <field name="arch" type="xml">
            <list string="Digital Menu Themes">
                <field name="name"/>
                <field name="mode"/>
                <field name="style"/>
                <field name="primary"/>
                <field name="accent"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_menu_theme_form" model="ir.ui.view">
        <field name="name">flexsys.menu.theme.form</field>
        <field name="model">flexsys.menu.theme</field>
        <field name="arch" type="xml">
            <form string="Digital Menu Theme">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="mode"/>
                            <field name="style"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Radii">
                            <field name="radius_sm"/>
                            <field name="radius_md"/>
                            <field name="radius_lg"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Brand Colors">
                            <group>
                                <group>
                                    <field name="primary"/>
                                    <field name="primary_light"/>
                                    <field name="primary_dark"/>
                                    <field name="secondary"/>
                                    <field name="accent"/>
                                </group>
                                <group>
                                    <field name="background"/>
                                    <field name="surface"/>
                                    <field name="slab"/>
                                    <field name="border"/>
                                </group>
                            </group>
                        </page>
                        <page string="Text &amp; Components">
                            <group>
                                <group>
                                    <field name="text"/>
                                    <field name="text_muted"/>
                                    <field name="selected"/>
                                </group>
                                <group>
                                    <field name="button_background"/>
                                    <field name="button_text"/>
                                    <field name="badge_background"/>
                                    <field name="badge_text"/>
                                </group>
                            </group>
                        </page>
                        <page string="Shadows">
                            <group>
                                <field name="shadow_sm"/>
                                <field name="shadow_md"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_menu_themes" model="ir.actions.act_window">
        <field name="name">Themes</field>
        <field name="res_model">flexsys.menu.theme</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
