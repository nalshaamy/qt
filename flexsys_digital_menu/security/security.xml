<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 native privilege hierarchy: Sales category → Digital Menu privilege → User/Administrator.
         This makes Digital Menu appear on the user form as a normal access-right selector,
         alongside Sales and Point of Sale, instead of standalone boolean checkboxes. -->
    <record id="res_groups_privilege_digital_menu" model="res.groups.privilege">
        <field name="name">Digital Menu</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_digital_menu_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="flexsys_digital_menu.res_groups_privilege_digital_menu"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_digital_menu_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="flexsys_digital_menu.res_groups_privilege_digital_menu"/>
        <field name="implied_ids" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>

    <record id="rule_menu_company" model="ir.rule">
        <field name="name">Digital Menu: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_category_company" model="ir.rule">
        <field name="name">Digital Menu Categories: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_category"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_product_company" model="ir.rule">
        <field name="name">Digital Menu Products: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_product"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_theme_company" model="ir.rule">
        <field name="name">Digital Menu Themes: shared or allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_theme"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_schedule_company" model="ir.rule">
        <field name="name">Digital Menu Schedules: shared or allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_schedule"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_brand_page_company" model="ir.rule">
        <field name="name">Digital Menu Brand Pages: allowed companies</field>
        <field name="model_id" ref="model_flexsys_brand_page"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_qr_company" model="ir.rule">
        <field name="name">Digital Menu QR: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_qr"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_menu_offer_company" model="ir.rule">
        <field name="name">Digital Menu Offers: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_offer"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_analytics_company" model="ir.rule">
        <field name="name">Digital Menu Analytics: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_analytics_event"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_branch_hour_company" model="ir.rule">
        <field name="name">Digital Menu Branch Hours: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_branch_hour"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_branch_hour_pos_company" model="ir.rule">
        <field name="name">Digital Menu Branch Hours: POS allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_branch_hour"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_menu_banner_company" model="ir.rule">
        <field name="name">Digital Menu Banners: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_banner"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
