<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_digital_menu_user" model="res.groups">
        <field name="name">Digital Menu User</field>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_digital_menu_manager" model="res.groups">
        <field name="name">Digital Menu Manager</field>
        <field name="implied_ids" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>

    <record id="rule_menu_company" model="ir.rule">
        <field name="name">Digital Menu: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_category_company" model="ir.rule">
        <field name="name">Digital Menu Categories: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_category"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_product_company" model="ir.rule">
        <field name="name">Digital Menu Products: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_product"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_theme_company" model="ir.rule">
        <field name="name">Digital Menu Themes: shared or allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_theme"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_schedule_company" model="ir.rule">
        <field name="name">Digital Menu Schedules: shared or allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_schedule"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_menu_qr_company" model="ir.rule">
        <field name="name">Digital Menu QR: allowed companies</field>
        <field name="model_id" ref="model_flexsys_menu_qr"/>
        <field name="groups" eval="[(4, ref('flexsys_digital_menu.group_digital_menu_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
