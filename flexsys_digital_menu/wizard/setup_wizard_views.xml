<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_setup_wizard_form" model="ir.ui.view">
        <field name="name">flexsys.menu.setup.wizard.form</field>
        <field name="model">flexsys.menu.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Digital Menu">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="slug"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="public_domain" placeholder="qtcafe.sa"/>
                        <field name="default_language"/>
                    </group>
                    <group>
                        <field name="logo" widget="image"/>
                        <field name="pricelist_id"/>
                        <field name="pos_config_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <group>
                    <field name="product_tmpl_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_create_menu" type="object" string="Create Menu" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_menu_setup_wizard" model="ir.actions.act_window">
        <field name="name">Create Digital Menu</field>
        <field name="res_model">flexsys.menu.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
