<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        FlexSys KDS - POC-1D ONLY (TEMPORARY).
        MERGE UPDATE: the "Printing" tab itself (and its
        flexsys_printing_method/flexsys_printer_ip/
        flexsys_use_local_network_access fields) now lives permanently
        in flexsys_kds's own kds_station_views.xml
        (page name="flexsys_printing"). This view now only ADDS the
        one remaining POC-only field (flexsys_iot_device_placeholder,
        confirmed to have zero runtime dependency, not
        production-proven) into that same, already-existing tab -
        never a separate tab of its own anymore.
    -->
    <record id="view_kds_station_form_poc1d" model="ir.ui.view">
        <field name="name">kds.station.form.poc1d</field>
        <field name="model">kds.station</field>
        <field name="inherit_id" ref="flexsys_kds.view_kds_station_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='flexsys_printing']/group" position="inside">
                <field name="flexsys_iot_device_placeholder"
                       invisible="flexsys_printing_method != 'iot'"/>
            </xpath>
        </field>
    </record>

</odoo>
