<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexsys_pos_reference_guard_log_list" model="ir.ui.view">
        <field name="name">flexsys.pos.reference.guard.log.list</field>
        <field name="model">flexsys.pos.reference.guard.log</field>
        <field name="arch" type="xml">
            <list string="POS Reference Guard Logs" create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="cashier_name" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="order_id"/>
                <field name="order_uuid" optional="hide"/>
                <field name="original_pos_reference"/>
                <field name="replacement_pos_reference"/>
                <field name="original_tracking_number" optional="hide"/>
                <field name="replacement_tracking_number" optional="show"/>
                <field name="duplicate_order_id" optional="show"/>
                <field name="reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_flexsys_pos_reference_guard_log_form" model="ir.ui.view">
        <field name="name">flexsys.pos.reference.guard.log.form</field>
        <field name="model">flexsys.pos.reference.guard.log</field>
        <field name="arch" type="xml">
            <form string="POS Reference Guard Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="config_id"/>
                            <field name="session_id"/>
                            <field name="cashier_name"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="order_id"/>
                            <field name="order_uuid"/>
                            <field name="duplicate_order_id"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <group string="Reference Repair">
                        <group>
                            <field name="original_pos_reference"/>
                            <field name="original_tracking_number"/>
                        </group>
                        <group>
                            <field name="replacement_pos_reference"/>
                            <field name="replacement_tracking_number"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flexsys_pos_reference_guard_log" model="ir.actions.act_window">
        <field name="name">Reference Guard Logs</field>
        <field name="res_model">flexsys.pos.reference.guard.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_flexsys_pos_reference_guard_log"
        name="Reference Guard Logs"
        parent="point_of_sale.menu_point_root"
        action="action_flexsys_pos_reference_guard_log"
        sequence="95"
        groups="point_of_sale.group_pos_manager"
    />
</odoo>
