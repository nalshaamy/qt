msgid "%(product)s (qty %(old_qty)s) fully cancelled - POS quantity decrease exceeded this line's own full share, cascading into earlier production history"
msgstr "تم إلغاء %(product)s بالكامل (الكمية %(old_qty)s) - تجاوز تخفيض الكمية في نقطة البيع كامل حصة هذا السطر، وامتد إلى سجل الإنتاج السابق"

