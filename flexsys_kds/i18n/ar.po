#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s (qty %(old_qty)s) fully cancelled - POS quantity decrease exceeded this line's own full share, cascading into earlier production history"
msgstr "تم إلغاء %(product)s بالكامل (الكمية %(old_qty)s) - تجاوز تخفيض الكمية في نقطة البيع كامل حصة هذا السطر، وامتد إلى سجل الإنتاج السابق"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s (qty %(old_qty)s, previously %(state)s) fully cancelled - POS quantity decrease absorbed this entire portion"
msgstr "تم إلغاء %(product)s بالكامل (الكمية %(old_qty)s، كانت %(state)s) - امتص تخفيض الكمية في نقطة البيع هذا الجزء بالكامل"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s (qty %(old_qty)s, previously %(state)s) fully cancelled - POS quantity decrease cascaded into and absorbed this entire portion"
msgstr "تم إلغاء %(product)s بالكامل (الكمية %(old_qty)s، كانت %(state)s) - امتد تخفيض الكمية في نقطة البيع وامتص هذا الجزء بالكامل"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s fully refunded after original line was already completed - informational only, no production change"
msgstr "تم استرداد %(product)s بالكامل بعد أن كان السطر الأصلي مكتملًا بالفعل - للعلم فقط، لا تغيير على الإنتاج"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s fully removed from POS order (quantity: %(qty)s -> 0, cancelled_qty: %(qty)s)"
msgstr "تمت إزالة %(product)s بالكامل من طلب نقطة البيع (الكمية: %(qty)s -> 0، الكمية الملغاة: %(qty)s)"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s modified after original line was already %(state)s (qty %(old_qty)s -> %(new_qty)s) - added as a new delta line instead of rewriting existing production history"
msgstr "تم تعديل %(product)s بعد أن كان السطر الأصلي %(state)s بالفعل (الكمية %(old_qty)s -> %(new_qty)s) - أُضيف كسطر فرق جديد بدلاً من إعادة كتابة سجل الإنتاج الحالي"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s partially refunded after original line was already completed (qty %(old_qty)s -> %(new_qty)s) - informational only, no production change"
msgstr "تم استرداد %(product)s جزئيًا بعد أن كان السطر الأصلي مكتملًا بالفعل (الكمية %(old_qty)s -> %(new_qty)s) - للعلم فقط، لا تغيير على الإنتاج"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s reduced after original line was already %(state)s (qty %(old_qty)s -> %(new_qty)s) - decrease cascaded into this portion, no production reopened"
msgstr "تم تخفيض %(product)s بعد أن كان السطر الأصلي بالفعل %(state)s (الكمية %(old_qty)s -> %(new_qty)s) - امتد التخفيض إلى هذا الجزء، دون إعادة فتح الإنتاج"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s reduced after original line was already %(state)s (qty %(old_qty)s -> %(new_qty)s) - quantity reduced in place, no production reopened"
msgstr "تم تخفيض %(product)s بعد أن كان السطر الأصلي %(state)s بالفعل (الكمية %(old_qty)s -> %(new_qty)s) - تم تخفيض الكمية في مكانها، دون إعادة فتح الإنتاج"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s reduced after original line was already completed and the POS order closed (qty %(old_qty)s -> %(new_qty)s) - no new preparation delta created, completed history preserved"
msgstr "تم تخفيض %(product)s بعد أن كان السطر الأصلي مكتملًا وأُغلق طلب نقطة البيع (الكمية %(old_qty)s -> %(new_qty)s) - لم يُنشأ فرق تحضير جديد، وسجل الإكمال محفوظ"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s reduced by refund (qty %(old_qty)s -> %(new_qty)s, refund order %(ref)s)"
msgstr "تم تخفيض %(product)s بسبب استرداد (الكمية %(old_qty)s -> %(new_qty)s، طلب الاسترداد %(ref)s)"

#. module: flexsys_kds
#. odoo-python
#: code:addons/flexsys_kds/models/pos_order.py:0
#, python-format
msgid "%(product)s reduced to zero in POS (quantity: %(qty)s -> 0, cancelled_qty: %(qty)s)"
msgstr "تم تخفيض %(product)s إلى صفر في نقطة البيع (الكمية: %(qty)s -> 0، الكمية الملغاة: %(qty)s)"

