<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kds_printer_list" model="ir.ui.view">
        <field name="type">list</field>
        <field name="name">kds.printer.list</field>
        <field name="model">kds.printer</field>
        <field name="arch" type="xml">
            <!-- create=false (dev request, item 2): printer creation is
                 handled elsewhere (a station's own "Printers" tab, with
                 station_id set contextually) - the generic "New" button
                 here would create an orphaned printer with no station,
                 so it's removed entirely rather than relabeled. Editing
                 an existing printer's config from this flat list stays
                 fully available. -->
            <list string="Printers" create="false">
                <field name="name"/>
                <field name="station_id"/>
                <field name="printer_type"/>
                <field name="ip_address"/>
                <field name="is_default"/>
                <!-- UI/DATA FIX ("Master Change Request", item 13,
                     "Printers List Naming"): "Backup / Fallback
                     Printer" -> "Backup Printer" - matches the field's
                     own already-simplified string below on the form;
                     purely a display-label change, the underlying
                     is_backup field name/value is unaffected. -->
                <field name="is_backup" string="Backup Printer"/>
                <!-- UI/DATA FIX ("Master Change Request", item 13):
                     "Online"/"Offline" -> "Agent Online"/"Agent
                     Offline" - see docs/PRINT_AGENT.md's own "What
                     'Status: Online' actually means" section for the
                     full reasoning: this field reflects the external
                     Print Agent's own reported heartbeat, never a
                     verified physical connection to the printer
                     itself - the label now says exactly that, rather
                     than implying more than it actually confirms.
                     Selection VALUES ('online'/'offline'/'error')
                     stored in the database are completely unchanged -
                     display labels only. -->
                <field name="status" string="Agent Status"
                       decoration-success="status == 'online'" decoration-danger="status == 'error'" decoration-muted="status == 'offline'" widget="badge"/>
                <field name="last_seen" string="Agent Last Seen"/>
            </list>
        </field>
    </record>

    <record id="view_kds_printer_form" model="ir.ui.view">
        <field name="type">form</field>
        <field name="name">kds.printer.form</field>
        <field name="model">kds.printer</field>
        <field name="arch" type="xml">
            <form string="Printer" create="false">
                <header>
                    <!-- UI/DATA FIX ("Master Change Request", item 14,
                         "Printer Form Cleanup"): "REMOVE من Production
                         UI: Mark as Online (No Real Connectivity
                         Check)" - the button that called
                         action_test_connection() is removed entirely
                         from this form. UPDATED ("Deep Dead Code &
                         Commercial Cleanup Request"): the method itself
                         is now also fully removed from the codebase -
                         confirmed zero active callers anywhere - rather
                         than kept unused for a hypothetical future
                         need. This directly resolves item 13's own
                         concern: with this action gone, `status` is set
                         ONLY by a real agent's own successful job report
                         (controllers/kds.py's own agent_result()),
                         making "Agent Online"/"Agent Offline" (list
                         view, above) an accurate label rather than a
                         misleading mix of "verified" and "someone
                         clicked a button." -->
                    <button name="action_set_default" type="object" string="Set as Default" class="btn-secondary"/>
                    <button name="action_set_backup" type="object" string="Set as Backup" class="btn-secondary"/>
                    <button name="action_regenerate_agent_key" type="object" string="Regenerate Agent Key"
                            class="btn-secondary" groups="flexsys_kds.group_kds_administrator"
                            confirm="This invalidates the current key - the print agent bridge for this printer will need the new key. Continue?"/>
                    <!-- UI/DATA FIX ("Printing Configuration Gap - Agent
                         Key Access" / "Rename/Fix Agent Key Action"): a
                         way to actually retrieve the real agent_key
                         value to configure the external print agent
                         process with - the field itself (below, in the
                         "Print Agent" group) stays password-masked at
                         all other times; this button reveals the key
                         ONLY as a one-time, sticky notification the
                         person dismisses manually after copying it by
                         hand, never written back into the form and
                         never regenerating/changing the key. Renamed
                         from "Copy Agent Key"/action_copy_agent_key() -
                         that name implied an automatic clipboard copy
                         this action never actually performed; "Show
                         Agent Key" accurately describes the real,
                         unchanged behavior instead, per the client's
                         own explicit choice over adding new,
                         unverified navigator.clipboard JavaScript. Same
                         access restriction as Regenerate Agent Key,
                         placed directly next to it. -->
                    <button name="action_show_agent_key" type="object" string="Show Agent Key"
                            class="btn-secondary" groups="flexsys_kds.group_kds_administrator"/>
                </header>
                <sheet>
                    <!-- UI/DATA FIX ("Master Change Request", item 14):
                         the long technical explanation of the Claim/
                         Lease/Agent architecture that used to sit here
                         is moved to docs/PRINT_AGENT.md's own new
                         "Architecture at a glance" section - this form
                         is opened dozens of times a day just to
                         configure a printer's own IP/station/role; a
                         short, purely operational note belongs here
                         instead, with a pointer to the full technical
                         picture for whoever actually needs it (usually
                         once, while building the external agent
                         itself, not on every visit to this form). -->
                    <!-- COMMERCIAL UI CLEANUP ("Hide Legacy Print
                         Agent From Commercial UI"), item 3: confirmed
                         live - the prior banner text ("this module
                         does not talk to a physical printer directly")
                         is no longer accurate now that Direct Network
                         (Epson ePOS) is the primary supported
                         commercial path - Odoo's own browser DOES talk
                         directly to the printer for that transport.
                         This form itself is Legacy Agent-specific
                         (kds.printer only exists for that path -
                         Direct Network needs no printer record at all,
                         configured instead per-station under Station
                         -> Printing), so the banner now says so
                         explicitly rather than making a claim about
                         the product's own printing architecture as a
                         whole. -->
                    <div class="alert alert-info" role="alert">
                        This record configures a Legacy Print Agent printer specifically - a
                        separate Print Agent process handles the actual printing for it; see
                        <code>docs/PRINT_AGENT.md</code> for the full protocol. Direct Network
                        (Epson ePOS) printing, FlexSys's own primary supported path, needs no
                        printer record here at all - it's configured per-station instead, under
                        that station's own Printing tab.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="station_id"/>
                            <field name="printer_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="ip_address" invisible="printer_type != 'network'"/>
                            <field name="port" invisible="printer_type != 'network'"/>
                            <field name="usb_identifier" invisible="printer_type == 'network'"/>
                            <field name="model"/>
                            <field name="serial_number"/>
                        </group>
                    </group>
                    <!-- UI/DATA FIX ("Master Change Request", item 15,
                         "Default/Backup UI"): "تجنب وجود طريقتين
                         متعارضتين لتحديد الدور... يفضل: Set as Default
                         / Set as Backup كإجراءات. والحقول تكون
                         indicators/read-only." Confirmed live: these
                         two fields were previously plain, directly-
                         editable checkboxes sitting right alongside the
                         two buttons above that already correctly
                         enforce "only one Default/Backup per station"
                         (action_set_default()/action_set_backup(),
                         kds_printer.py) - ticking a checkbox by hand
                         here bypassed that enforcement entirely,
                         letting a station end up with more than one
                         Default or Backup printer, silently. readonly="1"
                         makes these two fields pure indicators now -
                         the buttons in the header are the only way to
                         actually change either role, guaranteeing the
                         single source of truth their own logic already
                         assumed. Every existing test for
                         action_set_default()/action_set_backup()'s own
                         behavior is unaffected - this is a view-only
                         change. -->
                    <group>
                        <field name="is_default" readonly="1"/>
                        <field name="is_backup" string="Backup Printer" readonly="1"/>
                        <field name="status" string="Agent Status" readonly="1"/>
                        <field name="last_seen" string="Agent Last Seen" readonly="1"/>
                    </group>
                    <group string="Print Agent" groups="flexsys_kds.group_kds_administrator">
                        <field name="agent_key" password="True"/>
                        <div class="text-muted" colspan="2">
                            Shared secret for the local print agent/bridge process polling
                            /flexsys_kds/print/agent/* on behalf of this printer. Do not share it
                            outside the agent process configuration.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kds_printer" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="res_model">kds.printer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
