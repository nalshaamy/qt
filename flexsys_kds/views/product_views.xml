<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_kds" model="ir.ui.view">
        <field name="type">form</field>
        <field name="name">product.template.form.kds</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="kds_station_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_category_form_kds" model="ir.ui.view">
        <field name="type">form</field>
        <field name="name">product.category.form.kds</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="kds_station_id"/>
            </xpath>
        </field>
    </record>
</odoo>
