<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kds_print_job_list" model="ir.ui.view">
        <field name="type">list</field>
        <field name="name">kds.print.job.list</field>
        <field name="model">kds.print.job</field>
        <field name="arch" type="xml">
            <!-- UI/DATA FIX ("Printing UI & Job History - Final Cleanup
                 Before Testing"), items 1, 2, 7: Print Jobs and
                 Reprints are now a single screen - the separate
                 Reprints action/menu entry is removed entirely (see
                 kds_printer_hub_views.xml's own matching change), since
                 both were always backed by this exact same
                 kds.print.job model and this exact same list view; the
                 model already carries everything a "reprint trail"
                 needs (display_job_type/print_number/reason). Column
                 set and order matches the dev request's own item 7
                 exactly: Order | Station | Printer | Job Type | Print #
                 | Scope | Reprint Reason | Status | Retry Count |
                 Escalated | User | Created On - "Job Type" here is
                 display_job_type (the simplified Print/Reprint label -
                 see that field's own docstring in kds_print_job.py for
                 why it's a separate field from the technical, unchanged
                 job_type auto/manual/reprint value), and "Retry Count"
                 stays its own, clearly separate column right next to
                 it - item 5's own explicit requirement ("Retry Count
                 لا يعني Reprint Count") is satisfied by keeping these
                 as two distinct, adjacent, clearly-labeled columns
                 rather than ever conflating them into one. -->
            <!-- UI/DATA FIX ("Printing Cleanup - Toast + Job Record
                 Simplification"), decision item 5: "Improve only the
                 Print Jobs list presentation/grouping so multiple jobs
                 for the same order are easy to understand" - the
                 architecture itself is unchanged (decision items 1-4:
                 one immutable record per actual Print/Reprint request,
                 no record reuse) - `default_order` here makes every
                 job for the same order sort by its own print_number
                 ascending (1, 2, 3...) rather than the model's own
                 default create_date desc, so the real print sequence
                 reads naturally top-to-bottom within each order,
                 whether grouped or not - see the search view below for
                 the new default "Group by Order" behavior that makes
                 this most visible.

                 UI/DATA FIX ("Master Change Request", item 17,
                 "Print Jobs - Default sorting: Newest first"):
                 `order_id` alone (ascending) put the OLDEST orders'
                 own jobs first, contradicting this - `order_id desc`
                 reconciles both requirements together rather than
                 favoring one over the other: the newest orders' own
                 groups appear first (item 17), while print_number
                 (unchanged, still ascending) keeps each individual
                 order's own jobs reading 1, 2, 3 top to bottom within
                 its own group (the earlier fix this doesn't undo). -->
            <list string="Print Jobs" create="false" edit="false"
                  default_order="order_id desc, print_number">
                <field name="order_id"/>
                <field name="station_id"/>
                <field name="printer_id"/>
                <field name="display_job_type" string="Job Type" widget="badge"
                       decoration-info="display_job_type == 'print'"
                       decoration-warning="display_job_type == 'reprint'"/>
                <field name="print_number" string="Print #"/>
                <field name="scope"/>
                <field name="reason" string="Reprint Reason"/>
                <field name="status" decoration-success="status == 'printed'" decoration-danger="status == 'failed'" decoration-warning="status in ('pending','dispatched')" widget="badge"/>
                <field name="retry_count"/>
                <!-- UI/DATA FIX ("Master Change Request", item 18,
                     "Failover Visibility"): a widget/help addition
                     only - when a job escalates to a backup printer
                     after repeated failures, this flag is TRUE on the
                     original (failed) job's own row; the new job
                     created on the backup printer (a separate,
                     independent record - kept exactly as required,
                     "مع الاحتفاظ بالسجلات المستقلة الحالية") sits
                     right next to it once grouped by Order (this
                     screen's own default). Combined with printer_id
                     differing between the two rows, "Original Printer
                     -> Backup Printer" is directly visible without
                     leaving this list - see the new form view below
                     for an even more explicit statement of this, plus
                     the underlying error/lease/agent details this list
                     deliberately doesn't try to cram in. -->
                <field name="escalated" widget="boolean_toggle"
                       help="True on the original job when it was escalated to a backup printer after repeated failures - see the backup printer's own separate job row, right next to this one once grouped by Order."/>
                <field name="user_id"/>
                <field name="create_date" string="Created On"/>
            </list>
        </field>
    </record>

    <record id="view_kds_print_job_search" model="ir.ui.view">
        <field name="type">search</field>
        <field name="name">kds.print.job.search</field>
        <field name="model">kds.print.job</field>
        <field name="arch" type="xml">
            <!-- UI/DATA FIX ("Printing UI & Job History"): with Print
                 Jobs and Reprints now a single screen, these two
                 filters replace the separate "Reprints" destination
                 that used to exist for exactly this purpose - a quick
                 way to look at just the reprint trail, or just the
                 first-print jobs, without leaving this one screen. -->
            <search>
                <field name="order_id"/>
                <field name="station_id"/>
                <field name="printer_id"/>
                <field name="user_id"/>
                <filter string="Print (first)" name="filter_print" domain="[('display_job_type', '=', 'print')]"/>
                <filter string="Reprint" name="filter_reprint" domain="[('display_job_type', '=', 'reprint')]"/>
                <separator/>
                <!-- UI/DATA FIX ("Master Change Request", item 17,
                     "Print Jobs - Filters"): "إضافة/تحسين الفلاتر:
                     Pending, Dispatched, Printed, Failed, Escalated,
                     Reprints." Failed/Escalated/Reprints already
                     existed (see above/below) - Pending/Dispatched/
                     Printed are the three genuinely new ones this round
                     adds, matching status's own three "in-flight or
                     succeeded" values exactly (status's own remaining
                     value, 'cancelled', intentionally has no dedicated
                     filter here - not named in the request's own list,
                     and the existing free-text status field search
                     already covers it if ever needed). -->
                <filter string="Pending" name="filter_pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Dispatched" name="filter_dispatched" domain="[('status', '=', 'dispatched')]"/>
                <filter string="Printed" name="filter_printed" domain="[('status', '=', 'printed')]"/>
                <filter string="Failed" name="filter_failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Escalated" name="filter_escalated" domain="[('escalated', '=', True)]"/>
                <separator/>
                <!-- UI/DATA FIX ("Printing Cleanup - Toast + Job Record
                     Simplification"), decision item 5: "Order" added
                     as its own explicit group-by option - set as the
                     DEFAULT group-by on the action below, so opening
                     Print Jobs immediately clusters every job for the
                     same order together (Print #1, Reprint #2, Reprint
                     #3...) instead of a single flat, chronologically-
                     interleaved list where jobs from unrelated orders
                     sit between them. Station/Job Type/Status remain
                     available as alternative groupings, unchanged. -->
                <filter string="Order" name="group_order" context="{'group_by': 'order_id'}"/>
                <filter string="Station" name="group_station" context="{'group_by': 'station_id'}"/>
                <filter string="Job Type" name="group_display_job_type" context="{'group_by': 'display_job_type'}"/>
                <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="view_kds_print_job_form" model="ir.ui.view">
        <field name="type">form</field>
        <field name="name">kds.print.job.form</field>
        <field name="model">kds.print.job</field>
        <field name="arch" type="xml">
            <!-- UI/DATA FIX ("Master Change Request", item 17, "Print
                 Jobs - Job Detail" / item 18, "Failover Visibility"):
                 new form view - none existed before this fix, only the
                 list. Read-only throughout (create/edit/delete all
                 false): these are operational records this module's
                 own printing engine creates and updates itself
                 (Claim/Lease/Dispatch/Ack/Result) - nothing here is
                 meant to be hand-edited, matching the same read-only
                 principle the list view already established. Shows
                 exactly the fields the request names (Agent, Lease
                 information, Failure/Error, Failover information)
                 without cramming any of them into the list. -->
            <form string="Print Job" create="false" edit="false" delete="false">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not escalated">
                        <!-- UI/DATA FIX ("Master Change Request", item
                             18, "Failover Visibility"): the explicit,
                             plain-language statement the request asks
                             for - "يجب أن يكون من السهل معرفة: Original
                             Printer -> Backup Printer." Shown only on
                             the ORIGINAL (failed) job - escalated=True
                             is set on that record, never on the new
                             backup-printer job itself (kds_print_job.py's
                             own action_mark_failed()), so this
                             correctly appears exactly once per
                             failover, on the job it actually happened
                             to. -->
                        <strong>Escalated to a backup printer</strong> after repeated failures
                        on <field name="printer_id" readonly="1" nolabel="1" class="d-inline"/>.
                        The replacement job was created as its own, separate record on the
                        station's backup printer - group this screen by Order to see it
                        listed right next to this one.
                    </div>
                    <group>
                        <group string="Job">
                            <field name="order_id"/>
                            <field name="station_id"/>
                            <field name="printer_id"/>
                            <field name="display_job_type" string="Job Type"/>
                            <field name="print_number" string="Print #"/>
                            <field name="scope"/>
                            <field name="reason" string="Reprint Reason" invisible="not reason"/>
                            <field name="reason_note" invisible="not reason_note"/>
                            <field name="user_id"/>
                            <field name="create_date" string="Created On"/>
                        </group>
                        <group string="Status">
                            <field name="status"/>
                            <field name="dispatched_at"/>
                            <field name="acknowledged_at"/>
                            <field name="printed_at"/>
                            <field name="copies"/>
                        </group>
                    </group>
                    <!-- UI/DATA FIX ("Master Change Request", item 17):
                         "Agent, Lease information" - claimed_by_agent/
                         claimed_at/lease_expires_at were already tracked
                         by the engine (models/kds_print_job.py) but had
                         no view exposing them at all before this fix. -->
                    <group string="Agent / Lease">
                        <field name="claimed_by_agent" string="Claimed By (Agent)"/>
                        <field name="claimed_at"/>
                        <field name="lease_expires_at"/>
                    </group>
                    <!-- UI/DATA FIX ("Master Change Request", item 17):
                         "Failure/Error" - retry_count/error were also
                         already tracked with no view exposing them. -->
                    <group string="Failure / Retry" invisible="not error and retry_count == 0 and not escalated">
                        <field name="retry_count"/>
                        <field name="error" invisible="not error"/>
                        <field name="escalated"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kds_print_job" model="ir.actions.act_window">
        <field name="name">Print Jobs</field>
        <field name="res_model">kds.print.job</field>
        <!-- UI/DATA FIX ("Master Change Request", item 17, "Print
             Jobs - Job Detail"): "تفاصيل Job يمكن أن تعرض: Agent,
             Lease information, Failure/Error, Failover information.
             لا يلزم حشر كل هذه المعلومات في List View." Adds the new
             form view below to view_mode - the list itself stays
             exactly as focused as it already was; clicking any row now
             opens the full detail instead of doing nothing. -->
        <field name="view_mode">list,form</field>
        <!-- UI/DATA FIX ("Printing Cleanup - Toast + Job Record
             Simplification"), decision item 5: opens already grouped
             by Order by default - see the search view's own
             "group_order" filter above for the full explanation. The
             search view is referenced explicitly here (rather than
             left to Odoo's own implicit default) specifically so this
             default-context wiring is guaranteed to target the correct
             view. -->
        <field name="search_view_id" ref="view_kds_print_job_search"/>
        <field name="context">{'search_default_group_order': 1}</field>
    </record>
</odoo>
