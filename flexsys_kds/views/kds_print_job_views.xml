<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kds_print_job_list" model="ir.ui.view">
        <field name="type">list</field>
        <field name="name">kds.print.job.list</field>
        <field name="model">kds.print.job</field>
        <field name="arch" type="xml">
            <!-- create=false, edit=false (dev request, items 3 & 4): this
                 single list view backs BOTH the Print Jobs and Reprints
                 menu entries (the latter is just this same view filtered
                 by domain - see action_kds_reprint_log below), and both
                 are meant as read-only operational/audit views. Print
                 Jobs are created by the KDS printing engine itself, not
                 manually; Reprints are created only by an actual Reprint
                 action on a real order/ticket. edit=false also makes the
                 escalated boolean_toggle field below display-only rather
                 than manually clickable, matching the same principle -
                 escalation happens via the system's own retry logic, not
                 manual toggling from this list. Search/filter/group-by
                 stay fully available (unaffected by create/edit). -->
            <list string="Print Jobs" create="false" edit="false">
                <field name="order_id"/>
                <field name="station_id"/>
                <field name="printer_id"/>
                <field name="job_type"/>
                <field name="scope"/>
                <field name="reason"/>
                <field name="status" decoration-success="status == 'printed'" decoration-danger="status == 'failed'" decoration-warning="status in ('pending','dispatched')" widget="badge"/>
                <field name="retry_count"/>
                <field name="escalated" widget="boolean_toggle"/>
                <field name="user_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_kds_print_job" model="ir.actions.act_window">
        <field name="name">Print Jobs</field>
        <field name="res_model">kds.print.job</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_kds_reprint_log" model="ir.actions.act_window">
        <field name="name">Reprints</field>
        <field name="res_model">kds.print.job</field>
        <field name="view_mode">list</field>
        <field name="domain">[('job_type', '=', 'reprint')]</field>
        <field name="context">{'search_default_reprint': 1}</field>
    </record>
</odoo>
