<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kds_routing_rule_list" model="ir.ui.view">
        <field name="name">kds.routing.rule.list</field>
        <field name="model">kds.routing.rule</field>
        <!-- REAL BUG FIX, confirmed live (Odoo Server Error: "The root
             node of a form view should be a <form>, not a <list>" during
             an actual module upgrade): this view never declared an
             explicit type - it relied on Odoo auto-inferring 'list' from
             the <arch>'s root tag, which broke the one time view_mode
             on the action below was briefly reordered to "form,list"
             (Odoo tried to validate this record as if it needed to be
             type='form', matching the action's then-first-listed mode,
             regardless of this record's own actual <arch> content).
             Declaring type explicitly removes any dependency on that
             inference entirely, for both records below, regardless of
             whatever order view_mode ends up in. -->
        <field name="type">list</field>
        <field name="arch" type="xml">
            <!-- Non-editable (not editable="bottom") so clicking a row
                 correctly opens the real form (below) rather than
                 editing inline - standard Odoo list->form navigation. -->
            <list string="Routing Rules">
                <field name="sequence" widget="handle" string="Priority"/>
                <field name="name"/>
                <field name="company_id" optional="show"/>
                <field name="pos_config_ids" widget="many2many_tags" optional="show"/>
                <field name="product_ids" widget="many2many_tags"/>
                <field name="pos_categ_ids" widget="many2many_tags"/>
                <!-- UI/DATA FIX ("Master Change Request", item 6,
                     "Inventory Category Cleanup"): confirmed by usage
                     check ("Usage Check أوضحت أن Inventory Category
                     ليست مجرد Routing UI field، بل تدخل أيضًا كـ legacy
                     fallback في routing resolution") - product_categ_ids
                     is genuinely used in real matching logic
                     (KdsRoutingRule._matches()) AND the default-station
                     fallback chain (route_product()'s own inventory-
                     category-level fallback, models/kds_routing_rule.py)
                     - never dead code, so the field itself and every
                     bit of its own backend logic are completely
                     unchanged. Per the explicit decision ("Remove/Hide
                     Inventory Categories from Routing UI only. KEEP the
                     existing backend product.categ_id fallback and
                     related tests completely unchanged"): hidden from
                     this list ONLY - optional="hide" already made it
                     opt-in/hidden by default before this change; this
                     removes it from the column picker entirely, so it
                     can never be shown here again by anyone toggling
                     the column-visibility menu. Any future decision to
                     remove the fallback itself is its own, separate
                     change request, per the client's own explicit
                     note ("أي قرار لإزالة هذا fallback سيكون Change
                     Request مستقل بعد تحليل أثره") - not attempted
                     here. -->
                <field name="order_type_ids" widget="many2many_tags"/>
                <field name="source_ids" widget="many2many_tags"/>
                <field name="station_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_kds_routing_rule_form" model="ir.ui.view">
        <field name="name">kds.routing.rule.form</field>
        <field name="model">kds.routing.rule</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Routing Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <!-- UI/DATA FIX ("Master Change Request",
                                 item 7, "Routing Priority Naming"):
                                 display label only - "Sequence" ->
                                 "Priority", with a help note stating
                                 both required facts plainly ("Lower
                                 number = higher priority", "the first
                                 matching rule wins"). The underlying
                                 field name (sequence) and its stored
                                 integer values are completely
                                 unchanged - this is a label/help-text
                                 change only, exactly matching item 11's
                                 own "لا تغيير على المنطق الحالي"
                                 principle applied here to Routing
                                 instead of POS settings. -->
                            <field name="sequence" string="Priority"
                                   help="Lower number = higher priority. Rules are checked in this order, and the FIRST rule that matches wins - later rules are never checked once one has already matched."/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <!-- UX CLARIFICATION ("Station / Routing UX
                         Clarification"), item 7: reworded for
                         clarity per the explicit request, and
                         extended with the station/routing precedence
                         note - matching behavior
                         (route_product()/_matches()) is completely
                         unchanged, wording only. -->
                    <div class="alert alert-info" role="alert">
                        <strong>Routing logic:</strong>
                        Empty filters match any value. Multiple values
                        within one filter use OR. Different filters
                        work together using AND.
                        <br/>
                        Station POS restrictions are applied before
                        routing filters.
                    </div>
                    <group string="Match Conditions">
                        <group>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="pos_categ_ids" widget="many2many_tags"/>
                            <!-- UI/DATA FIX ("Master Change Request",
                                 item 6): hidden from the Routing UI
                                 only, per the explicit decision - the
                                 field itself and its own backend
                                 matching/fallback logic are completely
                                 unchanged (see kds_routing_rule.py's own
                                 matching comment). invisible="1", not a
                                 removed field entirely, so an
                                 administrator in Developer Mode can
                                 still reach it directly if genuinely
                                 needed for an existing legacy rule,
                                 without reintroducing it to the normal
                                 day-to-day UI. -->
                            <field name="product_categ_ids" widget="many2many_tags" invisible="1"/>
                        </group>
                        <group>
                            <field name="order_type_ids" widget="many2many_tags"/>
                            <field name="source_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <!-- UX CLARIFICATION, item 3: the POS Filter moved
                         out of the always-visible top-level group
                         (where it previously sat, implying it was as
                         fundamental as company_id) into its own
                         clearly-optional "Advanced Filters" section -
                         a normal user setting up a routing rule for
                         Products/POS Categories/Order Types/Sources
                         never needs to touch this field at all. -->
                    <group string="Advanced Filters">
                        <field name="pos_config_ids" widget="many2many_tags"
                               domain="[('id', 'in', pos_filter_domain_ids)]"/>
                    </group>
                    <group string="Destination">
                        <field name="station_id"/>
                        <!-- UX CLARIFICATION, item 4: read-only,
                             informational only - shows what the
                             selected destination station itself
                             already allows, right next to the field
                             that selects it. Never seeds a value into
                             pos_config_ids above. -->
                        <field name="station_pos_config_display" readonly="1"/>
                        <field name="pos_filter_domain_ids" invisible="1"/>
                    </group>
                    <!-- UX CLARIFICATION, item 8: optional, best-effort
                         plain-language restatement of this rule's own
                         current configuration - purely informational,
                         computed from already-loaded fields, no
                         bearing on actual routing evaluation. -->
                    <group invisible="not rule_summary">
                        <field name="rule_summary" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kds_routing_rule" model="ir.actions.act_window">
        <field name="name">Routing Rules</field>
        <field name="res_model">kds.routing.rule</field>
        <!-- REAL FIX (explicit request to revert the previous
             form-first behavior): List View must be what opens first
             when entering Routing - "list,form" with list listed first,
             not "form,list". No context here forces a new record or a
             /new redirect either (there never was one - the earlier
             form-first behavior came entirely from this view_mode
             ordering, not any context/target setting). An empty routing
             table now correctly shows an empty list with a working New
             button, not an automatic blank form. -->
        <field name="view_mode">list,form</field>
    </record>
</odoo>
