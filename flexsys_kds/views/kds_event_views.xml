<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kds_event_list" model="ir.ui.view">
        <field name="type">list</field>
        <field name="name">kds.event.list</field>
        <field name="model">kds.event</field>
        <field name="arch" type="xml">
            <list string="Audit Log" default_order="create_date desc">
                <field name="create_date"/>
                <field name="order_id"/>
                <field name="event_type"/>
                <field name="station_id"/>
                <field name="user_id"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_kds_event" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">kds.event</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
