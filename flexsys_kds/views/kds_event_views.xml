<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kds_event_list" model="ir.ui.view">
        <field name="type">list</field>
        <field name="name">kds.event.list</field>
        <field name="model">kds.event</field>
        <field name="arch" type="xml">
            <!-- UI FIX ("Patch 5", item 5, "Audit Log - Remove New
                 Button"): "Audit Log must be read-only from the UI.
                 Audit records should only be generated by the
                 system." Confirmed live: despite this module's own
                 earlier documentation assuming Audit Log was already
                 read-only, neither this view nor the action below
                 actually set create="false" - the "New" button was
                 genuinely available here. Fixed with the same
                 defense-in-depth pattern already used elsewhere in
                 this module for other system-generated records
                 (kds.print.job, kds.printer, kds.order) - create="false"
                 on both the view and the action's own context.
                 kds.event.log() (the real, programmatic entry point
                 every audit record actually goes through) never uses
                 this view/action at all and is completely unaffected. -->
            <list string="Audit Log" create="false" default_order="create_date desc">
                <field name="create_date"/>
                <field name="order_id"/>
                <field name="event_type"/>
                <field name="station_id"/>
                <field name="user_id"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_kds_event" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">kds.event</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
