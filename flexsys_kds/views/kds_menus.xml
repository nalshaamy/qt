<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_kds_root" name="FlexSys KDS" sequence="35" web_icon="flexsys_kds,static/description/icon.png"/>

    <menuitem id="menu_kds_screen" name="KDS Screen" parent="menu_kds_root" action="action_kds_screen" sequence="1"/>

    <menuitem id="menu_kds_operations" name="Operations" parent="menu_kds_root" sequence="10"/>
    <menuitem id="menu_kds_order_active" name="Active Orders" parent="menu_kds_operations" action="action_kds_order_active" sequence="10"/>
    <menuitem id="menu_kds_order_history" name="Order History" parent="menu_kds_operations" action="action_kds_order_history" sequence="20"/>

    <menuitem id="menu_kds_analytics" name="Analytics" parent="menu_kds_root" action="action_kds_order_analytics" sequence="20"/>

    <!-- Setup/admin screens grouped under one Configuration menu, rather
         than each sitting as its own top-level tab - these are configured
         occasionally (station/printer/routing setup), not used constantly
         during a shift the way KDS Screen / Operations / Analytics are. -->
    <menuitem id="menu_kds_configuration" name="Configuration" parent="menu_kds_root" sequence="30"/>
    <menuitem id="menu_kds_station" name="Stations" parent="menu_kds_configuration" action="action_kds_station" sequence="10"/>
    <menuitem id="menu_kds_routing" name="Routing" parent="menu_kds_configuration" action="action_kds_routing_rule" sequence="20"/>

    <!-- Consolidated per explicit request: one "Printers" menu entry
         opening a landing page with two cards (Printers / Print Jobs -
         see kds_printer_hub.py), replacing the flat menu items that
         used to sit here. UI/DATA FIX ("Printing UI & Job History -
         Final Cleanup Before Testing"): the earlier three-card version
         (Printers / Print Jobs / Reprints) had a separate Reprints
         destination; that card and its own action_kds_reprint_log are
         both removed - Print Jobs now covers both print and reprint
         history in one screen. The two remaining actions
         (action_kds_printer, action_kds_print_job) are untouched -
         action_kds_printer specifically is still used directly by
         kds.station's own "Printers" smart button. -->
    <menuitem id="menu_kds_printer_hub" name="Printers" parent="menu_kds_configuration" action="action_kds_printer_hub" sequence="30"/>

    <menuitem id="menu_kds_audit_log" name="Audit Log" parent="menu_kds_configuration" action="action_kds_event" sequence="60"/>

    <menuitem id="menu_kds_pos_config_send_trigger" name="POS Send-to-KDS Settings"
              parent="menu_kds_configuration" action="action_kds_pos_config_send_trigger" sequence="65"/>

    <!-- Devices & Users menu removed (unused for now - Settings > Users
         already covers user management natively; re-add if/when
         kds.device registration lands, per the README's Phase 2 notes). -->
</odoo>
