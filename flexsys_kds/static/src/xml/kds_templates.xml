<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="flexsys_kds.Screen" owl="1">
    <div class="fs-kds-app" t-att-dir="isRtl ? 'rtl' : 'ltr'">
        <!-- HIGH-DENSITY LAYOUT (dev request, point 6: "sticky header/
             status filters + scrollable orders area"): wraps header,
             the main filter tabs, and the dropdown filters together as
             one sticky unit (see .fs-sticky-top in kds_style.scss) -
             simpler and more robust than making each sibling sticky
             individually with hand-calculated top offsets to stack
             correctly below one another. -->
        <div class="fs-sticky-top">
        <div class="fs-header">
            <div class="fs-header-left">
                <span class="fs-logo">FlexSys <b>KDS</b></span>
                <select class="fs-station-select" t-on-change="onSelectStation">
                    <t t-foreach="state.stations" t-as="st" t-key="st.id">
                        <option t-att-value="st.id" t-att-selected="st.id === state.currentStationId">
                            <t t-esc="st.name"/>
                        </option>
                    </t>
                </select>
                <div class="fs-header-info">
                    <div><t t-esc="labels.branchLabel"/><b t-esc="currentStation.branch_name"/></div>
                    <div><t t-esc="labels.timeLabel"/><b t-esc="state.clockLabel"/></div>
                </div>
            </div>
            <div class="fs-company-badge" t-esc="currentStation.company_name"/>
            <div class="fs-header-right">
                <!-- KDS FULLSCREEN MODE (dev request "V1 Finalization",
                     item 1, "Required for V1") -->
                <button class="fs-fullscreen-toggle" t-on-click="onToggleFullscreen"
                        t-att-aria-label="fsState.isFullscreen ? labels.exitFullscreen : labels.enterFullscreen">
                    <svg t-if="!fsState.isFullscreen" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
                    <svg t-else="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/></svg>
                </button>
                <span class="fs-badge">
                    <t t-esc="labels.printerOnline"/>
                </span>
                <span class="fs-badge">
                    <t t-esc="labels.connection"/>:
                    <span t-attf-class="fs-dot fs-dot-{{state.connectionStatus}}"/>
                    <t t-esc="state.connectionStatus === 'online' ? labels.online : labels.offline"/>
                </span>
            </div>
        </div>

        <div class="fs-filters">
            <button class="fs-filter-btn" t-att-class="state.filter === 'all' ? 'active' : ''" t-on-click="() => this.onSetFilter('all')">
                <t t-esc="labels.filterAll"/> <span class="fs-count" t-esc="counts.all"/>
            </button>
            <button class="fs-filter-btn" t-att-class="state.filter === 'new' ? 'active' : ''" t-on-click="() => this.onSetFilter('new')">
                <t t-esc="labels.filterNew"/> <span class="fs-count" t-esc="counts.new"/>
            </button>
            <button class="fs-filter-btn" t-att-class="state.filter === 'preparing' ? 'active' : ''" t-on-click="() => this.onSetFilter('preparing')">
                <t t-esc="labels.filterPreparing"/> <span class="fs-count" t-esc="counts.preparing"/>
            </button>
            <button class="fs-filter-btn" t-att-class="state.filter === 'ready' ? 'active' : ''" t-on-click="() => this.onSetFilter('ready')">
                <t t-esc="labels.filterReady"/> <span class="fs-count" t-esc="counts.ready"/>
            </button>
            <button class="fs-filter-btn" t-att-class="state.filter === 'completed' ? 'active' : ''" t-on-click="() => this.onSetFilter('completed')">
                <t t-esc="labels.filterCompleted"/> <span class="fs-count" t-esc="counts.completed"/>
            </button>
            <button class="fs-filter-btn" t-att-class="state.filter === 'late' ? 'active' : ''" t-on-click="() => this.onSetFilter('late')">
                <t t-esc="labels.filterLate"/> <span class="fs-count" t-esc="counts.late"/>
            </button>
        </div>

        <div class="fs-dropdown-filters">
            <label>
                <span t-esc="labels.orderTypeFilterLabel"/>
                <select t-on-change="onSelectOrderTypeFilter">
                    <option value="all"><t t-esc="labels.filterAllOption"/></option>
                    <t t-foreach="orderTypeOptions" t-as="opt" t-key="opt.value">
                        <option t-att-value="opt.value" t-att-selected="state.orderTypeFilter === opt.value">
                            <t t-esc="opt.label"/>
                        </option>
                    </t>
                </select>
            </label>
            <label t-if="employeeOptions.length">
                <span t-esc="labels.employeeFilterLabel"/>
                <select t-on-change="onSelectEmployeeFilter">
                    <option value="all"><t t-esc="labels.filterAllOption"/></option>
                    <t t-foreach="employeeOptions" t-as="name" t-key="name">
                        <option t-att-value="name" t-att-selected="state.employeeFilter === name">
                            <t t-esc="name"/>
                        </option>
                    </t>
                </select>
            </label>
            <label t-if="companyOptions.length > 1">
                <span t-esc="labels.companyFilterLabel"/>
                <select t-on-change="onSelectCompanyFilter">
                    <option value="all"><t t-esc="labels.filterAllOption"/></option>
                    <t t-foreach="companyOptions" t-as="name" t-key="name">
                        <option t-att-value="name" t-att-selected="state.companyFilter === name">
                            <t t-esc="name"/>
                        </option>
                    </t>
                </select>
            </label>
            <label t-if="posConfigOptions.length">
                <span t-esc="labels.posConfigFilterLabel"/>
                <select t-on-change="onSelectPosConfigFilter">
                    <option value="all"><t t-esc="labels.filterAllOption"/></option>
                    <t t-foreach="posConfigOptions" t-as="name" t-key="name">
                        <option t-att-value="name" t-att-selected="state.posConfigFilter === name">
                            <t t-esc="name"/>
                        </option>
                    </t>
                </select>
            </label>
        </div>
        </div>

        <div class="fs-grid">
            <t t-foreach="filteredOrders" t-as="order" t-key="order.id">
                <KdsOrderCard order="order" onLineAction="onLineAction" onOrderAction="onOrderAction"
                              onPrintClick="onPrintClick" printingEnabled="printingEnabled"
                              celebrate="state.celebrateOrderIds.includes(order.id)"/>
            </t>
            <div class="fs-empty" t-if="!filteredOrders.length" t-esc="labels.noOrders"/>
        </div>
    </div>
</t>

<t t-name="flexsys_kds.OrderCard" owl="1">
    <div t-attf-class="fs-card {{borderClass}} {{props.celebrate ? 'fs-celebrate' : ''}}">
        <div class="fs-card-head">
            <div class="fs-card-title-row">
                <div class="fs-accent-bar"/>
                <div>
                    <div class="fs-order-number" t-esc="props.order.pos_reference or props.order.name"/>
                    <div class="fs-ordered-ref">#<t t-esc="props.order.name"/> · <t t-esc="orderedAtLabel"/></div>
                </div>
            </div>
            <div class="fs-chips-row">
                <span class="fs-chip">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M4 9v10h16V9"/><path d="M9 19v-6h6v6"/></svg>
                    <t t-esc="props.order.order_type_label or props.order.order_type"/>
                </span>
                <span class="fs-chip" t-if="props.order.table_label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 8 12 14 22 8 12 2"/><polyline points="2 14 12 20 22 14"/></svg>
                    <t t-esc="props.order.table_label"/>
                </span>
                <span t-attf-class="fs-chip fs-chip-timer {{props.order.sla_status === 'late' ? 'fs-pulse' : ''}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>
                    <t t-esc="elapsedLabel"/>
                </span>
            </div>
            <div class="fs-status-blink"><span class="fs-status-dot"/><t t-esc="statusText"/></div>
            <div class="fs-order-customer" t-if="hasCustomerName" t-esc="props.order.customer_name"/>
            <div class="fs-employee-row" t-if="props.order.employee_name">
                <t t-esc="props.order.employee_name"/>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
            </div>
        </div>

        <div class="fs-card-body">
            <t t-foreach="props.order.lines" t-as="line" t-key="line.id">
                <!-- CANCELLATION VISIBILITY (dev request, point 1: "the
                     cancelled line should remain temporarily visible and
                     clearly display CANCELLED... visually distinguishable
                     from active preparation lines"): a cancelled line
                     keeps its normal place in the list (never removed -
                     see the grace-period query fix in both controllers'
                     get_orders() for why it's still in props.order at
                     all) but renders distinctly - dimmed, struck-through
                     title, an explicit CANCELLED badge in place of any
                     variant-change badge, and an X icon on its checkbox
                     (already non-interactive in practice - see
                     _lineNextAction()'s own comment - fs-cancelled below
                     also removes the pointer cursor so it doesn't even
                     look clickable). -->
                <div t-attf-class="fs-line-item {{line.state === 'cancelled' ? 'fs-line-item-cancelled' : ''}}">
                    <div t-attf-class="fs-line-checkbox {{lineCheckboxClass(line)}}"
                         t-on-click="() => this.onLineCheckboxClick(line)">
                        <svg class="fs-icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <svg class="fs-icon-dash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <svg class="fs-icon-cancel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </div>
                    <div class="fs-line-main">
                        <div class="fs-line-title-row">
                            <span class="fs-line-title"><t t-esc="line.qty"/> × <t t-esc="line.product_name"/></span>
                            <span class="fs-variant-pill" t-if="line.variant_info and line.state !== 'cancelled'" t-esc="cleanVariantInfo(line.variant_info)"/>
                            <span class="fs-line-badge fs-line-badge-cancelled" t-if="line.state === 'cancelled'">CANCELLED</span>
                            <span class="fs-line-badge" t-elif="line.line_change and line.line_change !== 'none'"
                                  t-esc="lineChangeLabel(line)"/>
                        </div>
                        <div class="fs-line-note-row" t-if="line.note and line.state !== 'cancelled'">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
                            <span t-esc="line.note"/>
                        </div>
                    </div>
                </div>
            </t>
        </div>

        <div class="fs-card-footer">
            <button class="fs-print-action" t-att-disabled="!props.printingEnabled"
                    t-on-click="onPrintClick" t-att-title="props.printingEnabled ? '' : labels.printDisabledTooltip">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            </button>
            <!-- Real COMPLETED tab (dev request): "There should no longer
                 be a DONE button because the order is already completed"
                 - no button at all now for a Completed order (previously
                 a disabled "DONE" one), not even disabled. The COMPLETED
                 status text on the card header is the sole indicator. -->
            <button class="fs-main-action" t-if="mainAction.action" t-on-click="onMainActionClick">
                <t t-esc="mainAction.label"/>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
        </div>
    </div>
</t>

</templates>
