<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="privilege_flexsys_careers" model="res.groups.privilege">
    <field name="name">FlexSys Careers</field>
    <field name="category_id" ref="base.module_category_human_resources"/>
  </record>
  <record id="group_career_viewer" model="res.groups">
    <field name="name">Careers Viewer</field>
    <field name="privilege_id" ref="privilege_flexsys_careers"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_career_officer" model="res.groups">
    <field name="name">Careers Officer</field>
    <field name="privilege_id" ref="privilege_flexsys_careers"/>
    <field name="implied_ids" eval="[(4, ref('group_career_viewer'))]"/>
  </record>
  <record id="group_career_manager" model="res.groups">
    <field name="name">Careers Manager</field>
    <field name="privilege_id" ref="privilege_flexsys_careers"/>
    <field name="implied_ids" eval="[(4, ref('group_career_officer'))]"/>
  </record>
  <record id="rule_applicant_viewer_general" model="ir.rule">
    <field name="name">Careers Viewer: General Applicants Only</field>
    <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
    <field name="domain_force">[('flexsys_career_is_general', '=', True)]</field>
    <field name="groups" eval="[(4, ref('group_career_viewer'))]"/>
  </record>
  <record id="rule_pool_company" model="ir.rule">
    <field name="name">Career talent pools: allowed companies</field>
    <field name="model_id" ref="hr_recruitment.model_hr_talent_pool"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_career_viewer'))]"/>
  </record>
  <record id="rule_category_company" model="ir.rule">
    <field name="name">Career categories: allowed companies</field>
    <field name="model_id" ref="model_flexsys_career_category"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_career_viewer'))]"/>
  </record>
  <record id="rule_config_company" model="ir.rule">
    <field name="name">Career configurations: allowed companies</field>
    <field name="model_id" ref="model_flexsys_career_config"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_career_viewer'))]"/>
  </record>
  <record id="rule_submission_company" model="ir.rule">
    <field name="name">Career submissions: allowed companies</field>
    <field name="model_id" ref="model_flexsys_career_submission"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_career_manager'))]"/>
  </record>
</odoo>
