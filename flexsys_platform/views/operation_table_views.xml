<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_operations_table_list" model="ir.ui.view">
        <field name="name">flexsys.operations.table.list</field>
        <field name="model">flexsys.operations.table</field>
        <field name="arch" type="xml">
            <list string="Tables" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="pos_config_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_operations_table_form" model="ir.ui.view">
        <field name="name">flexsys.operations.table.form</field>
        <field name="model">flexsys.operations.table</field>
        <field name="arch" type="xml">
            <form string="Table">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="pos_config_id"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_operations_tables" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">flexsys.operations.table</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
