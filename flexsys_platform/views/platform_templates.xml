<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="flexsys_layout" name="FlexSys Standalone Layout">
        <html t-att-lang="request.env.lang or 'en_US'" t-att-dir="'rtl' if (request.env.lang or '').startswith('ar') else 'ltr'">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" content="#173b5b"/>
                <title>FlexSys</title>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
            </head>
            <body class="fs-standalone-body">
                <t t-out="0"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
            </body>
        </html>
    </template>

    <template id="command_palette" name="FlexSys Command Palette">
        <button type="button" class="fs-command-trigger" data-fs-command-open="1" aria-label="Open command palette">
            <span class="fa fa-search"/><span>Search or run a command</span><kbd>Ctrl K</kbd>
        </button>
        <div class="fs-command-backdrop" data-fs-command-backdrop="1" hidden="hidden">
            <section class="fs-command-dialog" role="dialog" aria-modal="true" aria-label="FlexSys command palette">
                <header class="fs-command-search">
                    <span class="fa fa-search" aria-hidden="true"/>
                    <input type="search" data-fs-command-input="1" maxlength="100" autocomplete="off" placeholder="Search applications, orders, customers..." aria-label="Search commands"/>
                    <kbd>Esc</kbd>
                </header>
                <div class="fs-command-results" data-fs-command-results="1" role="listbox"/>
                <footer class="fs-command-footer"><span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span><span><kbd>Enter</kbd> Open</span></footer>
            </section>
        </div>
    </template>

    <template id="login_page" name="FlexSys Platform Login">
        <t t-call="flexsys_platform.flexsys_layout">
            <div class="fs-platform-page fs-login-page">
                <div class="fs-login-card">
                    <div class="fs-brand">
                        <div class="fs-brand-mark">FS</div>
                        <div><h1>FlexSys</h1><p>Smart Operations Platform</p></div>
                    </div>
                    <form method="post" action="/flexsys/login">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label>Username</label>
                        <input name="login" type="text" autocomplete="username" required="required" autofocus="autofocus"/>
                        <label>Password</label>
                        <input name="password" type="password" autocomplete="current-password" required="required"/>
                        <div t-if="error" class="fs-alert fs-alert-danger"><span class="fa fa-exclamation-circle"/><t t-esc="error"/></div>
                        <button type="submit" class="fs-btn fs-btn-primary">Sign in</button>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <template id="launcher_page" name="FlexSys Mission Control">
        <t t-call="flexsys_platform.flexsys_layout">
            <div class="fs-platform-page fs-launcher">
                <div class="fs-shell">
                    <header class="fs-launcher-header">
                        <div class="fs-brand">
                            <div class="fs-brand-mark">FS</div>
                            <div><h1>FlexSys</h1><p>Smart Operations Platform</p></div>
                        </div>
                        <div class="fs-user-context">
                            <span class="fs-user-pill" t-esc="platform_user.name"/>
                            <form method="post" action="/flexsys/context" class="fs-context-form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <select name="company_id" aria-label="Company" onchange="this.form.submit()">
                                    <option t-foreach="allowed_companies" t-as="item"
                                            t-att-value="item.id" t-att-selected="item == company"
                                            t-esc="item.name"/>
                                </select>
                                <select name="branch_id" aria-label="Branch" onchange="this.form.submit()">
                                    <option value="">All branches</option>
                                    <option t-foreach="allowed_branches" t-as="item"
                                            t-att-value="item.id" t-att-selected="item == branch"
                                            t-esc="item.name"/>
                                </select>
                            </form>
                            <form method="post" action="/flexsys/logout" class="fs-logout-form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="fs-btn fs-btn-ghost"><span class="fa fa-sign-out"/>Sign out</button>
                            </form>
                        </div>
                    </header>
                    <t t-call="flexsys_platform.command_palette"/>

                    <form action="/flexsys/search" method="get" class="fs-global-search" role="search">
                        <span class="fa fa-search" aria-hidden="true"/>
                        <input type="search" name="q" minlength="2" maxlength="100" placeholder="Search orders, customers and more..." aria-label="Search FlexSys"/>
                        <button type="submit" class="fs-btn fs-btn-primary">Search</button>
                    </form>

                    <main>
                        <section class="fs-welcome">
                            <div class="fs-welcome-content">
                                <span class="fs-eyebrow"><span class="fa fa-compass"/> Mission Control</span>
                                <h2>Welcome, <t t-esc="platform_user.name"/></h2>
                                <p>
                                    <t t-esc="company.name"/>
                                    <t t-if="branch"> · <t t-esc="branch.name"/></t>
                                    <t t-else=""> · All branches</t>
                                </p>
                            </div>
                            <div class="fs-health-summary">
                                <span t-attf-class="fs-status-chip fs-status-#{platform_health}">
                                    <span class="fs-status-dot"/><t t-esc="platform_health.title()"/>
                                </span>
                                <strong>Platform status</strong>
                            </div>
                        </section>

                        <section class="fs-kpi-grid" aria-label="Platform overview">
                            <article class="fs-kpi-card">
                                <span class="fs-kpi-icon fa fa-th-large"/>
                                <div><span>Applications</span><strong t-esc="len(applications)"/></div>
                            </article>
                            <article class="fs-kpi-card">
                                <span class="fs-kpi-icon fa fa-check-circle"/>
                                <div><span>Healthy</span><strong t-esc="health_counts['healthy']"/></div>
                            </article>
                            <article class="fs-kpi-card">
                                <span class="fs-kpi-icon fa fa-exclamation-triangle"/>
                                <div><span>Needs attention</span><strong t-esc="health_counts['degraded'] + health_counts['unavailable']"/></div>
                            </article>
                            <article class="fs-kpi-card">
                                <span class="fs-kpi-icon fa fa-users"/>
                                <div><span>Active sessions</span><strong t-esc="active_sessions"/></div>
                            </article>
                        </section>

                        <section>
                            <div class="fs-section-head">
                                <div><h2>Workspaces</h2><p>Only applications available to your role are shown.</p></div>
                            </div>
                            <div class="fs-app-grid">
                                <a t-foreach="applications" t-as="app" t-att-href="'/flexsys/open/%s' % app.code" class="fs-app-card">
                                    <span t-attf-class="fa #{app.icon} fs-app-icon"/>
                                    <div class="fs-app-content">
                                        <div class="fs-app-title-row">
                                            <h3 t-esc="app.name"/>
                                            <span t-attf-class="fs-status-chip fs-status-#{app.health_status}">
                                                <span class="fs-status-dot"/><t t-esc="health_labels.get(app.health_status)"/>
                                            </span>
                                        </div>
                                        <p t-esc="app.summary"/>
                                        <span class="fs-app-meta">Version <t t-esc="app.version"/></span>
                                    </div>
                                    <span class="fa fa-arrow-right fs-app-arrow"/>
                                </a>
                                <div t-if="not applications" class="fs-empty-state">
                                    <span class="fa fa-th-large"/>
                                    <h3>No workspaces available</h3>
                                    <p>Ask an administrator to assign an application permission to your account.</p>
                                </div>
                            </div>
                        </section>

                        <section class="fs-activity-section">
                            <div class="fs-section-head">
                                <div><h2>Recent activity</h2><p>Latest platform events in the current context.</p></div>
                            </div>
                            <div class="fs-panel">
                                <div t-if="recent_logs" class="fs-activity-list">
                                    <article t-foreach="recent_logs" t-as="log" class="fs-activity-item">
                                        <span t-attf-class="fs-activity-icon fa #{'fa-shield' if log.event_type == 'security' else 'fa-sign-in' if log.event_type == 'authentication' else 'fa-bolt'}"/>
                                        <div class="fs-activity-content">
                                            <strong t-esc="(log.description or log.action.replace('_', ' ').title())"/>
                                            <span>
                                                <t t-if="log.platform_user_id"><t t-esc="log.platform_user_id.name"/> · </t>
                                                <t t-esc="log.action.replace('_', ' ').title()"/>
                                            </span>
                                        </div>
                                        <time t-field="log.create_date"/>
                                    </article>
                                </div>
                                <div t-else="" class="fs-empty-state fs-empty-compact">
                                    <span class="fa fa-history"/>
                                    <h3>No recent activity</h3>
                                    <p>Platform events will appear here as users work.</p>
                                </div>
                            </div>
                        </section>
                    </main>

                    <footer class="fs-platform-footer">
                        <span>FlexSys Platform · 19.0.2.1.4</span><span>Stable core. Flexible experience.</span>
                    </footer>
                </div>
            </div>
        </t>
    </template>

    <template id="workspace_page" name="FlexSys Workspace">
        <t t-call="flexsys_platform.flexsys_layout">
            <div class="fs-platform-page fs-workspace-page">
                <div class="fs-shell">
                    <header class="fs-launcher-header">
                        <div class="fs-brand"><a href="/flexsys" class="fs-brand-mark">FS</a><div><h1 t-esc="application.name"/><p>Workspace</p></div></div>
                        <div class="fs-user-context"><form action="/flexsys/search" method="get" class="fs-header-search" role="search"><span class="fa fa-search"/><input type="search" name="q" minlength="2" maxlength="100" placeholder="Search..." aria-label="Search FlexSys"/></form><span class="fs-user-pill" t-esc="platform_user.name"/><a href="/flexsys" class="fs-btn fs-btn-ghost"><span class="fa fa-th-large"/> Mission Control</a></div>
                    </header>
                    <t t-call="flexsys_platform.command_palette"/>
                    <main>
                        <section class="fs-workspace-hero">
                            <div><span class="fs-eyebrow"><span t-attf-class="fa #{application.icon}"/> Workspace</span><h2 t-esc="application.workspace_title or application.name"/><p t-esc="application.workspace_subtitle or application.summary"/></div>
                            <div class="fs-workspace-context"><strong t-esc="company.name"/><span t-if="branch" t-esc="branch.name"/><span t-else="">All branches</span></div>
                        </section>
                        <section t-if="metric_items" class="fs-kpi-grid">
                            <article t-foreach="metric_items" t-as="item" class="fs-kpi-card">
                                <span t-attf-class="fs-kpi-icon fa #{item.icon}"/><div><span t-esc="item.title"/><strong t-esc="metrics.get(item.metric_key or item.code, 0)"/></div>
                            </article>
                        </section>
                        <section t-if="action_items">
                            <div class="fs-section-head"><div><h2>Quick actions</h2><p>Common tasks for this workspace.</p></div></div>
                            <div class="fs-action-grid"><a t-foreach="action_items" t-as="item" t-att-href="item.action_url or '#'" class="fs-action-card"><span t-attf-class="fa #{item.icon}"/><div><strong t-esc="item.title"/><small t-esc="item.description"/></div><span class="fa fa-arrow-right"/></a></div>
                        </section>
                        <section t-if="widget_items">
                            <div class="fs-section-head"><div><h2>Overview</h2><p>Live workspace information.</p></div></div>
                            <div class="fs-widget-grid"><article t-foreach="widget_items" t-as="item" t-attf-class="fs-panel fs-widget fs-widget-#{item.size}"><div class="fs-widget-head"><span t-attf-class="fa #{item.icon}"/><div><h3 t-esc="item.title"/><p t-esc="item.description"/></div></div><div class="fs-widget-value" t-esc="metrics.get(item.metric_key or item.code, '—')"/></article></div>
                        </section>
                    </main>
                    <footer class="fs-platform-footer"><span>FlexSys Platform · 19.0.2.1.4</span><span>Workspace Framework v1.0</span></footer>
                </div>
            </div>
        </t>
    </template>

    <template id="search_page" name="FlexSys Universal Search">
        <t t-call="flexsys_platform.flexsys_layout">
            <div class="fs-platform-page fs-search-page">
                <div class="fs-shell fs-launcher">
                    <header class="fs-launcher-header">
                        <div class="fs-brand"><a href="/flexsys" class="fs-brand-mark">FS</a><div><h1>Search</h1><p>Universal Search</p></div></div>
                        <div class="fs-user-context"><span class="fs-user-pill" t-esc="platform_user.name"/><a href="/flexsys" class="fs-btn fs-btn-ghost"><span class="fa fa-th-large"/> Mission Control</a></div>
                    </header>
                    <t t-call="flexsys_platform.command_palette"/>
                    <main>
                        <section class="fs-search-hero">
                            <div><span class="fs-eyebrow"><span class="fa fa-search"/> Universal Search</span><h2>Find anything in FlexSys</h2><p><t t-esc="company.name"/><t t-if="branch"> · <t t-esc="branch.name"/></t></p></div>
                            <form action="/flexsys/search" method="get" class="fs-global-search fs-global-search-page" role="search">
                                <span class="fa fa-search" aria-hidden="true"/>
                                <input type="search" name="q" t-att-value="query" minlength="2" maxlength="100" autofocus="autofocus" placeholder="Search orders, customers and more..." aria-label="Search FlexSys"/>
                                <button type="submit" class="fs-btn fs-btn-primary">Search</button>
                            </form>
                        </section>
                        <section class="fs-search-results">
                            <div class="fs-section-head"><div><h2>Results</h2><p t-if="query"><t t-esc="len(results)"/> result(s) for “<t t-esc="query"/>”</p><p t-else="">Enter at least two characters to search.</p></div></div>
                            <div t-if="results" class="fs-search-list">
                                <a t-foreach="results" t-as="result" t-att-href="result['url']" class="fs-search-result">
                                    <span t-attf-class="fs-search-result-icon fa #{result['icon']}"/>
                                    <div class="fs-search-result-content"><div class="fs-search-result-title"><strong t-esc="result['title']"/><span class="fs-status-chip" t-esc="result['type']"/></div><p t-if="result['subtitle']" t-esc="result['subtitle']"/><small><span t-attf-class="fa #{result['application_icon']}"/> <t t-esc="result['application_name']"/></small></div>
                                    <span class="fa fa-arrow-right fs-app-arrow"/>
                                </a>
                            </div>
                            <div t-elif="query" class="fs-empty-state"><span class="fa fa-search"/><h3>No results found</h3><p>Try an order number, customer name, or mobile number.</p></div>
                            <div t-else="" class="fs-empty-state"><span class="fa fa-keyboard"/><h3>Start typing</h3><p>Universal Search respects your permissions, company, and branch context.</p></div>
                        </section>
                    </main>
                    <footer class="fs-platform-footer"><span>FlexSys Platform · 19.0.2.1.4</span><span>Universal Search v1.0</span></footer>
                </div>
            </div>
        </t>
    </template>

</odoo>
