<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="permission_platform_access" model="flexsys.platform.permission">
        <field name="name">Access Platform</field><field name="code">platform.access</field><field name="application_code">platform</field>
    </record>
    <record id="permission_operations_access" model="flexsys.platform.permission">
        <field name="name">Access Operations</field><field name="code">operations.access</field><field name="application_code">operations</field>
    </record>
    <record id="role_platform_admin" model="flexsys.platform.role">
        <field name="name">Platform Administrator</field><field name="code">platform_admin</field>
        <field name="permission_ids" eval="[(6, 0, [ref('permission_platform_access'), ref('permission_operations_access')])]"/>
    </record>
</odoo>
